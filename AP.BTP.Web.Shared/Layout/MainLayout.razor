@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using AP.BTP.Web.Shared.Components
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (isAuthenticated)
{
    <div class="page">
        <main>
            <NavBar></NavBar>
            <section class="body overflow-hidden" style="height: 91vh">
                    @Body
            </section>
        </main>
    </div>
}
else
{
    <div class="page">
        <main>
            <section class="body vh-100">
                    @Body
            </section>
        </main>
    </div>
}

@code {
    private bool isAuthenticated;

    /// <summary>
    /// Asynchronously initializes the component and retrieves the current authentication state.
    /// </summary>
    /// <remarks>
    /// This method obtains the <see cref="ClaimsPrincipal"/> representing the currently authenticated user
    /// from the <see cref="AuthenticationStateProvider"/> and sets the <c>user</c> and <c>isAuthenticated</c>
    /// fields accordingly.
    /// </remarks>
    /// <returns>A <see cref="Task"/> that represents the asynchronous operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
    }
}