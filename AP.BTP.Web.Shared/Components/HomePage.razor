@attribute [Authorize(Roles = "Admin")]
@page "/admin/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="d-flex justify-content-center mt-5" style="font-size: 5vw">Welkom! 🌱</div>
<div class="d-flex justify-content-center" style="font-size: 2vw">Wat zou je vandaag willen doen?</div>

<div class="d-flex justify-content-between" style="margin-top: 10vh">
    @if(DashboardCards != null){
        @foreach (DashboardCard card in DashboardCards)
        {
            <Card Class="border shadow" Style="border-radius: 24px; padding: 4vh; width: 30%;">
                <CardBody Class="p-0">
                    <CardTitle Class="fw-bold">@card.Title</CardTitle>
                    <div class="d-flex align-items-center" style="height: 17.5vh">
                        <CardText Class="text-muted">@card.Description</CardText>
                    </div>
                    <Button Class="green-btn container-fluid" @onclick="() => NavigateToCard(card.Url)">Ga naar</Button>
                </CardBody>
            </Card>
        }
    }
</div>

@code {
    private ClaimsPrincipal? user;

    /// <summary>
    /// Represents the list of dashboard cards displayed on the admin dashboard.
    /// Each card contains a title, description, and a URL to navigate to.
    /// </summary>
    private List<DashboardCard>? DashboardCards;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User;

        if(user.IsInRole("Admin")) {
            DashboardCards = new List<DashboardCard>
            {
                new DashboardCard
                {
                    Title = "Gebruikers beheren",
                    Description = "Gebruikersaccounts goedkeuren of afkeuren, gebruikersactiviteiten bekijken en machtigingen beheren.",
                    Url = "/admin/users"
                },
                new DashboardCard
                {
                    Title = "Kweeksites beheren",
                    Description = "Plantages toevoegen, bijwerken, verwijderen of zoeken. Houd de informatie over de locaties up-to-date.",
                    Url = "/admin/plantation-site"
                },
                new DashboardCard
                {
                    Title = "Bomen beheren",
                    Description = "Bomen toevoegen, bijwerken, verwijderen of zoeken. De gezondheid van bomen monitoren en de groei op al uw locaties volgen.",
                    Url = "/admin/tree"
                }
            };
        } else if (user.IsInRole("Manager")) {
            DashboardCards = new List<DashboardCard>
            {
                new DashboardCard
                {
                    Title = "Planning beheren",
                    Description = "Bekijk alle medewerkers en beheer hun planning.",
                    Url = "/manager/planning"
                },
                new DashboardCard
                {
                    Title = "Bomen bekijken",
                    Description = "Bekijk bomen en hun details zoals onderhoudsplannen, foto's en beschrijving",
                    Url = "/manager/tree"
                },
            };
        }
    }


    /// <summary>
    /// Represents a card displayed on the dashboard with a title, description, and navigation URL.
    /// </summary>
    private sealed class DashboardCard
    {
        /// <summary>
        /// Gets or sets the title of the dashboard card.
        /// </summary>
        public string Title { get; set; } = string.Empty;

        /// <summary>
        /// Gets or sets the description of the dashboard card.
        /// </summary>
        public string Description { get; set; } = string.Empty;

        /// <summary>
        /// Gets or sets the URL to navigate to when the card is selected.
        /// </summary>
        public string Url { get; set; } = string.Empty;
    }

    private void NavigateToCard(string url){
        Navigation.NavigateTo(url);
    }
}