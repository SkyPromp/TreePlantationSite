@page "/welcome"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Welkom</PageTitle>

<div class="container text-center mt-5">
    <div class="card shadow-lg p-4 mx-auto" style="max-width: 400px;">
        <h2 class="mb-3">Welkom bij BTP</h2>
        <p class="text-muted">Log in of maak een nieuw account aan om door te gaan.</p>

        <div class="d-grid gap-2 mt-4">
            <a class="btn btn-primary btn-lg" href="/login">Inloggen</a>
            <a class="btn btn-outline-secondary btn-lg" href="/register">Registreer</a>
        </div>
    </div>
</div>