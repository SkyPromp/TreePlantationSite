@page "/login"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using AP.BTP.Web.Shared.Authentication
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json;
@using Microsoft.Extensions.Caching.Memory
@using Microsoft.Extensions.Options
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IMemoryCache Cache
@inject IOptions<AppInfo> AppInfoOptions

<PageTitle>Login</PageTitle>


<div class="container d-flex align-items-center justify-content-center h-100">
    <Card Class="shadow-lg p-4">
        <CardTitle Class="text-center fw-bold fs-2">Inloggen</CardTitle>
        <CardBody>
            <p class="text-muted text-center mb-4">Vul je gegevens in om in te loggen.</p>

            <EditForm Model="loginDetails" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="form-group mb-3">
                    <label class="form-label" for="email">E-mail</label>
                    <InputText id="email" type="email" class="form-control" @bind-Value="loginDetails.Email" />
                    <ValidationMessage For="@(() => loginDetails.Email)" class="text-danger" />
                </div>

                <div class="form-group mb-4">
                    <label class="form-label" for="password">Wachtwoord</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="loginDetails.Password" />
                    <ValidationMessage For="@(() => loginDetails.Password)" class="text-danger" />
                </div>

                <div class="d-flex justify-content-between">
                    <Button Color="ButtonColor.Secondary" @onclick="Cancel">Ga terug</Button>
                    <Button Class="green-btn" Type="ButtonType.Submit">Inloggen</Button>
                </div>
            </EditForm>
        </CardBody>
    </Card>
</div>

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    /// <summary>
    /// Holds the data entered by the user for login.
    /// </summary>
    private LoginUserDTO loginDetails;

    /// <summary>
    /// The HTTP client used to communicate with the auth.
    /// </summary>
    private HttpClient? client;

    /// <summary>
    /// Stores any error messages encountered during operations.
    /// </summary>
    string errorMessage = "";

    /// <summary>
    /// Initializes the HTTP client.
    /// </summary>
    protected override void OnInitialized()
    {
        loginDetails = new LoginUserDTO();
        client = HttpClientFactory.CreateClient("BTPApi");

        string? appType = AppInfoOptions.Value.AppType;
        if (appType == "Maintenance")
            loginDetails.IsForMaintenance = true;
        else
            loginDetails.IsForMaintenance = false;
    }

    /// <summary>
    /// Handles form submission when all fields are valid.
    /// Sends the login request to the backend and saves the response tokens in the cache to be used in the /auth/login-callback endpoint.
    /// if an error occurs, it sets the appropriate error message.
    /// </summary>
    private async Task HandleValidSubmit()
    {
        try
        {
            if (this.client == null)
            {
                this.errorMessage = "Geen http client gevonden";
                return;
            }

            HttpResponseMessage? response = await client.PostAsJsonAsync("user/auth/login", loginDetails);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Er is een fout opgetreden tijdens het inloggen.";

                ErrorResponseInfoDTO? errorResponseInfo = await response.Content.ReadFromJsonAsync<ErrorResponseInfoDTO>();

                if (errorResponseInfo == null)
                    return;

                errorMessage = errorResponseInfo.ErrorCode switch
                {
                    "INVALID_CREDENTIALS" => "Geen toegang. Ongeldige e-mail of wachtwoord.",
                    "NOT_APPROVED" => "Geen toegang. Je bent nog niet goedgekeurd",
                    "USER_REJECTED" => "Geen toegang. Je registratie werd afgewezen",
                    "USER_DELETED" => "Geen toegang. Je account werd verwijderd",
                    "UNAUTHORIZED_ACCESS_MAINTENANCE" => "Als een operator heb je geen toegang tot dit platform",
                    "UNAUTHORIZED_ACCESS_USER" => "Enkel operators hebben toegang tot dit platform",
                    _ => errorMessage
                };

                return;
            }

            LoginResponseDTO? token = await response.Content.ReadFromJsonAsync<LoginResponseDTO>();

            string tempKey = Guid.NewGuid().ToString();
            Cache.Set(tempKey, token, TimeSpan.FromMinutes(5));

            Navigation.NavigateTo($"/auth/login-callback?key={tempKey}", forceLoad: true);
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    /// <summary>
    /// Navigates the user back to the welcome page.
    /// </summary>
    private void Cancel()
    {
        Navigation.NavigateTo("/welcome");
    }
}