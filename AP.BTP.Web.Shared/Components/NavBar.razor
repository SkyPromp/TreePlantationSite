@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer

<nav class="navbar navbar-expand px-2">
    @if(user != null && user.IsInRole("Admin")) {
        <a class="navbar-brand" href="/admin/dashboard">
            <img src="logo.png" alt="Logo" class="brand-logo">
        </a>
    } else if(user != null && user.IsInRole("Manager")) {
        <a class="navbar-brand" href="/manager/planning">
            <img src="logo.png" alt="Logo" class="brand-logo">
        </a>
    } else if(user != null && user.IsInRole("Operator")) {
        <a class="navbar-brand" href="/tasks">
            <img src="logo.png" alt="Logo" class="brand-logo">
        </a>
    }

    <div class="navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
        @if(user != null && user.IsInRole("Admin")){
            <li class="nav-item">
                <a class="nav-link" href="/admin/users">Gebruikers</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/plantation-site">Kweeksites</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/tree">Bomen</a>
            </li>
        } else if(user != null && user.IsInRole("Manager")){
            <li class="nav-item">
                <a class="nav-link" href="/manager/planning">Planning</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/manager/tree">Bomen</a>
            </li>
        } else if(user != null && user.IsInRole("Operator")){
            <li class="nav-item">
                <a class="nav-link" href="/tasks">Taken</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/plant-identification">Identificeren</a>
            </li>            
        }
            <li class="nav-item d-flex align-items-center">
                <a href="/logout"><Button Class="red-btn"><Icon Name="IconName.DoorOpen"></Icon></Button></a>
            </li>
        </ul>
    </div>
</nav>

@code {
    private ClaimsPrincipal? user;
    
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User;
    }
}