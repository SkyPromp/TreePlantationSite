@page "/view-file/{fileName}"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

@if (fileData != null)
{
    <div class="d-flex flex-column h-70">
        <div class="p-3 d-flex justify-content-end align-items-center">
            <button class="btn btn-secondary" onclick="window.close()">
                Sluiten
            </button>
        </div>


        @if (FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            <iframe src="@fileData" 
                    style="width: 100%; height: 100%; border: none;">
            </iframe>
        }
        else
        {
            <img src="@fileData" 
                    alt="@FileName"
                    style="max-width: 100%; max-height: 100%; object-fit: contain;" />
        }
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger m-4" role="alert">
        <h4 class="alert-heading">Fout bij laden bestand</h4>
        <p>@errorMessage</p>
        <hr>
        <button class="btn btn-secondary" onclick="window.close()">
            Sluiten
        </button>
    </div>
}
else
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laden...</span>
            </div>
            <p class="mt-3">Bestand laden...</p>
        </div>
    </div>
}

@code {
    /// <summary>
    /// The file name parameter from the URL route.
    /// </summary>
    [Parameter] 
    public string FileName { get; set; } = "";

    /// <summary>
    /// The file data as a base64 data URI.
    /// </summary>
    private string? fileData;

    /// <summary>
    /// Error message to display if file loading fails.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// Loads the file from the API when the component initializes.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BTPApi");
            var response = await client.GetAsync($"File/{FileName}");
            
            if (response.IsSuccessStatusCode)
            {
                byte[] bytes = await response.Content.ReadAsByteArrayAsync();
                string type = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";
                fileData = $"data:{type};base64,{Convert.ToBase64String(bytes)}";
            }
            else
            {
                errorMessage = $"Bestand niet gevonden (Status: {response.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fout bij laden bestand: {ex.Message}";
        }
    }
}