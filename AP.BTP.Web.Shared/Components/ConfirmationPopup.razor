@if (this.showConfirmationPopup)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index:10;">
        <Card Class="position-absolute align-self-center p-4" Style="max-width: 25vw">
            <CardTitle Class="text-center fw-bold">@confirmationTitle</CardTitle>
            <CardBody Class="text-center">
                <p>@confirmationDescription</p>
            </CardBody>
            <CardFooter Class="border-0 bg-white d-flex justify-content-around p-0">
                @if (this.isLoading)
                {
                    <div class="spinner-border align-self-center" role="status">
                        <span class="visually-hidden">Laden...</span>
                    </div>
                } else
                {
                    <Button Color="ButtonColor.Dark" @onclick="OnCancellation">Annuleren</Button>
                    <Button Color="ButtonColor.Success" @onclick="this.OnConfirmation">Bevestigen</Button>
                }
            </CardFooter>
        </Card>
    </div>
}

@code {
    [Parameter] public string? confirmationTitle { get; set; }
    [Parameter] public string? confirmationDescription { get; set; }
    [Parameter] public bool showConfirmationPopup { get; set; }
    [Parameter] public Func<Task>? onConfirmation { get; set; }
    [Parameter] public Func<Task>? onCancellation { get; set; }

    private bool isLoading;

    /// <summary>
    /// Lifecycle method called when the component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        this.isLoading = false;

        if (this.confirmationDescription == null) this.confirmationDescription = "Wenst u om te bevestigen?";
        if (this.confirmationTitle == null) this.confirmationTitle = "Bevestigen";
    }

    private async Task OnConfirmation()
    {
        this.isLoading = true;
        StateHasChanged();
        if (this.onConfirmation != null) await this.onConfirmation();
        this.isLoading = false;

        this.showConfirmationPopup = false;
        StateHasChanged();
    }

    private async Task OnCancellation()
    {
        this.isLoading = true;
        StateHasChanged();
        if (this.onCancellation != null) await this.onCancellation();
        this.isLoading = false;

        this.showConfirmationPopup = false;
        StateHasChanged();
    }
}
