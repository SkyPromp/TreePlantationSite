@page "/access-denied"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Toegang geweigerd</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header text-dark text-center">
                    <h4 class="mb-0">Toegang geweigerd</h4>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-triangle-fill display-1 text-warning"></i>
                    </div>
                    <p class="lead">@Message</p>
                    <Button Class="red-btn mt-3" @onclick="() => NavigateToWelcome()">
                        <i class="bi bi-arrow-left-circle"></i> Terug naar login
                    </Button> 
                </div>
            </div>
        </div>
    </div>
</div>

<Toasts Class="m-3" Messages="toastMessages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" ShowCloseButton="false"/>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "description")]
    public string? Message { get; set; }

    /// <summary>
    /// Holds the list of toast messages to display in the UI.
    /// </summary>
    private readonly List<ToastMessage> toastMessages = new List<ToastMessage>();

    /// <summary>
    /// Initializes the component and ensures that the <see cref="Message"/> property has a default value.
    /// </summary>
    /// <remarks>
    /// If <see cref="Message"/> is <c>null</c>, empty, or consists only of white-space characters,
    /// it is set to the default message: "Je hebt geen toegang tot deze applicatie."
    /// This method is called synchronously when the component is initialized.
    /// </remarks>
    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Message)) Message = "Je hebt geen toegang tot deze applicatie.";
        this.EnqueueToast(message: "Je hebt geen toegang tot deze applicatie.", type: ToastType.Warning);
    }

    /// Adds a toast message to the toast container.
    /// </summary>
    /// <param name="message">The message to display.</param>
    /// <param name="type">The message type to display.</param>
    private void EnqueueToast(string message, ToastType type)
    {
        this.toastMessages.Add(new ToastMessage
        {
            Type = type,
            Title = type.ToString(),
            Message = message,
            AutoHide = true
        });
    }

    private void NavigateToWelcome(){
        Navigation.NavigateTo("/welcome");
    }
}
