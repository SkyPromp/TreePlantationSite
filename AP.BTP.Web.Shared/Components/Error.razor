@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Http

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Er is een fout opgetreden tijdens het verwerken van uw verzoek.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Verzoek-ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>Ontwikkelingsmodus</h3>
<p>
    Als u overschakelt naar de <strong>ontwikkelomgeving</strong>, wordt er meer gedetailleerde informatie weergegeven over de fout die is opgetreden.
</p>
<p>
    <strong>De ontwikkelomgeving mag niet worden ingeschakeld voor geïmplementeerde applicaties.</strong>
    Dit kan ertoe leiden dat gevoelige informatie uit uitzonderingen wordt weergegeven aan eindgebruikers.
    Voor lokale foutopsporing schakelt u de <strong>ontwikkelomgeving</strong> in door de omgevingsvariabele <strong>ASPNETCORE_ENVIRONMENT</strong> in te stellen op <strong>Development</strong>
    en de app opnieuw te starten.
</p>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    /// <summary>
    /// Initializes the component and sets the <see cref="RequestId"/> property.
    /// </summary>
    /// <remarks>
    /// The <see cref="RequestId"/> is set to the current activity ID if available;
    /// otherwise, it falls back to the HTTP context's trace identifier.
    /// This is typically used for tracking requests in logs or error pages.
    /// </remarks>
    protected override void OnInitialized() => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
