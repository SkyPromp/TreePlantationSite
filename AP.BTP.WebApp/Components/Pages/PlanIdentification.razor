@attribute [Authorize(Roles = "Operator")]
@page "/plant-identification"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using AP.BTP.Contracts.DTOs.PlantNet
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using System.Net.Http.Headers
@using System.Net
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

<div class="row justify-content-center">
    <div class="col-lg-8">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible">
                @errorMessage
                <Button Class="btn-close" @onclick="() => errorMessage = string.Empty"></Button>
            </div>
        }

        <Card>
            <CardBody>
            @if (string.IsNullOrEmpty(previewImageUrl))
                {
                    <div class="text-center p-5 border border-2 border-dashed rounded">
                        <Icon Name="IconName.CloudUpload" Class="fs-1 text-muted mb-3" />
                        <p class="text-muted mb-3">Upload een foto van de plant</p>
                        <InputFile OnChange="HandlePictureUpload" accept="image/*" class="d-none" id="fileInput" />
                        <label for="fileInput" class="btn btn-dark">
                            <Icon Name="IconName.Camera" Class="me-2" />
                            Selecteer
                        </label>
                    </div>
                }
                else
                {
                    <div class="position-relative">
                        <img src="@previewImageUrl" alt="Preview" class="img-fluid rounded mb-3" style="max-height: 50vh; width: 100%; object-fit: cover;" />
                        <Button Class="position-absolute end-0 m-2" Color="ButtonColor.Danger" @onclick="ClearImage">
                            <Icon Name="IconName.X" />
                        </Button>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden"></span>
                            </div>
                            <p class="mt-2 text-muted">Plant aan het identificeren...</p>
                        </div>
                    }
                    else if (plantResults != null && plantResults.Any())
                    {
                        <h5 class="mb-3">Resultaten:</h5>
                        @foreach (PlantResultDTO result in plantResults.Take(5))
                        {
                            <Card class="mb-2">
                                <CardBody>
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@result.ScientificName</h6>
                                            @if (!string.IsNullOrEmpty(result.CommonName))
                                            {
                                                <p class="text-muted mb-1 small">@result.CommonName</p>
                                            }
                                            <p class="mb-0 small">Familie: @result.Family</p>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-success">@result.Score.ToString("P1")</span>
                                        </div>
                                    </div>
                                </CardBody>
                            </Card>
                        }
                    }

                    @if (!isLoading && string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="d-flex mt-3">
                            <Button Class="flex-fill" Color="ButtonColor.Dark" @onclick="IdentifyPlant" disabled="@(selectedFile == null)">
                                <Icon Name="IconName.Search" Class="me-2" />
                                Identificeer Plant
                            </Button>
                        </div>
                    }
                }
            </CardBody>
        </Card>
    </div>
</div>

@code {
    /// <summary>
    /// Error message to display to the user when validation or API calls fail.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// Base64 encoded data URL of the uploaded image for preview display.
    /// </summary>    
    private string previewImageUrl = "";
    
    /// <summary>
    /// Indicates whether a plant identification API call is currently in progress.
    /// </summary>    
    private bool isLoading = false;

    /// <summary>
    /// The browser file object representing the uploaded image file.
    /// </summary>    
    private IBrowserFile? selectedFile;

    /// <summary>
    /// List of plant identification results returned from the Pl@ntNet API.
    /// </summary>    
    private List<PlantResultDTO>? plantResults;

    /// <summary>
    /// Byte array containing the uploaded image data, used for both preview and API calls.
    /// </summary>    
    private byte[]? fileBytes;

    /// <summary>
    /// API key for authenticating with the Pl@ntNet API.
    /// Loaded from the PLANT_API configuration setting.
    /// </summary>    
    public required string plantApiKey;

    /// <summary>
    /// Initializes the component and loads the Pl@ntNet API key from configuration.
    /// Throws an exception if the API key is not configured.
    /// </summary>
    protected override void OnInitialized(){
        plantApiKey = Configuration["PLANT_API"] 
                ?? throw new Exception("PLANT_API is missing");
    }

    /// <summary>
    /// Handles image file upload and preview generation.
    /// Validates file size (max 10MB) and file type (images only).
    /// Reads the file into memory and generates a base64 preview.
    /// </summary>
    /// <param name="e">File change event containing the uploaded file</param>
    private async Task HandlePictureUpload(InputFileChangeEventArgs e) {
        errorMessage = string.Empty;
        plantResults = null;
        selectedFile = e.File;
        fileBytes = null;
        
        if (selectedFile != null)
        {
            if (selectedFile.Size > 10 * 1024 * 1024)
            {
                errorMessage = "Bestand is te groot. Maximum grootte is 10MB.";
                return;
            }
            
            if (!selectedFile.ContentType.StartsWith("image/"))
            {
                errorMessage = "Alleen afbeeldingen zijn toegestaan.";
                return;
            }
            
            try
            {
                using MemoryStream ms = new MemoryStream();
                await selectedFile.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);

                fileBytes = ms.ToArray(); 
                
                previewImageUrl = $"data:{selectedFile.ContentType};base64,{Convert.ToBase64String(fileBytes)}";
            }
            catch (Exception ex)
            {
                errorMessage = $"Fout bij het laden van de afbeelding.";
            }
        }
    }

    /// <summary>
    /// Calls the Pl@ntNet API to identify the uploaded plant image.
    /// Sends the image as multipart/form-data with the "leaf" organ parameter.
    /// Parses the response and displays the top matches.
    /// </summary>
    private async Task IdentifyPlant(){
        if (selectedFile == null || fileBytes == null) return;
        
        isLoading = true;
        errorMessage = string.Empty;
        plantResults = null;
        
        try
        {
            using HttpClient httpClient = new HttpClient();
            using MultipartFormDataContent? content = new MultipartFormDataContent();
            
            ByteArrayContent fileContent = new ByteArrayContent(fileBytes);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(fileContent, "images", selectedFile.Name);
            
            content.Add(new StringContent("leaf"), "organs"); //TODO check if these are the only ones needed
            
            string apiUrl = $"https://my-api.plantnet.org/v2/identify/all?api-key={plantApiKey}";
            HttpResponseMessage response = await httpClient.PostAsync(apiUrl, content);
            
            if (response.IsSuccessStatusCode)
            {
                string jsonResponse = await response.Content.ReadAsStringAsync();
                PlantNetResponseDTO? apiResult = JsonSerializer.Deserialize<PlantNetResponseDTO>(jsonResponse, new JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true 
                });
                
                if (apiResult?.Results != null && apiResult.Results.Any())
                {
                    plantResults = apiResult.Results.Select(r => new PlantResultDTO() {
                        ScientificName = r.Species?.ScientificNameWithoutAuthor ?? "Unknown",
                        CommonName = r.Species?.CommonNames?.FirstOrDefault() ?? "",
                        Family = r.Species?.Family?.ScientificNameWithoutAuthor ?? "Unknown",
                        Score = r.Score
                    }).ToList();
                }
                else
                {
                    plantResults = new List<PlantResultDTO>();
                }
            }
            else
            {
                if(response.StatusCode == HttpStatusCode.NotFound) {

                } else {

                }

                errorMessage = response.StatusCode == HttpStatusCode.NotFound ? "Geen overeenkomende plant gevonden." : "Onverwacht probleem bij het identificeren van de afbeelding.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Onverwacht probleem bij het identificeren van de afbeelding.";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Clears the uploaded image and resets all component state.
    /// </summary>
    private void ClearImage(){
        previewImageUrl = string.Empty;
        selectedFile = null;
        plantResults = null;
        errorMessage = string.Empty;
    }
}