@attribute [Authorize(Roles = "Operator")]
@page "/tasks"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<div class="d-flex mx-4 justify-content-between align-items-center gap-2">
    <Button Class="p-0 shadow-none" Size="ButtonSize.Large" @onclick="() => UpdateDate(-1)"><Icon Name="IconName.ArrowLeft"></Icon></Button>
    <h3 class="text-center">Takenlijst @($"{this.selectedDate:yyyy-MM-dd}")</h3>
    <Button Class="p-0 shadow-none" Size="ButtonSize.Large" @onclick="() => UpdateDate(1)"><Icon Name="IconName.ArrowRight"></Icon></Button>
</div>

<div class="text-center my-3">
    <Button Class="green-btn shadow" @onclick="ShowGroundPlan"> 
        <Icon Name="IconName.Map"></Icon> Zie plattegrond
    </Button>
</div>

<Card Class="border-0 shadow border" Style="height: 60vh">
    @if(todayTasks != null){
        <CardBody Class="p-3 d-flex flex-column gap-3 h-100">
            @foreach (TaskItemDTO task in todayTasks.TaskItems ?? [])
            {
                <Card Class="py-2 h-25 shadow border">
                    <div class="container">
                        <div class="row">
                            <div class="col-7" @onclick="() => {showTaskDetails = true; selectedTask = task;}">
                                <p class="text-truncate-multiline-2 fw-bold mb-1" title="@task.Title">@task.Title</p>
                            @* TODO: new card for details  *@
                            </div>
                            <div class="d-flex flex-column align-items-center justify-content-center col-5">
                                @if(todayTasks.Date.Date < DateTime.Today && task.EndTime - task.StartTime == null) {
                                    <Button Color="ButtonColor.Dark" Disabled="true">Vervallen</Button>
                                } else if (todayTasks.Date.Date > DateTime.Today){
                                    <Button Class="green-btn" Disabled>Start</Button>
                                }
                                else if (task.StartTime == null)
                                {
                                    <Button Class="green-btn" @onclick="() => ConfirmStartTask(task)">Start</Button>
                                }
                                else if (task.EndTime == null)
                                {
                                    <Button Class="red-btn" @onclick="() => ConfirmEndTask(task)">Stop</Button>
                                    <p class="mt-2" style="font-size: 3vw">@($"Start: {task.StartTime:HH:mm}")</p>
                                }
                                else
                                {
                                    <Button Color="ButtonColor.Secondary" Disabled>Beëindigd</Button>
                                    <small>@($"Duur: {(task.EndTime - task.StartTime):hh\\:mm}")</small>
                                }
                            </div>
                        </div>
                    </div>
                </Card>
            }
        </CardBody>
    } else {
        <CardBody Class="d-flex align-items-center justify-content-center text-center p-3">
            <p class="text-muted mb-0">
                Je hebt vandaag geen taken.<br />
                Geniet van je dag!
            </p>
        </CardBody>
    }
</Card>

<Toasts Class="m-3" Messages="toastMessages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" ShowCloseButton="false" />

<ConfirmationPopup showConfirmationPopup="this.showStartConfirmation"
                   onCancellation="this.CancelStartTask"
                   onConfirmation="this.StartTask"
                   confirmationDescription="Bent u zeker dat u deze taak wilt starten?" />

<ConfirmationPopup showConfirmationPopup="this.showEndConfirmation"
                   onCancellation="this.CancelEndTask"
                   onConfirmation="this.EndTask"
                   confirmationDescription="Bent u zeker dat u deze taak wilt stoppen?" />

@if (this.showGroundPlan)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
         style="background: rgba(0,0,0,0.5); z-index: 10">

        <Card Class="shadow-lg p-4" Style="width:90%">
            @if (currentSite != null)
            {
                <CardTitle Class="text-center fw-bold mb-4">@currentSite.Name</CardTitle>

                <CardBody Class="mb-4 p-3 border rounded bg-light">
                    <div>
                        <b>Adres:</b>
                        @currentSite.Street @currentSite.HouseNumber,
                        @currentSite.PostalCode @currentSite.City
                    </div>
                </CardBody>
            } else {
                <CardTitle Class="text-center fw-bold mb-4">Onbekend</CardTitle>

                
                <CardBody Class="mb-4 p-3 border rounded bg-light">
                    <div>Er werd geen site gevonden</div>
                </CardBody>
            }

            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(groundPlanPreview))
                {
                    <img src="@groundPlanPreview"
                         class="img-fluid rounded shadow-sm"
                         style="max-height: 60vh; object-fit: contain;" />
                } else
                {
                    <p>Geen plattegrond gevonden.</p>
                }
            </div>

            <div class="text-center mt-2">
                <Button Class="px-4 red-btn" @onclick="() => showGroundPlan = false">Sluiten</Button>
            </div>
        </Card>
    </div>
}

@if(showTaskDetails){
        <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" style="background: rgba(0,0,0,0.5); z-index: 10"> 
            <Card Class="shadow-lg p-4" Style="width:90%">
                @if(selectedTask != null) {
                    <CardTitle Class="text-center fw-bold mb-4">@selectedTask.Title</CardTitle>

                    <CardBody Class="mb-4 p-3 border rounded bg-light">
                        @selectedTask.Description
                    </CardBody>
                } else {
                    <p>Geen informatie gevonden over deze taak.</p>
                }
                <div class="text-center mt-2">
                    <Button Class="px-4 red-btn" @onclick="() => {showTaskDetails = false; selectedTask = null; }">Sluiten</Button>
                </div>
            </Card>
        </div>
}

@code {
        /// <summary>
        /// Holds the list of toast messages to display in the UI.
        /// </summary>
    private readonly List<ToastMessage> toastMessages = new List<ToastMessage>();

    /// <summary>
    /// HttpClient used to call the backend API.
    /// </summary>
    private HttpClient? client;

    private DateTime selectedDate; // TODO fix initialisation issues

    private TaskListDTO? todayTasks;

    private bool showStartConfirmation;

    private bool showEndConfirmation;

    private TaskItemDTO? selectedTask;

    private bool showGroundPlan = false;

    private bool showTaskDetails = false;

    private string groundPlanPreview = string.Empty;

    private PlantationSiteDTO? currentSite;

    /// <summary>
    /// Lifecycle method called after the component has rendered. Initializes the HttpClient, loads the user,
    /// and sets up the current week and its task lists on the first render.
    /// </summary>
    /// <param name="firstRender">True if this is the first render of the component.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        this.client = HttpClientFactory.CreateClient("BTPApi");
        this.selectedDate = DateTime.Now.Date;

        await this.LoadUser();
    }

    /// <summary>
    /// Loads the user details from the API based on the <see cref="userId"/>.
    /// </summary>
    private async Task LoadUser()
    {
        TaskListDTO? response = await this.client.GetFromJsonAsync<TaskListDTO>($"tasklist/day?date={this.selectedDate:yyyy-MM-dd}");
        this.todayTasks = response;

        if (response == null)
        {
            this.EnqueueToast(message: "Er is iets misgegaan tijdens het ophalen van de takenlijst.", type: ToastType.Warning);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Updates the selected date (<see cref="selectedDate"/>) of which to show the tasklist.
    /// </summary>
    private async Task UpdateDate(int deltaDays)
    {
        this.selectedDate = this.selectedDate.AddDays(deltaDays);
        await LoadUser();
        StateHasChanged();
    }

    private void ConfirmStartTask(TaskItemDTO task)
    {
        this.selectedTask = task;
        this.showStartConfirmation = true;
    }

    private Task CancelStartTask()
    {
        this.selectedTask = null;
        this.showStartConfirmation = false;

        return Task.CompletedTask;
    }

    private async Task StartTask()
    {
        if (this.selectedTask == null)
        {
            this.EnqueueToast(message: "De geselecteerde taak kon niet gevonden worden!", type: ToastType.Warning);
            this.showStartConfirmation = false;
            StateHasChanged();

            return;
        }

        try
        {
            HttpResponseMessage response = await client.PatchAsJsonAsync<TaskItemDTO>("TaskItem/started", this.selectedTask);
            if (!response.IsSuccessStatusCode)
            {
                ErrorResponseInfoDTO? errorResponseInfo = await response.Content.ReadFromJsonAsync<ErrorResponseInfoDTO>();

                if (errorResponseInfo == null) return;

                string errorMessage = errorResponseInfo.ErrorCode switch
                {
                    "TASK_ALREADY_STARTED" => "Deze taak is al gestart.",
                    "TASK_MULTIPLE_ACTIVE_NOT_ALLOWED" => "Er kan niet meer dan één taak tegelijk gestart zijn in deze takenlijst.",
                    "TASK_START_INVALID_DATE" => "Taken kunnen alleen gestart worden op de huidige datum.",
                    "TASK_INVALID_STATE" => "De taak bevindt zich in een ongeldige toestand.",
                    _ => errorResponseInfo.Message ?? "Er is een onverwachte fout opgetreden."
                };

                this.EnqueueToast(message: errorMessage, type: ToastType.Warning);
                this.showStartConfirmation = false;

                return;
            }

            this.EnqueueToast(message: "De taak is succesvol gestart geweest.", type: ToastType.Success);
            this.selectedTask.StartTime = (await response.Content.ReadFromJsonAsync<TaskItemDTO>())?.StartTime;
        } catch (Exception e)
        {
            this.EnqueueToast(message: $"Er is een fout opgetreden: {e.Message}", type: ToastType.Warning);
            this.showStartConfirmation = false;
        }

        this.selectedTask = null;
        this.showStartConfirmation = false;
        StateHasChanged();
    }

    private void ConfirmEndTask(TaskItemDTO task)
    {
        this.selectedTask = task;
        this.showEndConfirmation = true;
    }

    private Task CancelEndTask()
    {
        this.selectedTask = null;
        this.showEndConfirmation = false;

        return Task.CompletedTask;
    }

    private async Task EndTask()
    {
        if (this.selectedTask == null)
        {
            this.EnqueueToast(message: "De geselecteerde taak kon niet gevonden worden!", type: ToastType.Warning);
            this.showEndConfirmation = false;
            StateHasChanged();

            return;
        }

        try
        {
            HttpResponseMessage response = await client.PatchAsJsonAsync<TaskItemDTO>("TaskItem/ended", this.selectedTask);

            if (!response.IsSuccessStatusCode)
            {
                ErrorResponseInfoDTO? errorResponseInfo = await response.Content.ReadFromJsonAsync<ErrorResponseInfoDTO>();

                if (errorResponseInfo != null)
                {
                    string errorMessage = errorResponseInfo.ErrorCode switch
                    {
                        "TASK_NOT_STARTED" => "Deze taak is nog niet gestart.",
                        "TASK_ALREADY_ENDED" => "Deze taak is al beëindigd.",
                        "TASK_INVALID_TIME" => "De starttijd van de taak ligt in de toekomst.",
                        "TASK_END_INVALID_DATE" => "Taken kunnen alleen gestopt worden op de huidige datum.",
                        _ => errorResponseInfo.Message ?? "Er is een onverwachte fout opgetreden."
                    };

                    this.EnqueueToast(message: errorMessage, type: ToastType.Warning);
                } else
                {
                    this.EnqueueToast(message: "Er is een onverwachte fout opgetreden.", type: ToastType.Warning);
                }

                this.showEndConfirmation = false;

                return;
            }

            this.EnqueueToast(message: "De taak is succesvol beëindigd.", type: ToastType.Success);
            this.selectedTask.EndTime = (await response.Content.ReadFromJsonAsync<TaskItemDTO>())?.EndTime;
        } catch (ArgumentNullException e)
        {
            this.EnqueueToast(message: $"Er is een fout opgetreden bij het beëindigen van de taak: {e.Message}", type: ToastType.Warning);
        }

        this.selectedTask = null;
        this.showEndConfirmation = false;
        StateHasChanged();
    }

    private async Task ShowGroundPlan()
    {
        if (todayTasks == null)
        {
            this.EnqueueToast(message: "Geen locatie beschikbaar op deze datum", type: ToastType.Warning);

            return;
        }

        currentSite = await client.GetFromJsonAsync<PlantationSiteDTO>($"PlantationSite/{todayTasks.PlantationSiteId}");

        if (currentSite == null)
        {
            this.EnqueueToast(message: "Kweeksite niet gevonden", type: ToastType.Warning);

            return;
        }

        if (string.IsNullOrWhiteSpace(currentSite.GroundPlan))
        {
            this.EnqueueToast(message: "Geen plategrond beschikbaar.", type: ToastType.Warning);
            groundPlanPreview = "";
        } else
        {
            await LoadImagePreview(client, currentSite.GroundPlan);
        }

        showGroundPlan = true;
        StateHasChanged();
    }


    private async Task LoadImagePreview(HttpClient client, string fileName)
    {
        try
        {
            HttpResponseMessage response = (await client.GetAsync($"File/{fileName}")).EnsureSuccessStatusCode();
            byte[] imageBytes = await response.Content.ReadAsByteArrayAsync();
            string contentType = response.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
            groundPlanPreview = $"data:{contentType};base64,{Convert.ToBase64String(imageBytes)}";
        } catch (InvalidOperationException e)
        {
            this.EnqueueToast(message: $"Er is iets misgegaan bij het inladen van de kweeksites: {e}", type: ToastType.Warning);
            groundPlanPreview = string.Empty;
        } catch (HttpRequestException e)
        {
            this.EnqueueToast(message: $"Er is iets misgegaan bij het inladen van de kweeksites: {e}", type: ToastType.Warning);
            groundPlanPreview = string.Empty;
        } catch (TaskCanceledException e)
        {
            this.EnqueueToast(message: $"Er is iets misgegaan bij het inladen van de kweeksites: {e}", type: ToastType.Warning);
            groundPlanPreview = string.Empty;
        } catch (UriFormatException e)
        {
            this.EnqueueToast(message: $"Er is iets misgegaan bij het inladen van de kweeksites: {e}", type: ToastType.Warning);
            groundPlanPreview = string.Empty;
        } catch (ArgumentNullException e)
        {
            this.EnqueueToast(message: $"Er is iets misgegaan bij het inladen van de kweeksites: {e}", type: ToastType.Warning);
            groundPlanPreview = string.Empty;
        }
    }

    /// Adds a toast message to the toast container.
    /// </summary>
    /// <param name="message">The message to display.</param>
    /// <param name="type">The message type to display.</param>
    private void EnqueueToast(string message, ToastType type)
    {
        this.toastMessages.Add(new ToastMessage
        {
            Type = type,
            Title = type.ToString(),
            Message = message,
            AutoHide = true
        });
    }
}

