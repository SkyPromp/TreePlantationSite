@attribute [Authorize(Roles = "Operator")]
@page "/planning"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<div class="d-flex mx-4 justify-content-between align-items-center gap-0">
    <h3 class="p-0" @onclick="() => UpdateDate(-1)">←</h3>
    <h3 class="text-center">Tasks of @($"{this.selectedDate:yyyy-MM-dd}")</h3>
    <h3 class="p-0" @onclick="() => UpdateDate(1)">→</h3>
</div>

<div class="card border-0">
    <div class="p-3 d-flex flex-column gap-2">
        @foreach(TaskItemDTO task in todayTasks?.TaskItems ?? [])
        {
            <div class="card py-2">
                <div class="container">
                    <div class="row">
                        <div class="col-6">
                            <b>@task.Title</b>
                            <p class="text-truncate">@task.Description</p>
                        </div>
                        <div class="d-flex flex-column align-items-center justify-content-center col-6">
                            <button @onclick="() => ConfirmStartTask(task)" class="btn btn-secondary">Start</button>
                            @if(task.StartTime == null)
                            {
                                <small>Time spent doing task</small>
                            }
                            else if(task.EndTime == null)
                            {
                                <small>@($"{task.StartTime:HH:mm:ss}")</small>
                            } 
                            else
                            {
                                <small>@($"{(task.EndTime - task.StartTime):HH:mm:ss}")</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (this.showStartConfirmation)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Bent u zeker dat u deze <br /> taak wilt starten?</h5>
                <div class="row gap-3">
                    <div class="col">
                        <button @onclick="CancelStartTask" class="btn btn-warning">Annuleer</button>
                    </div>
                    <div class="col">
                        <button @onclick="StartTask" class="btn btn-danger">Bevestig</button>
                    </div>
                </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    /// <summary>
    /// The ID of the user whose details and tasks are being displayed.
    /// This is passed as a parameter to the component.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// HttpClient used to call the backend API.
    /// </summary>
    private HttpClient? client;

    private DateTime selectedDate;

    private TaskListDTO? todayTasks;

    private bool showStartConfirmation;

    private TaskItemDTO? selectedTask;

    /// <summary>
    /// Lifecycle method called after the component has rendered. Initializes the HttpClient, loads the user,
    /// and sets up the current week and its task lists on the first render.
    /// </summary>
    /// <param name="firstRender">True if this is the first render of the component.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        this.client = HttpClientFactory.CreateClient("BTPApi");
        this.selectedDate = DateTime.Now.Date;

        await this.LoadUser();
    }

    /// <summary>
    /// Loads the user details from the API based on the <see cref="userId"/>.
    /// </summary>
    private async Task LoadUser()
    {
        if (this.client == null)
        {
            this.errorMessage = "Client is null";
            StateHasChanged();

            return;
        }

        try
        {
            TaskListDTO? response = await this.client.GetFromJsonAsync<TaskListDTO>($"tasklist/day?date={this.selectedDate:yyyy-MM-dd}");
            this.todayTasks = response;

            if (response == null)
            {
                this.errorMessage = "Er is iets misgegaan tijdens het ophalen van de takenlijst.";
            } else
            {
                this.errorMessage = "";
            }
        } catch (Exception e)
        {
            this.errorMessage = e.Message;
            this.todayTasks = null;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Updates the selected date (<see cref="selectedDate"/>) of which to show the tasklist.
    /// </summary>
    private async Task UpdateDate(int deltaDays)
    {
        this.selectedDate = this.selectedDate.AddDays(deltaDays);
        await LoadUser();
        StateHasChanged();
    }

    private void ConfirmStartTask(TaskItemDTO task)
    {
        this.selectedTask = task;
        this.showStartConfirmation = true;
    }

    private void CancelStartTask()
    {
        this.selectedTask = null;
        this.showStartConfirmation = false;
    }

    private async Task StartTask()
    {
        if(this.client == null)
        {
            this.errorMessage = "The client could not be found!";
            StateHasChanged();

            return;
        }

        if(this.selectedTask == null)
        {
            this.errorMessage = "The selected could not be found!";
            StateHasChanged();

            return;
        }

        try
        {
            HttpResponseMessage response = await client.PatchAsJsonAsync<TaskItemDTO>("TaskItem/started", this.selectedTask);
            
            if (response.IsSuccessStatusCode)
            {
                this.errorMessage = "";
                this.selectedTask.StartTime = (await response.Content.ReadFromJsonAsync<TaskItemDTO>())?.StartTime;
            } else
                this.errorMessage = await response.Content.ReadAsStringAsync();
        } catch (Exception e)
        {
            this.errorMessage = e.Message;
        }

        this.selectedTask = null;
        this.showStartConfirmation = false;
        StateHasChanged();
    }
    
    private async Task EndTask()
    {
        if(this.client == null)
        {
            this.errorMessage = "The client could not be found!";
            StateHasChanged();

            return;
        }

        if(this.selectedTask == null)
        {
            this.errorMessage = "The selected could not be found!";
            StateHasChanged();

            return;
        }

        try
        {
            HttpResponseMessage response = await client.PatchAsJsonAsync<TaskItemDTO>("TaskItem/ended", this.selectedTask);
            
            if (response.IsSuccessStatusCode)
            {
                this.errorMessage = "";
                this.selectedTask.EndTime = (await response.Content.ReadFromJsonAsync<TaskItemDTO>())?.EndTime;
            } else
                this.errorMessage = await response.Content.ReadAsStringAsync();
        } catch (Exception e)
        {
            this.errorMessage = e.Message;
        }

        this.selectedTask = null;
        this.showStartConfirmation = false;
        StateHasChanged();
    }
}

