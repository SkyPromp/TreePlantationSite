    /// <summary>
    /// Checks whether a picture is currently marked as favourite.
    /// </summary>
    /// <param name="key">The picture key, usually its ID as string.</param>
    /// <returns><c>true</c> if the picture is favourite; otherwise <c>false</c>.</returns>
    private bool IsPictureFavourite(string key)
    {
        return int.TryParse(key, out int id) && favourites.ContainsKey(id) && favourites[id];
    }

    /// <summary>
    /// Toggles the favourite status of a picture.
    /// Automatically unsets other favourites if a new one is being set.
    /// </summary>
    /// <param name="key">The picture key, usually its ID as string.</param>
    private async Task ToggleFavourite(string key)
    {
        if (!int.TryParse(key, out int picId))
        {
            this.EnqueueToast("De foto kon niet geselecteerd worden.", ToastType.Warning);

            return;
        }

        bool newValue = !IsPictureFavourite(key);

        if (newValue)
        {
            foreach (int otherId in favourites.Keys.ToList())
            {
                if (otherId != picId && favourites[otherId])
                {
                    favourites[otherId] = false;
                    HttpResponseMessage responseMessage = await client!.PatchAsJsonAsync($"TreePicture/{otherId}/favourite", false);

                    if (!responseMessage.IsSuccessStatusCode)
                    {
                        this.EnqueueToast($"Deze foto kon niet als favoriet toegevoegd worden: {await responseMessage.Content.ReadAsStringAsync()}", ToastType.Warning);
                        StateHasChanged();

                        return;
                    }
                }
            }
        }

        HttpResponseMessage response = await client!.PatchAsJsonAsync($"TreePicture/{picId}/favourite", newValue);

        if (!response.IsSuccessStatusCode)
        {
            this.EnqueueToast($"Deze foto kon niet als favoriet toegevoegd worden: {await response.Content.ReadAsStringAsync()}", ToastType.Warning);
            StateHasChanged();

            return;
        }

        favourites[picId] = newValue;
        this.EnqueueToast("Deze foto is als favoriet toegevoegd geweest.", ToastType.Success);
        StateHasChanged();
    }

    /// <summary>
    /// Determines if the picture key represents a temporary (unsaved) image.
    /// </summary>
    /// <param name="key">The picture key.</param>
    /// <returns><c>true</c> if the image is temporary; otherwise <c>false</c>.</returns>
    private static bool IsTemporary(string key)
    {
        return !int.TryParse(key, out _);
    }

    /// <summary>
    /// Handles star icon click. Shows a warning if the image is not yet saved.
    /// </summary>
    /// <param name="key">The picture key.</param>
    private async Task OnStarClicked(string key)
    {
        if (IsTemporary(key))
        {
            this.EnqueueToast("U moet de afbeeldingen opslaan voordat u een favoriet selecteert.", ToastType.Warning);

            return;
        }

        await ToggleFavourite(key);
    }

    /// Adds a toast message to the toast container.
    /// </summary>
    /// <param name="message">The message to display.</param>
    /// <param name="type">The message type to display.</param>
    private void EnqueueToast(string message, ToastType type)
    {
        this.toastMessages.Add(new ToastMessage
        {
            Type = type,
            Title = type.ToString(),
            Message = message,
            AutoHide = true
        });
    }
}