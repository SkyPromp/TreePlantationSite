@attribute [Authorize(Roles = "Admin")]
@page "/admin/tree/edit/{Id:int?}"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json

<Tabs EnableFadeEffect="true" Style="margin-top: 3vh">
    <Tab Title="Algemene informatie">
        <Content>
            <EditForm Model="Tree" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="form-content">
                    <div class="row">
                        <div class="col-4 pe-3">
                            <div>
                                <label class="form-label">Boomsoorten</label>
                                <TextInput @bind-Value="@Tree.Species"></TextInput>
                                <ValidationMessage For="@(() => Tree.Species)" />
                            </div>
                            <div>
                                <label class="form-label">Foto selectie</label>
                                <InputFile OnChange="e => HandleFileUpload(e, FileType.Picture, null)" multiple class="form-control mb-2"/>
                            </div>                            
                        </div>
                            <div class="col-8">
                                <label class="form-label">Overzicht</label>
                                <div class="border rounded p-2" style="height: 80%; overflow-y: auto;">
                                    @if (previews.Count == 0)
                                    {
                                        <p class="text-muted">Nog geen afbeeldingen geselecteerd.</p>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap">
                                            @foreach (KeyValuePair<string, string> kvp in previews)
                                            {
                                                <div class="position-relative p-1" style="flex: 0 0 50%; height: 200px;">
                                                    <Button Class="p-0 position-absolute" Style="box-shadow: none; border: none; top: 5px; right: 5px; height: 5vh; z-index: 10;" @onclick="() => { this.showDeleteConfirmation = true; selectedImage = kvp.Key; }">
                                                        <Icon Name="IconName.Trash" Color="IconColor.Danger" Style="font-size: 4vh;"></Icon>
                                                    </Button>
                                                    <img src="@kvp.Value" class="img-fluid rounded" style="width: 100%; height: 100%; object-fit: contain;" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <a class="d-flex align-items-center justify-content-center btn" style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" href="/admin/tree">Annuleer</a>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Submit">Bewaar</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
    <Tab Title="Onderhoudsplannen">
        <Content>
            <EditForm Model="Tree" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="form-content">
                    <div class="row row-cols-2 d-flex align-items-center justify-content-center">
                        <div class="col border p-3 d-flex flex-column align-items-center rounded">
                            <div class="input-container d-flex flex-column w-100">
                                <label class="form-label">Lente</label>
                                <InputFile class="form-control" OnChange="e => HandleFileUpload(e, FileType.Maintenance, Season.Spring)" />
                            </div>
                            <div class="preview text-center mt-2">
                                @if(!string.IsNullOrWhiteSpace(Tree.MaintenancePlanSpring) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanSpring)){
                                    string fileKey = Tree.MaintenancePlanSpring;
                                    string? previewData = maintenancePreviews[fileKey];
                                    string filename = maintenanceFileNames[fileKey];

                                    if (filename.Contains(".pdf"))
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <a href="@previewData" target="_blank" rel="noopener noreferrer"><Button Color="ButtonColor.Dark">Preview PDF</Button></a>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@previewData" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" />
                                    }
                                } else {
                                    <p>No preview yet.</p>
                                }
                            </div>
                        </div>

                        <div class="col border p-3 d-flex flex-column align-items-center rounded">
                            <div class="input-container d-flex flex-column w-100">
                                <label class="form-label">Zomer</label>
                                <InputFile class="form-control" OnChange="e => HandleFileUpload(e, FileType.Maintenance, Season.Summer)" />
                            </div>
                            <div class="preview text-center mt-2">
                                @if(!string.IsNullOrWhiteSpace(Tree.MaintenancePlanSummer) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanSummer)){
                                    string fileKey = Tree.MaintenancePlanSummer;
                                    string? previewData = maintenancePreviews[fileKey];
                                    string filename = maintenanceFileNames[fileKey];

                                    if (filename.Contains(".pdf"))
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <a href="@previewData" target="_blank" rel="noopener noreferrer"><Button Color="ButtonColor.Dark">Preview PDF</Button></a>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@previewData" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" />
                                    }
                                } else {
                                    <p>No preview yet.</p>
                                }
                            </div>
                        </div>

                        <div class="col border p-3 d-flex flex-column align-items-center rounded">
                            <div class="input-container d-flex flex-column w-100">
                                <label class="form-label">Herfst</label>
                                <InputFile class="form-control" OnChange="e => HandleFileUpload(e, FileType.Maintenance, Season.Autumn)" />
                            </div>
                            <div class="preview text-center mt-2">
                                @if(!string.IsNullOrWhiteSpace(Tree.MaintenancePlanAutumn) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanAutumn)){
                                    string fileKey = Tree.MaintenancePlanAutumn;
                                    string? previewData = maintenancePreviews[fileKey];
                                    string filename = maintenanceFileNames[fileKey];

                                    if (filename.Contains(".pdf"))
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <a href="@previewData" target="_blank" rel="noopener noreferrer"><Button Color="ButtonColor.Dark">Preview PDF</Button></a>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@previewData" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" />
                                    }
                                } else {
                                    <p>No preview yet.</p>
                                }
                            </div>
                        </div>

                        <div class="col border p-3 d-flex flex-column align-items-center rounded">
                            <div class="input-container d-flex flex-column w-100">
                                <label class="form-label">Winter</label>
                                <InputFile class="form-control" OnChange="e => HandleFileUpload(e, FileType.Maintenance, Season.Winter)" />
                            </div>
                            <div class="preview text-center mt-2">
                                @if(!string.IsNullOrWhiteSpace(Tree.MaintenancePlanWinter) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanWinter)){
                                    string fileKey = Tree.MaintenancePlanWinter!;
                                    string? previewData = maintenancePreviews[fileKey];
                                    string filename = maintenanceFileNames[fileKey];

                                    if (filename.Contains(".pdf"))
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <a href="@previewData" target="_blank" rel="noopener noreferrer"><Button Color="ButtonColor.Dark">Preview PDF</Button></a>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@previewData" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" />
                                    }
                                } else {
                                    <p>No preview yet.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <a class="d-flex align-items-center justify-content-center btn" style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" href="/admin/tree">Annuleer</a>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Submit">Bewaar</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
</Tabs>

@if (this.showDeleteConfirmation)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Bent u zeker dat u deze <br /> afbeelding wilt verwijderen?</h5>
            <div class="row gap-3">
                <div class="col">
                    <button @onclick="CancelDeletePicture" class="btn btn-warning">Annuleer</button>
                </div>
                <div class="col">
                    <button @onclick="DeletePicture" class="btn btn-danger">Bevestig</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// The optional ID of the tree to edit.
    /// If no ID is provided, the component assumes creation mode.
    /// </summary>
    [Parameter] public int? Id { get; set; }

    /// <summary>
    /// Stores any error messages encountered during operations.
    /// Used to display feedback to the user.
    /// </summary>
    string errorMessage = "";

    /// <summary>
    /// The HTTP client used to communicate with the backend API.
    /// </summary>
    HttpClient? client;

    public enum FileType
    {
        Picture,
        Maintenance
    }

    public enum Season{
        Spring,
        Summer,
        Autumn,
        Winter
    }


    /// <summary>
    /// Stores newly selected images that have not yet been uploaded.
    /// Key is a temporary GUID, value is a tuple of the file and its byte content.
    /// </summary>
    private Dictionary<string, (IBrowserFile file, byte[] data)> newPictures = new();

    /// <summary>
    /// Stores existing images for the tree.
    /// Key is the picture ID, value is the filename/path.
    /// </summary>
    private Dictionary<int, string> existingPictures = new();

    /// <summary>
    /// Stores image previews to display in the UI.
    /// Key is either the temporary GUID (for new images) or ID (for existing images), value is a base64 data URI.
    /// </summary>
    private Dictionary<string, string> previews = new();

    private Dictionary<string, (IBrowserFile file, byte[] data)> newMaintenanceFiles = new();
    private Dictionary<int, string> existingMaintenanceFiles = new();
    private Dictionary<string, string> maintenancePreviews = new();
    private Dictionary<string, string> maintenanceFileNames = new();

    /// <summary>
    /// Holds the currently selected image for deletion.
    /// </summary>
    private string? selectedImage = null; 

    /// <summary>
    /// Indicates whether the delete confirmation modal should be shown.
    /// </summary>
    private bool showDeleteConfirmation = false;

    /// <summary>
    /// Represents the current tree being created or edited.
    /// </summary>
    private TreeDTO Tree = new TreeDTO()
    {
        Id = 0,
        Species = ""
    };

    /// <summary>
    /// Called by the Blazor framework when the component is initialized.
    /// Initializes the <see cref="HttpClient"/> and loads tree data if an ID is provided.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        client = HttpClientFactory.CreateClient("BTPApi");

        if (Id.HasValue){
            await LoadTree(Id.Value);
            await LoadExistingPictures(Id.Value);
        }
    }

    /// <summary>
    /// Loads a tree record from the backend API by its ID.
    /// Updates the <see cref="Tree"/> property with the retrieved data.
    /// </summary>
    /// <param name="id">The ID of the tree to load.</param>
    private async Task LoadTree(int id)
    {
        if (this.client == null)
        {
            this.errorMessage = "No httpclient found.";

            return;
        }

        TreeDTO? response = await this.client.GetFromJsonAsync<TreeDTO>($"Tree/{id}");

        if (response != null)
            this.Tree = response;
        else
            this.errorMessage = "Couldn't load tree";

        StateHasChanged();
    }

    /// <summary>
    /// Handles the form submission to create or update a tree record.
    /// Performs input validation, sends the appropriate API request,
    /// and uploads pictures.
    /// </summary>
    private async Task Submit()
    {
        try
        {
            if (this.client == null)
            {
                this.errorMessage = "No httpclient found.";

                return;
            }

            if (string.IsNullOrEmpty(this.Tree.Species))
            {
                this.errorMessage = "The tree name is empty";

                return;
            }

            HttpResponseMessage response;

            if (this.Id == null)
            {
                response = await this.client.PostAsJsonAsync<TreeDTO>("Tree", this.Tree);
            } else
            {
                response = await this.client.PutAsJsonAsync<TreeDTO>("Tree", this.Tree);
            }

            if (!response.IsSuccessStatusCode)
            {
                this.errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            TreeDTO? savedTree = await response.Content.ReadFromJsonAsync<TreeDTO>();
            if (savedTree == null || savedTree.Id == 0)
            {
                this.errorMessage = "Failed to get saved tree id.";
                return;
            }

            this.Tree = savedTree;
            this.Id = this.Tree.Id;

            List<KeyValuePair<string, (IBrowserFile file, byte[] data)>> picturesToUpload = newPictures.ToList();  
            newPictures.Clear();   

            foreach (KeyValuePair<string, (IBrowserFile file, byte[] data)> kvp in picturesToUpload)
            {
                string tempKey = kvp.Key;
                (IBrowserFile file, byte[] data) = kvp.Value;

                using MultipartFormDataContent content = new MultipartFormDataContent();
                content.Add(new ByteArrayContent(data), "file", file.Name);

                string? fileName = null;
                HttpResponseMessage fileResponse = await client.PostAsync("File/upload", content);
                if (fileResponse.IsSuccessStatusCode)
                {
                    JsonElement json = await fileResponse.Content.ReadFromJsonAsync<JsonElement>();
                    if (json.TryGetProperty("fileName", out JsonElement p)) fileName = p.GetString();
                }

                if (string.IsNullOrEmpty(fileName))
                {
                    this.errorMessage = $"Failed to upload file {file.Name}";
                    continue;
                }

                TreePictureDTO treePicture = new TreePictureDTO
                {
                    TreeId = this.Tree.Id,
                    Path = fileName,
                    IsFavourite = false
                };

                HttpResponseMessage addResponse = await client.PostAsJsonAsync("TreePicture", treePicture);
                if (!addResponse.IsSuccessStatusCode)
                {
                    this.errorMessage = await addResponse.Content.ReadAsStringAsync();
                    continue;
                }

                TreePictureDTO? created = await addResponse.Content.ReadFromJsonAsync<TreePictureDTO>();
                if (created != null)
                {
                    existingPictures[created.Id] = created.Path;

                    previews.Remove(tempKey);
                    await GeneratePreview(created.Id.ToString(), created.Path, FileType.Picture);
                }
            }
            
            List<KeyValuePair<string, (IBrowserFile file, byte[] data)>> maintenanceToUpload = newMaintenanceFiles.ToList();
            newMaintenanceFiles.Clear();

            foreach (KeyValuePair<string, (IBrowserFile file, byte[] data)> kvp in maintenanceToUpload)
            {
                string key = kvp.Key;
                (IBrowserFile file, byte[] data) = kvp.Value;

                using MultipartFormDataContent content = new MultipartFormDataContent();
                content.Add(new ByteArrayContent(data), "file", file.Name);

                string? fileName = null;
                HttpResponseMessage fileResponse = await client.PostAsync("File/upload", content);
                if (fileResponse.IsSuccessStatusCode)
                {
                    JsonElement json = await fileResponse.Content.ReadFromJsonAsync<JsonElement>();
                    if (json.TryGetProperty("fileName", out JsonElement p)) fileName = p.GetString();
                }

                if (string.IsNullOrEmpty(fileName))
                {
                    errorMessage = $"Failed to upload maintenance file {file.Name}";
                    continue;
                }

                await GeneratePreview(key, fileName, FileType.Maintenance);
            }
            
            this.errorMessage = "";

        } catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }


    /// <summary>
    /// Handles uploading one or more images for the tree.
    /// Validates file type and size before storing them in <see cref="newPictures"/> and generating previews.
    /// </summary>
    /// <param name="e">The <see cref="InputFileChangeEventArgs"/> containing selected files.</param>
    private async Task HandleFileUpload(InputFileChangeEventArgs e, FileType type, Season? season)
    {
        foreach (IBrowserFile file in e.GetMultipleFiles())
        {
            if (type == FileType.Picture && !ImageFileTypes.Contains(file.ContentType))
            {
                errorMessage = $"File type '{file.ContentType}' is not permitted!";
                continue;
            }

            if (type == FileType.Maintenance && !AllowedMaintenanceFileTypes.Contains(file.ContentType))
            {
                errorMessage = $"File type '{file.ContentType}' is not permitted for maintenance plans!";
                continue;
            }

            if (file.Size > 10_000_000)
            {
                errorMessage = $"File '{file.Name}' exceeds the 10MB file size limit!";
                continue;
            }

            string key = Guid.NewGuid().ToString();
            using MemoryStream ms = new MemoryStream();
            await file.OpenReadStream(10_000_000).CopyToAsync(ms);

            if (type == FileType.Picture)
            {
                Console.WriteLine("Uploading picture");
                newPictures[key] = (file, ms.ToArray());
                previews[key] = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            }
            else if (type == FileType.Maintenance)
            {
                Console.WriteLine("Uploading plan");
                newMaintenanceFiles[key] = (file, ms.ToArray());
                maintenancePreviews[key] = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
                maintenanceFileNames[key] = file.Name;

                switch (season)
                {
                    case Season.Spring: Tree.MaintenancePlanSpring = key; break;
                    case Season.Summer: Tree.MaintenancePlanSummer = key; break;
                    case Season.Autumn: Tree.MaintenancePlanAutumn = key; break;
                    case Season.Winter: Tree.MaintenancePlanWinter = key; break;
                }
            }
        }

        StateHasChanged();
    }

    /// <summary>
    /// Generates a base64 preview for the image specified by <paramref name="fileName"/>.
    /// Updates <see cref="previews"/> with the resulting data URI.
    /// </summary>
    /// <param name="key">The key to associate with the preview.</param>
    /// <param name="fileName">The server file name of the image.</param>
    private async Task GeneratePreview(string key, string fileName, FileType fileType)
    {
        HttpResponseMessage response = await client!.GetAsync($"File/{fileName}");

        if(!response.IsSuccessStatusCode) return;

        byte[] bytes = await response.Content.ReadAsByteArrayAsync();
        string type = response.Content.Headers.ContentType?.MediaType!;    

        if(fileType == FileType.Picture){
            Console.WriteLine("Generating picture preview");
            previews[key] = $"data:{type};base64,{Convert.ToBase64String(bytes)}";
        }
        else if(fileType == FileType.Maintenance){
            Console.WriteLine("Generating maintenance preview");
            maintenancePreviews[key] = $"data:{type};base64,{Convert.ToBase64String(bytes)}";
            maintenanceFileNames[key] = fileName;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Loads all existing pictures for the given tree from the API.
    /// Updates <see cref="existingPictures"/> and <see cref="previews"/>.
    /// </summary>
    /// <param name="treeId">The ID of the tree whose pictures to load.</param>
    private async Task LoadExistingPictures(int treeId)
    {
        List<TreePictureDTO>? response = await client!.GetFromJsonAsync<List<TreePictureDTO>>($"TreePicture/{treeId}");
        if (response != null)
        {
            existingPictures.Clear();
            previews.Clear();
            foreach (TreePictureDTO pic in response)
            {
                Console.WriteLine("Setting picture path");        
                existingPictures[pic.Id] = pic.Path;
                await GeneratePreview(pic.Id.ToString(), pic.Path, FileType.Picture);
            }
        }
    }

    /// <summary>
    /// Cancels the delete picture operation.
    /// Hides the confirmation modal and clears the selected image.
    /// </summary>
    private void CancelDeletePicture()
    {
        this.showDeleteConfirmation = false;
        this.selectedImage = null;
    }

    /// <summary>
    /// Deletes the currently selected picture.
    /// Removes it from <see cref="existingPictures"/> or <see cref="newPictures"/> and updates <see cref="previews"/>.
    /// </summary>
    private async Task DeletePicture()
    {
        if (selectedImage == null)
        {
            showDeleteConfirmation = false;
            return;
        }

        if (int.TryParse(selectedImage, out int picId))
        {
            HttpResponseMessage res = await client!.DeleteAsync($"TreePicture/{picId}");
            if (res.IsSuccessStatusCode)
            {
                existingPictures.Remove(picId);
                previews.Remove(selectedImage);
            }
            else
            {
                errorMessage = await res.Content.ReadAsStringAsync();
            }
        }
        else
        {
            newPictures.Remove(selectedImage);
            previews.Remove(selectedImage);
        }

        selectedImage = null;
        showDeleteConfirmation = false;
        StateHasChanged();
    }

    /// <summary>
    /// The allowed filetypes of the plantation site's groundplan. This is a readonly component parameter.
    /// </summary>
    readonly string[] ImageFileTypes = {
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/bmp"
    };
    
    readonly string[] AllowedMaintenanceFileTypes = {
        "application/pdf",
        "image/jpeg",
        "image/png",
        "image/webp"
    };
}
