@attribute [Authorize(Roles = "Admin")]
@page "/admin/tree/edit/{Id:int?}"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject NavigationManager Navigation
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using System.Net.Http.Headers
@using QRCoder


<Tabs EnableFadeEffect="true" Style="margin-top: 3vh" @ref="tabs">
    <Tab Title="Algemene informatie">
        <Content>
            <EditForm Model="Tree" OnValidSubmit="ShowSecondTabAsync">
                <DataAnnotationsValidator />
                <div class="form-content overflow-hidden">
                    <div class="row">
                        <div class="col-4 pe-3">
                            <div>
                                <label class="form-label">Boomsoorten</label>
                                <TextInput @bind-Value="@Tree.Species"></TextInput>
                                <ValidationMessage For="@(() => Tree.Species)" />
                            </div>
                            <div>
                                <label class="form-label">Foto selectie</label>
                                <InputFile OnChange="e => HandleFileUpload(e, FileType.Picture, null)" multiple class="form-control mb-2" />
                            </div>
                        </div>
                        <div class="col-8">
                            <label class="form-label">Overzicht</label>
                            <div class="border rounded p-2" style="height: 100%; overflow-y: auto;">
                                @if (previews.Count == 0)
                                {
                                    <p class="text-muted">Nog geen afbeeldingen geselecteerd.</p>
                                } else
                                {
                                    <div class="d-flex flex-wrap">
                                        @foreach (KeyValuePair<string, string> kvp in previews)
                                        {
                                            <div class="position-relative p-1" style="flex: 0 0 50%; height: 200px;">
                                                <Button Class="position-absolute" Style="box-shadow: none; top: 5px; left: 5px; background: none; border: none; z-index: 10;" @onclick="() => OnStarClicked(kvp.Key)">
                                                    @if (IsPictureFavourite(kvp.Key))
                                                    {
                                                        <Icon Name="IconName.StarFill" Color="IconColor.Warning" Style="font-size: 4vh;" />
                                                    } else
                                                    {
                                                        <Icon Name="IconName.Star" Color="IconColor.Warning" Style="font-size: 4vh;" />
                                                    }
                                                </Button>
                                                <Button Class="p-0 position-absolute" Style="box-shadow: none; border: none; top: 5px; right: 5px; height: 5vh; z-index: 10;" @onclick="() => { this.showDeleteConfirmation = true; selectedImage = kvp.Key; }">
                                                    <Icon Name="IconName.Trash" Color="IconColor.Danger" Style="font-size: 4vh;"></Icon>
                                                </Button>
                                                <img src="@kvp.Value" class="img-fluid rounded" style="width: 100%; height: 100%; object-fit: contain;" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <a class="d-flex align-items-center justify-content-center btn" style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" href="/admin/tree">Verlaten</a>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Submit">Volgende</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
    <Tab Title="Onderhoudsplannen">
        <Content>
            <EditForm Model="Tree" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="form-content d-flex align-items-center justify-content-center">
                    <div class="row row-cols-2 g-3 d-flex w-100 d-flex justify-content-around">
                        <div class="col-5 border p-3 d-flex flex-column align-items-center rounded">
                            <div class="input-container d-flex flex-column w-100">
                                <label class="form-label">Lente</label>
                                <div class="d-flex align-items-center gap-2">
                                    <InputFile class="form-control mb-0" OnChange="e => HandleFileUpload(e, FileType.Maintenance, Season.Spring)" />

                                    @if (!string.IsNullOrWhiteSpace(Tree.MaintenancePlanSpring) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanSpring))
                                    {
                                        <Button Class="p-0" Style="box-shadow: none; border: none;  height: 5vh;" @onclick="() => { this.ConfirmDeleteMaintenancePlan = () => { this.Tree.MaintenancePlanSpring = null; this.showDeleteConfirmationMaintenancePlan = false; }; this.showDeleteConfirmationMaintenancePlan = true; }"><Icon Name="IconName.Trash" Color="IconColor.Danger" Style="font-size: 3vh;" Class="d-flex"></Icon></Button>
                                    }
                                </div>
                            </div>
                            <div class="preview text-center w-100 h-100 d-flex align-items-center justify-content-around mt-2">
                                @if (!string.IsNullOrWhiteSpace(Tree.MaintenancePlanSpring) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanSpring))
                                {
                                    string fileKey = Tree.MaintenancePlanSpring;
                                    string? previewData = maintenancePreviews[fileKey];
                                    string filename = maintenanceFileNames[fileKey];

                                    if (filename.Contains(".pdf"))
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <a href="@previewData" target="_blank" rel="noopener noreferrer"><Button Color="ButtonColor.Dark">PDF bekijken</Button></a>
                                        </div>
                                    } else
                                    {
                                        <img src="@previewData" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" />
                                    }
                                    @if (qrCodes.ContainsKey(fileKey))
                                    {
                                        <img src="@qrCodes[fileKey]" alt="QR Code" style="width: 100px; height: 100px;" />
                                    }
                                } else
                                {
                                    <p>Nog geen preview beschikbaar.</p>
                                }
                            </div>
                        </div>

                        <div class="col-5 border p-3 d-flex flex-column align-items-center rounded">
                            <div class="input-container d-flex flex-column w-100">
                                <label class="form-label">Zomer</label>
                                <div class="d-flex align-items-center gap-2">
                                    <InputFile class="form-control mb-0" OnChange="e => HandleFileUpload(e, FileType.Maintenance, Season.Summer)" />

                                    @if (!string.IsNullOrWhiteSpace(Tree.MaintenancePlanSummer) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanSummer))
                                    {
                                        <Button Class="p-0" Style="box-shadow: none; border: none;  height: 5vh;" @onclick="() => { this.ConfirmDeleteMaintenancePlan = () => { this.Tree.MaintenancePlanSummer = null; this.showDeleteConfirmationMaintenancePlan = false; }; this.showDeleteConfirmationMaintenancePlan = true; }"><Icon Name="IconName.Trash" Color="IconColor.Danger" Style="font-size: 3vh;" Class="d-flex"></Icon></Button>
                                    }
                                </div>
                            </div>
                            <div class="preview text-center w-100 h-100 d-flex align-items-center justify-content-around mt-2">
                                @if (!string.IsNullOrWhiteSpace(Tree.MaintenancePlanSummer) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanSummer))
                                {
                                    string fileKey = Tree.MaintenancePlanSummer;
                                    string? previewData = maintenancePreviews[fileKey];
                                    string filename = maintenanceFileNames[fileKey];

                                    if (filename.Contains(".pdf"))
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <a href="@previewData" target="_blank" rel="noopener noreferrer"><Button Color="ButtonColor.Dark">PDF bekijken</Button></a>
                                        </div>
                                    } else
                                    {
                                        <img src="@previewData" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" />
                                    }
                                    @if (qrCodes.ContainsKey(fileKey))
                                    {
                                        <img src="@qrCodes[fileKey]" alt="QR Code" style="width: 100px; height: 100px;" />
                                    }
                                } else
                                {
                                    <p>Nog geen preview beschikbaar.</p>
                                }
                            </div>
                        </div>

                        <div class="col-5 border p-3 d-flex flex-column align-items-center rounded">
                            <div class="input-container d-flex flex-column w-100">
                                <label class="form-label">Herfst</label>
                                <div class="d-flex align-items-center gap-2">
                                    <InputFile class="form-control mb-0" OnChange="e => HandleFileUpload(e, FileType.Maintenance, Season.Autumn)" />

                                    @if (!string.IsNullOrWhiteSpace(Tree.MaintenancePlanAutumn) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanAutumn))
                                    {
                                        <Button Class="p-0" Style="box-shadow: none; border: none;  height: 5vh;" @onclick="() => { this.ConfirmDeleteMaintenancePlan = () => { this.Tree.MaintenancePlanAutumn = null; this.showDeleteConfirmationMaintenancePlan = false; }; this.showDeleteConfirmationMaintenancePlan = true; }"><Icon Name="IconName.Trash" Color="IconColor.Danger" Style="font-size: 3vh;" Class="d-flex"></Icon></Button>
                                    }
                                </div>
                            </div>
                            <div class="preview text-center w-100 h-100 d-flex align-items-center justify-content-around mt-2">
                                @if (!string.IsNullOrWhiteSpace(Tree.MaintenancePlanAutumn) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanAutumn))
                                {
                                    string fileKey = Tree.MaintenancePlanAutumn;
                                    string? previewData = maintenancePreviews[fileKey];
                                    string filename = maintenanceFileNames[fileKey];

                                    if (filename.Contains(".pdf"))
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <a href="@previewData" target="_blank" rel="noopener noreferrer"><Button Color="ButtonColor.Dark">PDF bekijken</Button></a>
                                        </div>
                                    } else
                                    {
                                        <img src="@previewData" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" />
                                    }
                                    @if (qrCodes.ContainsKey(fileKey))
                                    {
                                        <img src="@qrCodes[fileKey]" alt="QR Code" style="width: 100px; height: 100px;" />
                                    }
                                } else
                                {
                                    <p>Nog geen preview beschikbaar.</p>
                                }
                            </div>
                        </div>

                        <div class="col-5 border p-3 d-flex flex-column align-items-center rounded">
                            <div class="input-container d-flex flex-column w-100">
                                <label class="form-label">Winter</label>
                                <div class="d-flex align-items-center gap-2">
                                    <InputFile class="form-control mb-0" OnChange="e => HandleFileUpload(e, FileType.Maintenance, Season.Winter)" />

                                    @if (!string.IsNullOrWhiteSpace(Tree.MaintenancePlanWinter) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanWinter))
                                    {
                                        <Button Class="p-0" Style="box-shadow: none; border: none;  height: 5vh;" @onclick="() => { this.ConfirmDeleteMaintenancePlan = () => { this.Tree.MaintenancePlanWinter = null; this.showDeleteConfirmationMaintenancePlan = false; }; this.showDeleteConfirmationMaintenancePlan = true; }"><Icon Name="IconName.Trash" Color="IconColor.Danger" Style="font-size: 3vh;" Class="d-flex"></Icon></Button>
                                    }
                                </div>
                            </div>
                            <div class="preview text-center w-100 h-100 d-flex align-items-center justify-content-around mt-2">
                                @if (!string.IsNullOrWhiteSpace(Tree.MaintenancePlanWinter) && maintenancePreviews.ContainsKey(Tree.MaintenancePlanWinter))
                                {
                                    string fileKey = Tree.MaintenancePlanWinter!;
                                    string? previewData = maintenancePreviews[fileKey];
                                    string filename = maintenanceFileNames[fileKey];

                                    if (filename.Contains(".pdf"))
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <a href="@previewData" target="_blank" rel="noopener noreferrer"><Button Color="ButtonColor.Dark">PDF bekijken</Button></a>
                                        </div>
                                    } else
                                    {
                                        <img src="@previewData" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" />
                                    }
                                    @if (qrCodes.ContainsKey(fileKey))
                                    {
                                        <img src="@qrCodes[fileKey]" alt="QR Code" style="width: 100px; height: 100px;" />
                                    }
                                } else
                                {
                                    <p>Nog geen preview beschikbaar.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <a class="d-flex align-items-center justify-content-center btn" style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" @onclick="() => this.showConfirmLeaveForm = true">Verlaten</a>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Button" @onclick="() => this.showConfirmSaveForm = true">Bewaren</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
</Tabs>

<Toasts Class="m-3" Messages="toastMessages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" ShowCloseButton="false" />

<ConfirmationPopup showConfirmationPopup="this.showDeleteConfirmation"
                   onCancellation="this.CancelDeletePicture"
                   onConfirmation="this.DeletePicture"
                   confirmationDescription="Bent u zeker dat u deze afbeelding wilt verwijderen?" />

<ConfirmationPopup showConfirmationPopup="this.showDeleteConfirmationMaintenancePlan"
                   onCancellation="() => { if (this.CancelDeleteMaintenancePlan != null) this.CancelDeleteMaintenancePlan(); return Task.CompletedTask; }"
                   onConfirmation="() => { if (this.ConfirmDeleteMaintenancePlan != null) this.ConfirmDeleteMaintenancePlan(); return Task.CompletedTask; }"
                   confirmationDescription="Bent u zeker dat u dit onderhoudsplan wilt verwijderen?" />

<ConfirmationPopup showConfirmationPopup="this.showConfirmLeaveForm"
                   onConfirmation="@(() => { Navigation.NavigateTo("/admin/tree"); return Task.CompletedTask; })"
                   confirmationDescription="Bent u zeker dat u de pagina wilt verlaten? Onopgeslagen wijzigingen zullen ongedaan wordedn gemaakt." />

<ConfirmationPopup showConfirmationPopup="this.showConfirmSaveForm"
                   onConfirmation="this.Submit" />

@code {
    /// <summary>
    /// Holds the list of toast messages to display in the UI.
    /// </summary>
    private readonly List<ToastMessage> toastMessages = new List<ToastMessage>();

    /// <summary>
    /// Reference to the tab component for switching between tabs.
    /// </summary>
    private Tabs tabs = default!;

    /// <summary>
    /// The optional ID of the tree to edit.
    /// If no ID is provided, the component assumes creation mode.
    /// </summary>
    [Parameter] public int? Id { get; set; }

    /// <summary>
    /// The HTTP client used to communicate with the backend API.
    /// </summary>
    HttpClient client = default!;

    /// <summary>
    /// Specifies the type of file being uploaded.
    /// </summary>
    public enum FileType
    {
        Picture,
        Maintenance
    }

    /// <summary>
    /// Represents the seasons of the year for maintenance plans.
    /// </summary>
    public enum Season
    {
        Spring,
        Summer,
        Autumn,
        Winter
    }

    /// <summary>
    /// Stores newly selected images that have not yet been uploaded.
    /// Key is a temporary GUID, value is a tuple of the file and its byte content.
    /// </summary>
    private readonly Dictionary<string, (IBrowserFile file, byte[] data)> newPictures = new();

    /// <summary>
    /// Stores existing images for the tree.
    /// Key is the picture ID, value is the filename/path.
    /// </summary>
    private readonly Dictionary<int, string> existingPictures = new();

    /// <summary>
    /// Stores image previews to display in the UI.
    /// Key is either the temporary GUID (for new images) or ID (for existing images), value is a base64 data URI.
    /// </summary>
    private readonly Dictionary<string, string> previews = new();

    /// <summary>
    /// Tracks which tree pictures are marked as favourites.
    /// The key is the tree picture ID, and the value indicates whether it is a favourite (<c>true</c>) or not (<c>false</c>).
    /// </summary>
    private readonly Dictionary<int, bool> favourites = new();

    /// <summary>
    /// Newly selected maintenance files that have not yet been uploaded.
    /// Key is a temporary GUID, value is a tuple containing the file and its byte content.
    /// </summary>
    private readonly Dictionary<string, (IBrowserFile file, byte[] data)> newMaintenanceFiles = new();

    /// <summary>
    /// Previews for maintenance files.
    /// Key is the temporary GUID or filename, value is a base64 data URI.
    /// </summary>    
    private readonly Dictionary<string, string> maintenancePreviews = new();

    /// <summary>
    /// Stores the original filenames for uploaded maintenance files.
    /// Key is the temporary GUID or server filename, value is the original filename.
    /// </summary>    
    private readonly Dictionary<string, string> maintenanceFileNames = new();

    /// <summary>
    /// Stores QR code images as base64 data URIs.
    /// Key is the file key (same as maintenance previews), value is the QR code image data URI.
    /// </summary>
    private readonly Dictionary<string, string> qrCodes = new();

    /// <summary>
    /// Holds the currently selected image for deletion.
    /// </summary>
    private string? selectedImage = null;

    /// <summary>
    /// Indicates whether the delete confirmation modal should be shown.
    /// </summary>
    private bool showDeleteConfirmation;

    /// <summary>
    /// Indicates whether the leave form confirmation modal should be shown.
    /// </summary>
    private bool showConfirmLeaveForm;

    /// <summary>
    /// Indicates whether the save form confirmation modal should be shown.
    /// </summary>
    private bool showConfirmSaveForm;

    /// <summary>
    /// Represents the current tree being created or edited.
    /// </summary>
    private TreeDto Tree = new TreeDto()
    {
        Id = 0,
        Species = ""
    };

    /// <summary>
    /// Indicates whether the delete confirmation modal should be shown.
    /// </summary>
    private bool showDeleteConfirmationMaintenancePlan;

    /// <summary>
    /// The function that shall be run when the maintanceplan is deleted.
    /// </summary>
    private Action? ConfirmDeleteMaintenancePlan;

    /// <summary>
    /// Holds a list of all deleted tree pictures so they can be cancelled if the changes are not saved.
    /// </summary>
    private readonly List<int> deletedTreePics = new List<int>();


    /// <summary>
    /// The allowed content types for picture uploads.
    /// </summary>
    private readonly string[] ImageFileTypes = {
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/bmp"
    };

    /// <summary>
    /// The allowed content types for maintenance plan uploads.
    /// </summary>    
    private readonly string[] AllowedMaintenanceFileTypes = {
        "application/pdf",
        "image/jpeg",
        "image/png",
        "image/webp"
    };

    /// <summary>
    /// Called when the component is initialized.
    /// Loads the tree and its associated images/maintenance files if <see cref="Id"/> is set.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        client = HttpClientFactory.CreateClient("BTPApi");

        if (Id.HasValue)
        {
            await LoadTree(Id.Value);
            await LoadExistingPictures(Id.Value);
            await LoadExistingMaintenanceFiles();
        }
    }

    /// <summary>
    /// Loads a tree record from the backend API by its ID.
    /// Updates the <see cref="Tree"/> property with the retrieved data.
    /// </summary>
    /// <param name="id">The ID of the tree to load.</param>
    private async Task LoadTree(int id)
    {
        TreeDto? response = await this.client.GetFromJsonAsync<TreeDto>($"Tree/{id}");

        if (response != null) this.Tree = response;
        else
            EnqueueToast(message: "Kon boom niet laden.", ToastType.Warning);

        StateHasChanged();
    }

    /// <summary>
    /// Handles uploading of pictures and maintenance files.
    /// </summary>
    public async Task SubmitMaintenancePlans()
    {
        try
        {
            List<KeyValuePair<string, (IBrowserFile file, byte[] data)>>? maintenanceFilesToUpload = newMaintenanceFiles.ToList();
            newMaintenanceFiles.Clear();

            foreach (KeyValuePair<string, (IBrowserFile file, byte[] data)> kvp in maintenanceFilesToUpload)
            {
                string key = kvp.Key;
                (IBrowserFile file, byte[] data) = kvp.Value;

                using MultipartFormDataContent content = new MultipartFormDataContent();
                ByteArrayContent fileContent = new ByteArrayContent(data);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "file", file.Name);

                HttpResponseMessage uploadResponse = await client.PostAsync("File/upload", content);

                if (!uploadResponse.IsSuccessStatusCode)
                {
                    EnqueueToast(message: $"Het uploaden van het onderhoudsbestand {file.Name} is mislukt.", ToastType.Warning);

                    continue;
                }

                string? fileName = null;
                JsonElement json = await uploadResponse.Content.ReadFromJsonAsync<JsonElement>();

                if (json.TryGetProperty("fileName", out JsonElement p))
                    fileName = p.GetString();

                if (string.IsNullOrEmpty(fileName))
                {
                    EnqueueToast(message: $"Uploaden is gelukt, maar er is geen bestandsnaam geretourneerd voor {file.Name}", ToastType.Warning);

                    continue;
                }

                if (Tree.MaintenancePlanSpring == key)  // TODO dictionary or switch case
                    Tree.MaintenancePlanSpring = fileName;
                if (Tree.MaintenancePlanSummer == key)
                    Tree.MaintenancePlanSummer = fileName;
                if (Tree.MaintenancePlanAutumn == key)
                    Tree.MaintenancePlanAutumn = fileName;
                if (Tree.MaintenancePlanWinter == key)
                    Tree.MaintenancePlanWinter = fileName;

                maintenancePreviews.Remove(key);
                qrCodes.Remove(key);

                await GeneratePreview(fileName, fileName, FileType.Maintenance);
            }
        } catch (ArgumentNullException e)
        {
            EnqueueToast(message: $"Er ging iets mis bij het opslagen van de foto's: {e}", ToastType.Warning);
        }
    }

    /// <summary>
    /// Submits the tree creation or update request.
    /// Handles uploading of pictures and maintenance files.
    /// </summary>
    private async Task Submit()
    {
        if (string.IsNullOrEmpty(this.Tree.Species))
        {
            EnqueueToast(message: "Voeg een naam toe aan de boom voor het opslagen.", ToastType.Warning);

            return;
        }

        if (newMaintenanceFiles.Count > 0)
        {
            await SubmitMaintenancePlans();
        }

        HttpResponseMessage response;

        if (this.Id == null)
        {
            response = await this.client.PostAsJsonAsync<TreeDto>("Tree", this.Tree);
        } else
        {
            response = await this.client.PutAsJsonAsync<TreeDto>("Tree", this.Tree);
        }

        if (!response.IsSuccessStatusCode)
        {
            EnqueueToast(message: $"De boom kon niet succesvol {(this.Id == null ? "toegevoegd" : "gewijzigd")} worden: {await response.Content.ReadAsStringAsync()}", ToastType.Warning);

            return;
        } else
        {
            EnqueueToast(message: $"De boom is succesvol {(this.Id == null ? "toegevoegd" : "gewijzigd")} geweest.", ToastType.Success);
        }

        TreeDto? savedTree = await response.Content.ReadFromJsonAsync<TreeDto>();

        if (savedTree == null || savedTree.Id == 0)
        {
            EnqueueToast(message: "Kan de opgeslagen boom-id niet ophalen.", ToastType.Warning);

            return;
        }

        this.Tree = savedTree;
        this.Id = this.Tree.Id;

        try
        {
            List<KeyValuePair<string, (IBrowserFile file, byte[] data)>> picturesToUpload = newPictures.ToList();
            newPictures.Clear();

            await this.DeleteAllQueuedPictures();

            foreach (KeyValuePair<string, (IBrowserFile file, byte[] data)> kvp in picturesToUpload)
            {
                string tempKey = kvp.Key;
                (IBrowserFile file, byte[] data) = kvp.Value;

                using MultipartFormDataContent content = new MultipartFormDataContent();

                ByteArrayContent fileContent = new ByteArrayContent(data);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "file", file.Name);

                string? fileName = null;
                HttpResponseMessage fileResponse = await client.PostAsync("File/upload", content);

                if (fileResponse.IsSuccessStatusCode)
                {
                    JsonElement json = await fileResponse.Content.ReadFromJsonAsync<JsonElement>();

                    if (json.TryGetProperty("fileName", out JsonElement p))
                        fileName = p.GetString();
                }

                if (string.IsNullOrEmpty(fileName))
                {
                    EnqueueToast(message: $"Kan bestand {file.Name} niet uploaden", ToastType.Warning);

                    continue;
                }

                TreePictureDto treePicture = new TreePictureDto
                {
                    TreeId = this.Tree.Id,
                    Path = fileName,
                    IsFavourite = false
                };

                HttpResponseMessage addResponse = await client.PostAsJsonAsync("TreePicture", treePicture);
                if (!addResponse.IsSuccessStatusCode)
                {
                    EnqueueToast(message: $"Kan bestand {await addResponse.Content.ReadAsStringAsync()} niet uploaden", ToastType.Warning);

                    continue;
                }

                TreePictureDto? created = await addResponse.Content.ReadFromJsonAsync<TreePictureDto>();
                if (created != null)
                {
                    existingPictures[created.Id] = created.Path;
                    previews.Remove(tempKey);
                    await GeneratePreview(created.Id.ToString(), created.Path, FileType.Picture);
                }
            }
        } catch (ArgumentNullException e)
        {
            EnqueueToast(message: $"Er ging iets mis bij het opslagen van de foto's: {e}", ToastType.Warning);
        }
    }


    /// <summary>
    /// Handles uploading selected files for pictures or maintenance plans.
    /// Generates previews and stores files in the appropriate dictionaries.
    /// </summary>
    /// <param name="e">The file change event arguments containing selected files.</param>
    /// <param name="type">The type of file being uploaded.</param>
    /// <param name="season">Optional season for maintenance files.</param>
    private async Task HandleFileUpload(InputFileChangeEventArgs e, FileType type, Season? season)
    {
        const int maxFileSizeB = 10_000_000;

        foreach (IBrowserFile file in e.GetMultipleFiles())
        {
            if (type == FileType.Picture && !ImageFileTypes.Contains(file.ContentType))
            {
                EnqueueToast(message: $"Bestandstype '{file.ContentType}' is niet toegestaan!", ToastType.Warning);

                continue;
            }

            if (type == FileType.Maintenance && !AllowedMaintenanceFileTypes.Contains(file.ContentType))
            {
                EnqueueToast(message: $"Het bestandstype '{file.ContentType}' is niet toegestaan voor onderhoudsplannen!", ToastType.Warning);

                continue;
            }

            if (file.Size >= maxFileSizeB)
            {
                EnqueueToast(message: $"Het bestand '{file.Name}' overschrijdt de maximale bestandsgrootte van 10 MB!", ToastType.Warning);

                continue;
            }

            string key = Guid.NewGuid().ToString();
            using MemoryStream ms = new MemoryStream();
            await file.OpenReadStream(maxFileSizeB).CopyToAsync(ms);

            if (type == FileType.Picture)
            {
                newPictures[key] = (file, ms.ToArray());
                previews[key] = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            } else if (type == FileType.Maintenance)
            {
                newMaintenanceFiles[key] = (file, ms.ToArray());
                maintenancePreviews[key] = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
                maintenanceFileNames[key] = file.Name;

                switch (season)
                {
                    case Season.Spring:
                        Tree.MaintenancePlanSpring = key;
                        break;
                    case Season.Summer:
                        Tree.MaintenancePlanSummer = key;
                        break;
                    case Season.Autumn:
                        Tree.MaintenancePlanAutumn = key;
                        break;
                    case Season.Winter:
                        Tree.MaintenancePlanWinter = key;
                        break;
                }
            }
        }

        StateHasChanged();
    }

    /// <summary>
    /// Generates a QR code for the given file URL and stores it as a base64 image.
    /// </summary>
    /// <param name="key">The key to associate with the QR code.</param>
    /// <param name="fileName">The file name or URL to encode in the QR code.</param>
    private void GenerateQRCode(string key, string fileName)
    {
        string fileUrl = $"{NavigationManager.BaseUri}view-file/{fileName}";
        using QRCodeGenerator qrGenerator = new QRCodeGenerator();
        using QRCodeData qrCodeData = qrGenerator.CreateQrCode(fileUrl, QRCodeGenerator.ECCLevel.Q);
        using PngByteQRCode qrCode = new PngByteQRCode(qrCodeData);
        byte[] qrCodeBytes = qrCode.GetGraphic(20);
        try
        {
            qrCodes[key] = $"data:image/png;base64,{Convert.ToBase64String(qrCodeBytes)}";

        } catch (ArgumentNullException e)
        {
            EnqueueToast(message: $"Kon geen preview aanmaken: {e}", ToastType.Warning);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Generates a base64 preview for an uploaded file and updates the corresponding preview dictionary.
    /// </summary>
    /// <param name="key">The key to associate with the preview.</param>
    /// <param name="fileName">The server file name of the image or maintenance file.</param>
    /// <param name="fileType">The type of file being previewed.</param>
    private async Task GeneratePreview(string key, string fileName, FileType fileType)
    {
        try
        {
            HttpResponseMessage response = await client!.GetAsync($"File/{fileName}");

            if (!response.IsSuccessStatusCode)
            {
                EnqueueToast(message: "Kon geen preview genereren.", ToastType.Warning);

                return;
            }

            byte[] bytes = await response.Content.ReadAsByteArrayAsync();
            string type = response.Content.Headers.ContentType?.MediaType!;

            if (fileType == FileType.Picture)
            {
                previews[key] = $"data:{type};base64,{Convert.ToBase64String(bytes)}";
            } else if (fileType == FileType.Maintenance)
            {
                maintenancePreviews[key] = $"data:{type};base64,{Convert.ToBase64String(bytes)}";
                maintenanceFileNames[key] = fileName;

                GenerateQRCode(key, fileName);
            }
        } catch (InvalidOperationException e)
        {
            EnqueueToast(message: $"Kon geen preview genereren: {e}", ToastType.Warning);

            return;
        } catch (HttpRequestException e)
        {
            EnqueueToast(message: $"Kon geen preview genereren: {e}", ToastType.Warning);

            return;
        } catch (TaskCanceledException e)
        {
            EnqueueToast(message: $"Kon geen preview genereren: {e}", ToastType.Warning);

            return;
        } catch (UriFormatException e)
        {
            EnqueueToast(message: $"Kon geen preview genereren: {e}", ToastType.Warning);

            return;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Loads all existing pictures for the specified tree and generates previews.
    /// </summary>
    /// <param name="treeId">The tree ID.</param>
    private async Task LoadExistingPictures(int treeId)
    {
        List<TreePictureDto>? response = await client!.GetFromJsonAsync<List<TreePictureDto>>($"TreePicture/{treeId}");
        if (response != null)
        {
            existingPictures.Clear();
            previews.Clear();
            foreach (TreePictureDto pic in response)
            {
                existingPictures[pic.Id] = pic.Path;
                await GeneratePreview(pic.Id.ToString(), pic.Path, FileType.Picture);

                favourites[pic.Id] = pic.IsFavourite;
            }
        }
    }

    /// <summary>
    /// Loads existing maintenance plan files for the current tree and generates previews.
    /// </summary>
    private async Task LoadExistingMaintenanceFiles()
    {
        maintenancePreviews.Clear();
        maintenanceFileNames.Clear();
        qrCodes.Clear();

        async Task LoadOne(string? fileKey)
        {
            if (string.IsNullOrWhiteSpace(fileKey))
                return;

            await GeneratePreview(fileKey, fileKey, FileType.Maintenance);
        }

        await LoadOne(Tree.MaintenancePlanSpring);
        await LoadOne(Tree.MaintenancePlanSummer);
        await LoadOne(Tree.MaintenancePlanAutumn);
        await LoadOne(Tree.MaintenancePlanWinter);
    }

    /// <summary>
    /// Cancels the delete picture operation.
    /// Hides the confirmation modal and clears the selected image.
    /// </summary>
    private Task CancelDeletePicture()
    {
        this.showDeleteConfirmation = false;
        this.selectedImage = null;

        return Task.CompletedTask;
    }

    private async Task DeleteAllQueuedPictures()
    {
        if (!this.deletedTreePics.Any()) return;

        if (this.client == null)
        {
            EnqueueToast(message: "The client has not been initialized yet.", ToastType.Warning);

            return;
        }

        // Foreach instead of 1 large request because DeleteAsync doesn't take a body and if you want to create your own delete you need to Jsonify, which requires another package.
        foreach (int picId in this.deletedTreePics)
        {
            HttpResponseMessage res = await this.client.DeleteAsync($"TreePicture/{picId}");

            if (!res.IsSuccessStatusCode)
            {
                EnqueueToast(message: $"Kon één foto niet verwijderen: {await res.Content.ReadAsStringAsync()}", ToastType.Warning);
                StateHasChanged();
            }
        }

        StateHasChanged();
    }

    /// <summary>
    /// Deletes the currently selected picture.
    /// Removes it from <see cref="existingPictures"/> or <see cref="newPictures"/> and updates <see cref="previews"/>.
    /// </summary>
    private Task DeletePicture()
    {
        if (selectedImage == null)
        {
            showDeleteConfirmation = false;
            EnqueueToast(message: "Er was geen afbeelding geselecteerd.", ToastType.Warning);

            return Task.CompletedTask;
        }

        if (int.TryParse(selectedImage, out int picId))
        {
            this.deletedTreePics.Add(picId);
            existingPictures.Remove(picId);
            previews.Remove(selectedImage);
        } else
        {
            newPictures.Remove(selectedImage);
            previews.Remove(selectedImage);
        }

        selectedImage = null;
        showDeleteConfirmation = false;
        this.EnqueueToast("Het verwijderen van de foto wordt succesvol afgehandelt.", ToastType.Success);
        StateHasChanged();

        return Task.CompletedTask;
    }

