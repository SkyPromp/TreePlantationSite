@attribute [Authorize(Roles = "Admin")]
@page "/admin/tree/edit/{Id:int?}"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json

<Tabs EnableFadeEffect="true" Style="margin-top: 3vh">
    <Tab Title="Site details">
        <Content>
            <EditForm Model="Tree" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="form-content">
                    <div class="row">
                        <div class="col-4">
                            <div>
                                <label class="form-label">Boomsoorten</label>
                                <TextInput @bind-Value="@Tree.Species"></TextInput>
                                <ValidationMessage For="@(() => Tree.Species)" />
                            </div>
                            <div>
                                <label class="form-label">Picture upload</label>
                                <InputFile OnChange="HandlePictureUpload" class="form-control mb-2" />
                            </div>                            
                        </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <a class="d-flex align-items-center justify-content-center btn" style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" href="/admin/tree">Annuleer</a>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Submit">Bewaar</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
    <Tab Title="Maintenance">
        <Content>
            <EditForm Model="Tree" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="form-content">
                    <div class="row">
                        <div class="col-4">
                            <div>
                                <label class="form-label">Onderhoud</label>
                                <InputFile class="form-control mb-2" />
                            </div>
                        </div>
                        <div class="col-8 d-flex justify-content-center align-items-center">
                            <p class="text-muted">Nog geen onderhoudsplan toegevoegd.</p>
                        </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <a class="d-flex align-items-center justify-content-center btn" style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" href="/admin/tree">Annuleer</a>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Submit">Bewaar</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
</Tabs>

@code {
    /// <summary>
    /// The optional ID of the tree to edit. 
    /// If no ID is provided, the component assumes creation mode.
    /// </summary>
    [Parameter] public int? Id { get; set; }

    /// <summary>
    /// Stores any error messages encountered during operations.
    /// Used to display feedback to the user.
    /// </summary>
    string errorMessage = "";

    /// <summary>
    /// The HTTP client used to communicate with the backend API.
    /// </summary>
    HttpClient? client;

    private Dictionary<string, string?> uploadedPictures = new();
    private Dictionary<string, string> previews = new();

    /// <summary>
    /// Represents the current tree being created or edited.
    /// </summary>
    private TreeDTO Tree = new TreeDTO()
    {
        Id = 0,
        Species = ""
    };

    /// <summary>
    /// Called by the Blazor framework when the component is initialized.
    /// Initializes the <see cref="HttpClient"/> and loads tree data if an ID is provided.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        client = HttpClientFactory.CreateClient("BTPApi");

        if (Id.HasValue) await LoadTree(Id.Value);
    }

    /// <summary>
    /// Loads a tree record from the backend API by its ID.
    /// Updates the <see cref="Tree"/> property with the retrieved data.
    /// </summary>
    /// <param name="id">The ID of the tree to load.</param>
    private async Task LoadTree(int id)
    {
        if (this.client == null)
        {
            this.errorMessage = "No httpclient found.";

            return;
        }

        TreeDTO? response = await this.client.GetFromJsonAsync<TreeDTO>($"Tree/{id}");

        if (response != null) this.Tree = response;
        else this.errorMessage = "Couldn't load tree";

        StateHasChanged();
    }

    /// <summary>
    /// Clears the form by resetting the <see cref="Tree.Species"/> field.
    /// </summary>
    private void ClearForm()
    {
        this.Tree.Species = "";
    }

    /// <summary>
    /// Handles the form submission to create or update a tree record.
    /// Performs input validation, sends the appropriate API request,
    /// and navigates back to the tree list upon success.
    /// </summary>
    private async Task Submit()
    {
        try
        {
            if (this.client == null)
            {
                this.errorMessage = "No httpclient found.";

                return;
            }

            if (string.IsNullOrEmpty(this.Tree.Species))
            {
                this.errorMessage = "The tree name is empty";

                return;
            }

            HttpResponseMessage response;

            if (this.Id == null)
            {
                response = await this.client.PostAsJsonAsync<TreeDTO>("Tree", this.Tree);
            } else
            {
                response = await this.client.PutAsJsonAsync<TreeDTO>("Tree", this.Tree);
            }

            if (response.IsSuccessStatusCode)
            {
                this.errorMessage = "";
                this.Tree.Species = "";
                NavigationManager.NavigateTo("/admin/tree");
            } else
                this.errorMessage = this.errorMessage = await response.Content.ReadAsStringAsync();
        } catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }


    /// <summary>
    /// Handles uploading one or more images for the tree.
    /// </summary>
    private async Task HandlePictureUpload(InputFileChangeEventArgs e)
    {
        foreach (IBrowserFile file in e.GetMultipleFiles())
        {
            string tempKey = Guid.NewGuid().ToString();

            uploadedPictures[tempKey] = null;

            await UploadFile(tempKey, file);

            if (uploadedPictures[tempKey] != null)
                await GeneratePreview(tempKey, uploadedPictures[tempKey]!);
        }
    }

    /// <summary>
    /// Uploads a single file to the backend.
    /// </summary>
    private async Task UploadFile(string key, IBrowserFile file)
    {
        using MultipartFormDataContent content = new();
        using Stream stream = file.OpenReadStream(10_000_000);

        content.Add(new StreamContent(stream), "file", file.Name);

        HttpResponseMessage response = await client!.PostAsync("File/upload", content);

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = await response.Content.ReadAsStringAsync();
            return;
        }

        JsonElement json = await response.Content.ReadFromJsonAsync<JsonElement>();
        string fileName = json.GetProperty("fileName").GetString()!;

        uploadedPictures[key] = fileName;
    }

    private async Task GeneratePreview(string key, string fileName)
    {
        HttpResponseMessage response = await client!.GetAsync($"File/{fileName}");

        if(!response.IsSuccessStatusCode) return;

        byte[] bytes = await response.Content.ReadAsByteArrayAsync();
        string type = response.Content.Headers.ContentType?.MediaType!;    

        previews[key] = $"data:{type};base64,{Convert.ToBase64String(bytes)}";

        StateHasChanged();
    }

    @* private async Task LoadExistingPictures()
    {
        if (Tree.Pictures == null)
            return;

        foreach (var pic in Tree.Pictures)
        {
            string key = Guid.NewGuid().ToString();
            uploadedPictures[key] = pic.Path;

            await GeneratePreview(key, pic.Path);
        }
    } *@
}
