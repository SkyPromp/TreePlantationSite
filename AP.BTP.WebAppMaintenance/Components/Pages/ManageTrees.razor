@attribute [Authorize(Roles = "Admin")]
@page "/admin/tree"
@using AP.BTP.Application.CQRS.Tree;
@using AP.BTP.Application.CQRS;
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<div class="container">
    <div class="row mb-2">
        <div class="col-4">
            <div class="col-11 input-group">
                <input type="text" @bind="SearchStringBind" @oninput="(e) => SearchTrees(e.Value?.ToString() ?? String.Empty)" placeholder="Search" class="form-control border-0"/>
                <button @onclick="RemoveSearchString" class="form-control">X</button>
            </div>
        </div>
    </div>

    <div class="col">
        <NavLink href="/admin/tree/edit">
            <button class="btn btn-secondary">+ Toevoegen</button>
        </NavLink>
    </div>
    <div class="row row-cols-3 gap-4 mb-4">
        @foreach (TreeDTO tree in Trees ?? [])
        {
            <div class="col-3">
                <div class="card p-3">
                    <h2>@tree.Species</h2>
                    <div class="row align-items-center">
                        <div class="col-10">
                            <a href="@($"/admin/tree/edit/{tree.Id}")" class="btn btn-secondary w-100">
                                Bewerk
                            </a>
                        </div>
                        <div class="col-1">
                            <h3 @onclick="() => ConfirmDeleteTree(tree.Id)" class="bi bi-trash text-danger d-flex justify-content-center my-1"></h3>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

     <Pagination Class="justify-content-center"
                    Style="margin-top: 2vh"
                    ActivePageNumber="@Page"
                    TotalPages="@TotalPages"
                    PageChanged="LoadTrees"
                    FirstLinkIcon="IconName.ChevronDoubleLeft"
                    PreviousLinkIcon="IconName.ChevronLeft"
                    NextLinkIcon="IconName.ChevronRight"
                    LastLinkIcon="IconName.ChevronDoubleRight">
        </Pagination>
</div>

@if (this.ShowConfirm)
{
    <div class="d-flex justify-content-center">
        <div class="card position-absolute align-self-center p-4">
            <h1>Bevestig</h1>
            <p>Wenst u om te bevestigen?</p>
            <div class="row gap-3">
                <div class="col">
                    <button @onclick="() => this.IsConfirm = false" class="btn btn-warning">Annuleer</button>
                </div>
                <div class="col">
                    <button @onclick="() => this.IsConfirm = true" class="btn btn-secondary">Bevestig</button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    private string SearchStringBind = "";
    private string SearchString = "";
    private IEnumerable<TreeDTO> Trees;
    private string errorMessage = "";
    private int PageSize = 6;
    private int Page = 1;
    private int TotalPages = 1;
    private int selectedTreeId;
    private bool showConfirm;
    private bool ShowConfirm {
        get { return this.showConfirm; }
        set {
            this.IsConfirm = false;
            this.showConfirm = value;
        }
    }
    private bool isConfirm;
    private bool IsConfirm
    {
        get { return this.isConfirm; }
        set {
            this.isConfirm = value;
            this.showConfirm = false;
            if(value) this.DeleteTree(selectedTreeId);
        }
    }
    private HttpClient? client;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        client = HttpClientFactory.CreateClient("BTPApi");
        await LoadTrees();
    }

    private async Task LoadTrees(int page = -1)
    {
        if (this.client == null) return;

        try
        {
            Paged<TreeDTO>? response;

            if (page == -1) page = this.Page;

            response = await this.client.GetFromJsonAsync<Paged<TreeDTO>>($"Tree?page={page}&pageSize={PageSize}&search={SearchString}");

            if (response != null)
            {
                this.errorMessage = "";
                this.Trees = response.Data;
                this.Page = page;
                this.TotalPages = response.PageCount;
                StateHasChanged();
            } else
                this.errorMessage = "No content found!";
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    private void ConfirmDeleteTree(int id)
    {
        this.selectedTreeId = id;
        this.showConfirm = true;
    }

    private async void DeleteTree(int id)
    {
        HttpResponseMessage? response;

        if (this.client != null)
        {
            response = await this.client.DeleteAsync($"Tree?id={id}");

            if (!response.IsSuccessStatusCode)
            {
                this.errorMessage = $"The deletion of id={id} has been unsuccessfull";
            } else
            {
                this.errorMessage = $"{id} has been sucessfully deleted";
            }
        }

        await this.LoadTrees();
        StateHasChanged();
    }

    private async Task RemoveSearchString()
    {
        this.SearchString = "";
        this.SearchStringBind = "";

        await this.LoadTrees();
        StateHasChanged();
    }

    private async Task SearchTrees(string searchString)
    {
        this.SearchString = searchString;

        if (this.SearchString == null) return;

        this.Page = 1;
        await this.LoadTrees();
    }
}
