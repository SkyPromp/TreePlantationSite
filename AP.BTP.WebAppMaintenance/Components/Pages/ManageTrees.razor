@* @attribute [Authorize(Roles = "Admin")]
@page "/admin/tree"
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<div class="container">
    <div class="row mb-2">
        <div class="col-4">
            <div class="col-11 input-group">
                <input type="text" @bind="SearchStringBind" @oninput="(e) => SearchTrees(e.Value?.ToString() ?? String.Empty)" placeholder="Search" class="form-control border-0" />
                <button @onclick="RemoveSearchString" class="form-control border-0" style="flex: 0 0 auto; width: 3rem">X</button>
            </div>
        </div>
        <div class="col">
            <NavLink href="/admin/tree/edit">
                <button class="btn btn-secondary">+ Toevoegen</button>
            </NavLink>
        </div>
    </div>
    <div class="row row-cols-3 gap-4 mb-4">
        @foreach (TreeDTO tree in Trees ?? [])
        {
            <div class="col-3">
                <div class="card p-3">
                    <h2>@tree.Species</h2>
                    <div class="row align-items-center">
                        <div class="col-10">
                            <a href="@($"/admin/tree/edit/{tree.Id}")" class="btn btn-secondary w-100">
                                Bewerk
                            </a>
                        </div>
                        <div class="col-1">
                            <h3 @onclick="() => ConfirmDeleteTree(tree.Id)" class="bi bi-trash text-danger d-flex justify-content-center my-1"></h3>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

     <Pagination Class="justify-content-center"
                    Style="margin-top: 2vh"
                    ActivePageNumber="@Page"
                    TotalPages="@TotalPages"
                    PageChanged="LoadTrees"
                    FirstLinkIcon="IconName.ChevronDoubleLeft"
                    PreviousLinkIcon="IconName.ChevronLeft"
                    NextLinkIcon="IconName.ChevronRight"
                    LastLinkIcon="IconName.ChevronDoubleRight">
        </Pagination>
</div>

@if (this.ShowConfirm)
{
    <div class="d-flex justify-content-center">
        <div class="card position-absolute align-self-center p-4 z-3">
            <h1>Bevestig</h1>
            <p>Wenst u om te bevestigen?</p>
            <div class="row gap-3">
                <div class="col">
                    <button @onclick="() => this.ShowConfirm = false" class="btn btn-warning">Annuleer</button>
                </div>
                <div class="col">
                    <button @onclick="() => this.DeleteTree(this.selectedTreeId)" class="btn btn-secondary">Bevestig</button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    /// <summary>
    /// Bound search string for the UI input field.
    /// </summary>
    private string SearchStringBind = "";

    /// <summary>
    /// Actual search string used in API queries.
    /// </summary>
    private string SearchString = "";

    /// <summary>
    /// List of trees retrieved from the API.
    /// </summary>
    private IEnumerable<TreeDTO> Trees;  // TODO read warning

    /// <summary>
    /// Stores any error messages to display in the UI.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// Number of items to display per page.
    /// </summary>
    private int PageSize = 6;

    /// <summary>
    /// Current page number in the pagination.
    /// </summary>
    private int Page = 1;

    /// <summary>
    /// Total number of pages returned by the API.
    /// </summary>
    private int TotalPages = 1;

    /// <summary>
    /// Stores the ID of the currently selected tree for deletion.
    /// </summary>
    private int? selectedTreeId;

    /// <summary>
    /// Indicates whether the confirmation modal for deleting a tree is shown.
    /// </summary>
    private bool ShowConfirm;

    /// <summary>
    /// HttpClient used to make API calls.
    /// </summary>
    private HttpClient? client;

    /// <summary>
    /// Called after the component has been rendered. Initializes the HttpClient and loads trees on first render.
    /// </summary>
    /// <param name="firstRender">True if this is the first render of the component.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        client = HttpClientFactory.CreateClient("BTPApi");
        await LoadTrees();
    }

    /// <summary>
    /// Loads trees from the API, optionally for a specific page.
    /// </summary>
    /// <param name="page">The page number to load. Defaults to -1, which means the current page.</param>
    private async Task LoadTrees(int page = -1)
    {
        if (this.client == null) return;

        try
        {
            Paged<TreeDTO>? response;

            if (page == -1) page = this.Page;

            response = await this.client.GetFromJsonAsync<Paged<TreeDTO>>($"Tree?page={page}&pageSize={PageSize}&search={SearchString}");

            if (response != null)
            {
                this.errorMessage = "";
                this.Trees = response.Data;
                this.Page = page;
                this.TotalPages = response.PageCount;
                StateHasChanged();
            } else
                this.errorMessage = "No content found!";
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    /// <summary>
    /// Sets up the confirmation modal for deleting a tree.
    /// </summary>
    /// <param name="id">The ID of the tree to delete.</param>
    private void ConfirmDeleteTree(int id)
    {
        this.selectedTreeId = id;
        this.ShowConfirm = true;
    }

    /// <summary>
    /// Deletes a tree with the given ID by calling the API.
    /// </summary>
    /// <param name="id">The ID of the tree to delete.</param>
    private async void DeleteTree(int? id)
    {
        if (id == null)
        {
            this.errorMessage = "Tree id is null";
            this.ShowConfirm = false;
            StateHasChanged();

            return;
        }

        if (this.client != null)
        {
            HttpResponseMessage? response = await this.client.DeleteAsync($"Tree?id={id}");

            if (!response.IsSuccessStatusCode)
            {
                this.errorMessage = $"The deletion of id={id} has been unsuccessfull";
            } else
            {
                this.errorMessage = $"{id} has been sucessfully deleted";
            }
        }

        this.ShowConfirm = false;
        this.selectedTreeId = null;
        await this.LoadTrees();
        StateHasChanged();
    }

    /// <summary>
    /// Clears the search string and reloads the full tree list.
    /// </summary>
    private async Task RemoveSearchString()
    {
        this.SearchString = "";
        this.SearchStringBind = "";

        await this.LoadTrees();
        StateHasChanged();
    }

    /// <summary>
    /// Updates the search string and reloads the tree list filtered by the given search term.
    /// </summary>
    /// <param name="searchString">The search string to filter the tree list.</param>
    private async Task SearchTrees(string searchString)
    {
        this.SearchString = searchString;

        if (this.SearchString == null) return;

        this.Page = 1;
        await this.LoadTrees();
    }
} *@
