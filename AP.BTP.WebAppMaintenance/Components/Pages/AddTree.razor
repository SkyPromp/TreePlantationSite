@page "/tree"
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<form @onsubmit="Submit" @onsubmit:preventDefault="true">
    <div class="container m-8">
        <div class="row">
            <div class="col-2 card rounded-bottom-0 align-items-center">
                <p class="m-0 py-2">General</p>
            </div>
        </div>
        <div class="row p-4 card" style="border-top-left-radius: 0;">
            <div class="col-6">
                <div class="form-group">
                    <label for="tree-name" class="form-check-label">Tree name</label>
                    <input type="text" id="tree-name" @bind="treeName" class="form-control"/>
                </div>
            </div>
            <div class="col-6 ps-2">
            </div>
        </div>
        <div class="row mt-2 d-flex flex-row-reverse">
            <div class="col-2 d-flex flex-row-reverse pe-0"> 
                <div>
                    <button type="button" @onclick="ClearForm" class="btn btn-secondary me-1">Cancel</button>
                    <input type="submit" value="Submit" class="btn btn-success"/>
                </div>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    string treeName;
    string errorMessage;

    private void ClearForm()
    {
        this.treeName = "";
    }

    private async Task Submit()
    {
        try
        {
            if(string.IsNullOrEmpty(treeName))
            {
                this.errorMessage = "The tree name is empty";

                return;
            }
            HttpClient client = HttpClientFactory.CreateClient("BTPApi");
            HttpResponseMessage response = await client.PostAsJsonAsync<AP.BTP.Application.CQRS.Tree.TreeDTO>("Tree",
                new AP.BTP.Application.CQRS.Tree.TreeDTO() { Species = this.treeName });

            if (response.IsSuccessStatusCode)
            {
                this.errorMessage = null;
                this.treeName = "";
            }
            else this.errorMessage = this.errorMessage = await response.Content.ReadAsStringAsync();
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

}
