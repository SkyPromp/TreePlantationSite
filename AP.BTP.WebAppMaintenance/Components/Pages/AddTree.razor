@page "/tree/edit/{Id:int?}"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<form @onsubmit="Submit" @onsubmit:preventDefault="true">
    <div class="container m-8">
        <div class="row">
            <div class="col-2 card rounded-bottom-0 align-items-center">
                <p class="m-0 py-2">General</p>
            </div>
        </div>
        <div class="row p-4 card" style="border-top-left-radius: 0;">
            <div class="col-6">
                <div class="form-group">
                    <label for="tree-name" class="form-check-label">Tree name</label>
                    <input type="text" id="tree-name" @bind="treeName" class="form-control" />
                </div>
            </div>
            <div class="col-6 ps-2">
            </div>
        </div>
        <div class="row mt-2 d-flex flex-row-reverse">
            <div class="col-3 d-flex flex-row-reverse pe-0">
                <div>
                    <a href="tree" class="btn btn-secondary me-1">Cancel</a>
                    <button type="button" @onclick="ClearForm" class="btn btn-secondary me-1">Clear</button>
                    <input type="submit" value="Submit" class="btn btn-success" />
                </div>
            </div>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    [Parameter] public int? Id { get; set; }
    string treeName = "";
    string errorMessage = "";
    HttpClient? client;

    protected override async Task OnInitializedAsync()
    {
        client = HttpClientFactory.CreateClient("BTPApi");

        if (Id.HasValue) await LoadTree(Id.Value);
    }

    private async Task LoadTree(int id)
    {
        if (this.client == null)
        {
            this.errorMessage = "No httpclient found.";

            return;
        }

        AP.BTP.Application.CQRS.Tree.TreeDTO? response = await this.client.GetFromJsonAsync<AP.BTP.Application.CQRS.Tree.TreeDTO>($"Tree/{id}");

        if (response != null) this.treeName = response.Species;
        else this.errorMessage = "Couldn't load tree";

        StateHasChanged();
    }

    private void ClearForm()
    {
        this.treeName = "";
    }

    private async Task Submit()
    {
        try
        {
            if (this.client == null)
            {
                this.errorMessage = "No httpclient found.";

                return;
            }

            if (string.IsNullOrEmpty(treeName))
            {
                this.errorMessage = "The tree name is empty";

                return;
            }

            HttpResponseMessage response;

            if (this.Id == null)
            {
                response = await this.client.PostAsJsonAsync<AP.BTP.Application.CQRS.Tree.TreeDTO>("Tree", new AP.BTP.Application.CQRS.Tree.TreeDTO() { Species = this.treeName });
            } else
            {
                response = await this.client.PutAsJsonAsync<AP.BTP.Application.CQRS.Tree.TreeDTO>("Tree", new AP.BTP.Application.CQRS.Tree.TreeDTO() { Id = this.Id.Value, Species = this.treeName });
            }

            if (response.IsSuccessStatusCode)
            {
                this.errorMessage = "";
                this.treeName = "";
                NavigationManager.NavigateTo("/tree");
            } else
                this.errorMessage = this.errorMessage = await response.Content.ReadAsStringAsync();
        } catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }
}
