@attribute [Authorize(Roles = "Admin, Manager")]
@page "/admin/tree"
@page "/manager/tree"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory


<div class="d-flex justify-content-between px-4">
    @if(user != null && user.IsInRole("Admin")){
        <Button Color="ButtonColor.Dark" Style="width: 10vw; height: 5vh" @onclick="GoToAddForm"><Icon Name="IconName.Plus"></Icon> Toevoegen</Button>
    }
    <TextInput @bind-Value="@searchText" @oninput="OnSearchChanged" TextAlignment="Alignment.Start" Placeholder="Zoeken..." Style="width: 25vw; height: 5vh"/>

    <select class="form-select" @onchange="OnSortOrderChanged" style="width: 15vw; height: 5vh">
        <option value="true" selected>A-Z</option>
        <option value="false">Z-A</option>
    </select>    
</div>
<div class="container-fluid m-0">
    @if (response?.Items != null)
    {
        @foreach (List<TreeDTO> row in Rows)
        {
            <div class="row">
                @foreach (TreeDTO item in row)
                {
                    <div class="col-md-4" style="padding: 2vh">
                        <Card Style="background-color: #D9D9D9; border-radius: 24px; border: none; padding: 2vh 4vh">
                            <CardBody Class="p-0 m-0" Style="height: 27vh;">
                                <CardTitle Class="mb-2" Style="font-weight: bold; margin-bottom: 3vh; text-size: 5vh;">@item.Species</CardTitle>
                                
                                <div class="row h-100">
                                    <div class="col-9 d-flex justify-content-center align-items-center" style="height: 80%;">
                                        @if(images.TryGetValue(item.Id.ToString(), out string? imgUrl) && !string.IsNullOrWhiteSpace(imgUrl))
                                        {
                                            <Image Src="@imgUrl" Style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center w-100 h-100">
                                                Nog geen afbeelding
                                            </div>
                                        }
                                    </div>

                                    <div class="col-3 d-flex flex-column justify-content-around" style="height: 80%;">
                                        @if(user != null && user.IsInRole("Admin"))
                                        {
                                            <Button Class="p-0" Style="box-shadow: none; border: none; width:100%; height: 5vh;" @onclick="() => GoToUpdateForm(item.Id)" TooltipTitle="Bewerken" TooltipColor="TooltipColor.Dark">
                                                <Icon Name="IconName.Pen" Color="IconColor.Dark" Style="font-size: 4vh;"></Icon>
                                            </Button>
                                            <Button Class="p-0" Style="box-shadow: none; border: none; width:100%; height: 5vh;" @onclick="() => { this.showDeleteConfirmation = true; selectedTree = item; }" TooltipTitle="Verwijderen" TooltipColor="TooltipColor.Danger">
                                                <Icon Name="IconName.Trash" Color="IconColor.Danger" Style="font-size: 4vh;"></Icon>
                                            </Button>
                                        }
                                        else if(user != null && user.IsInRole("Manager"))
                                        {
                                            <a href="@($"/manager/tree/{item.Id}")" style="text-decoration:none;">
                                                <Button Class="p-0" Style="box-shadow: none; border: none; width:100%; height: 5vh;" TooltipTitle="Details bekijken" TooltipColor="TooltipColor.Dark">
                                                    <Icon Name="IconName.Eye" Color="IconColor.Dark" Style="font-size: 4vh;"></Icon>
                                                </Button>
                                            </a>
                                        }
                                    </div>
                                </div>

                            </CardBody>
                            
                        </Card>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="text-center mt-4">Geen resultaten gevonden.</p>
    }

    <Pagination 
            Class="justify-content-center"
            Style="margin-top: 2vh"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
    </Pagination>
</div>

<Toasts Class="m-3" Messages="toastMessages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" ShowCloseButton="false"/>

<ConfirmationPopup 
    showConfirmationPopup="@(this.showDeleteConfirmation && user != null && user.IsInRole("Admin"))"
    onCancellation="this.CancelDeleteTree"
    onConfirmation="this.DeleteTree"
    confirmationDescription="Bent u zeker dat u deze boom wilt verwijderen?"
/>

@code {
    /// <summary>
    /// Indicates whether an API call or operation is in progress.
    /// </summary>
    private bool isLoading = false;

    /// <summary>
    /// Holds the list of toast messages to display in the UI.
    /// </summary>
    private readonly List<ToastMessage> toastMessages = new List<ToastMessage>();

    /// <summary>
    /// Indicates whether a delete confirmation modal should be displayed.
    /// </summary>
    private bool showDeleteConfirmation = false;

    /// <summary>
    /// The currently selected tree being deleted.
    /// </summary>
    private TreeDTO? selectedTree;

    /// <summary>
    /// Current search text entered by the user for filtering trees.
    /// </summary>
    private string? searchText = null;

    /// <summary>
    /// Whether the tree list should be sorted ascending (A-Z). Defaults to true.
    /// </summary>
    private bool sortAscending = true;

    /// <summary>
    /// Holds the paged response of trees from the API.
    /// </summary>
    PagedResponseDTO<TreeDTO>? response;  // TODO should not be stored? just store an IEnumerable<...DTO>????

    /// <summary>
    /// The current page number being displayed.
    /// </summary>
    private int currentPage = 1;

    /// <summary>
    /// Number of cards to display per row in the UI.
    /// </summary>
    private int cardsPerRow = 3;

    /// <summary>
    /// Maximum number of rows per page.
    /// </summary>
    private int maxRows = 2;

    /// <summary>
    /// Number of items displayed per page, calculated as <see cref="cardsPerRow"/> * <see cref="maxRows"/>.
    /// </summary>
    private int pageSize => cardsPerRow * maxRows;

    /// <summary>
    /// Total number of pages available based on the API response.
    /// Defaults to 1 if no response is loaded.
    /// </summary>
    private int totalPages => response?.TotalPages ?? 1;

    /// <summary>
    /// Timer used to debounce the search input to avoid making too many API calls while typing.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// Stores the base64-encoded image data for trees, keyed by tree ID as a string.
    /// </summary>
    private Dictionary<string, string> images = new();

    /// <summary>
    /// Represents the current authenticated user.
    /// </summary>
    private ClaimsPrincipal? user;

    /// <summary>
    /// Lifecycle method called when the component is initialized.
    /// Loads the first page of trees.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User;
        await LoadPage(1);
    }

    /// <summary>
    /// Loads a specific page of trees from the API, optionally filtered by <see cref="searchText"/>.
    /// Updates <see cref="response"/> and refreshes the UI.
    /// </summary>
    /// <param name="page">The page number to load.</param>
    private async Task LoadPage(int page)
    {
        currentPage = page;
        HttpClient client = HttpClientFactory.CreateClient("BTPApi");

        string url = $"Tree?pageNr={page}&pageSize={pageSize}&sortAscending={sortAscending}";

        if (!string.IsNullOrWhiteSpace(searchText)) url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponseDTO<TreeDTO>>(url);

        if(response == null)
        {
            EnqueueToast(message: "De bomen konnen niet worden ingeladen.", ToastType.Success);

            return;
        }

        foreach (TreeDTO tree in response.Items){
            await GetFavouriteTreePicture(tree.Id);
        }

        StateHasChanged();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles changes in the search input field. Debounces the search by 300ms before reloading the first page.
    /// </summary>
    /// <param name="e">The change event containing the new search text.</param>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();

        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Navigates to the form for adding a new tree.
    /// </summary>
    private void GoToAddForm()
    {
        Navigation.NavigateTo("/admin/tree/edit");
    }

    /// <summary>
    /// Navigates to the form for editing an existing tree.
    /// </summary>
    /// <param name="id">The ID of the tree to edit.</param>
    private void GoToUpdateForm(int id)
    {
        Navigation.NavigateTo($"/admin/tree/edit/{id}");
    }

    /// <summary>
    /// Groups the trees into rows for display based on <see cref="cardsPerRow"/>.
    /// Each row is represented as a list of <see cref="TreeDTO"/>.
    /// </summary>
    private IEnumerable<List<TreeDTO>> Rows =>
    (response?.Items ?? Enumerable.Empty<TreeDTO>())
        .Select((item, index) => new { item, index })
        .GroupBy(x => x.index / cardsPerRow)
        .Select(g => g.Select(x => x.item).ToList());

    /// <summary>
    /// Deletes the selected site from the internal database.
    /// </summary>
    private async Task DeleteTree()
    {
        isLoading = true;
        if (selectedTree == null) return;

        HttpClient client = HttpClientFactory.CreateClient("BTPApi");
        try
        {
            HttpResponseMessage response = await client.DeleteAsync($"Tree/{selectedTree.Id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadPage(currentPage);
                StateHasChanged();
                EnqueueToast(message: "De boom is correct verwijdert geweest.", ToastType.Success);
            }
        }
        catch (InvalidOperationException ex)
        {
            EnqueueToast(message: $"Fout bij het verwijderen van gebruiker: {ex.Message}", ToastType.Success);
        }
        catch (HttpRequestException ex)
        {
            EnqueueToast(message: $"Fout bij het verwijderen van gebruiker: {ex.Message}", ToastType.Success);
        }
        catch (TaskCanceledException ex)
        {
            EnqueueToast(message: $"Fout bij het verwijderen van gebruiker, de taak is geannuleerd: {ex.Message}", ToastType.Success);
        }
        await CancelDeleteTree();
        isLoading = false;
    }

    /// <summary>
    /// Cancels the tree deletion process and resets related UI state.
    /// </summary>
    private Task CancelDeleteTree()
    {
        this.showDeleteConfirmation = false;
        this.selectedTree = null;

        return Task.CompletedTask;
    }

    /// <summary>
    /// Handles changes to the sort order dropdown.  
    /// Converts the selected value to a boolean and reloads the first page of the tree list.
    /// </summary>
    /// <param name="e">The <see cref="ChangeEventArgs"/> containing the selected value from the dropdown.</param>
    private async Task OnSortOrderChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool value))
        {
            sortAscending = value;
            await LoadPage(1);
        }
    }

    /// <summary>
    /// Fetches all pictures for a specific tree and generates a base64 image for the favourite picture,
    /// or the first picture if no favourite is set.
    /// The result is stored in the <see cref="images"/> dictionary keyed by the tree ID.
    /// </summary>
    /// <param name="id">The ID of the tree to fetch pictures for.</param>
    private async Task GetFavouriteTreePicture(int id){
        HttpClient client = HttpClientFactory.CreateClient("BTPApi");

        List<TreePictureDTO>? pictures = await client.GetFromJsonAsync<List<TreePictureDTO>>($"TreePicture/{id}");

        if (pictures == null || pictures.Count <= 0)
        {
            EnqueueToast(message: "Geen foto kon worden gevonden.", ToastType.Warning);

            return;
        }

        if(pictures.Any(p => p.IsFavourite == true)){
            TreePictureDTO? picture = pictures.Find(p => p.IsFavourite == true)!;
            await GenerateImage(id, picture.Path);
        } else {
            TreePictureDTO? picture = pictures.OrderBy(p => p.Id).FirstOrDefault()!;
            await GenerateImage(id, picture.Path);
        }
    }

    /// <summary>
    /// Generates a base64-encoded image from a file path fetched from the API and stores it in <see cref="images"/>.
    /// </summary>
    /// <param name="key">The key (tree ID) under which the image is stored in <see cref="images"/>.</param>
    /// <param name="path">The file path of the image to load from the API.</param>
    private async Task GenerateImage(int key, string path){

        if (string.IsNullOrWhiteSpace(path))
        {
            EnqueueToast(message: "Een afbeelding kon niet worden gegenereerd. Het pad is leeg.", ToastType.Warning);

            return;
        }

        HttpClient client = HttpClientFactory.CreateClient("BTPApi");

        try
        {
            HttpResponseMessage response = await client.GetAsync($"File/{path}");
            response.EnsureSuccessStatusCode();
            byte[] imageBytes = await response.Content.ReadAsByteArrayAsync();
            string contentType = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";
            string base64Image = Convert.ToBase64String(imageBytes);
            images[key.ToString()] = $"data:{contentType};base64,{base64Image}";
        } catch (InvalidOperationException e)
        {
            images[key.ToString()] = string.Empty;
            EnqueueToast(message: $"Een afbeelding kon niet worden gegenereerd. {e}", ToastType.Warning);
        } catch (TaskCanceledException e)
        {
            images[key.ToString()] = string.Empty;
            EnqueueToast(message: $"Een afbeelding kon niet worden gegenereerd. {e}", ToastType.Warning);
        } catch (UriFormatException e)
        {
            images[key.ToString()] = string.Empty;
            EnqueueToast(message: $"Een afbeelding kon niet worden gegenereerd. {e}", ToastType.Warning);
        } catch (HttpRequestException e)
        {
            images[key.ToString()] = string.Empty;
            EnqueueToast(message: $"Een afbeelding kon niet worden gegenereerd. {e}", ToastType.Warning);
        } catch (ArgumentNullException e)
        {
            images[key.ToString()] = string.Empty;
            EnqueueToast(message: $"Een afbeelding kon niet worden gegenereerd. {e}", ToastType.Warning);
        }
    }

    /// Adds a toast message to the toast container.
    /// </summary>
    /// <param name="message">The message to display.</param>
    /// <param name="type">The message type to display.</param>
    private void EnqueueToast(string message, ToastType type)
    {
        this.toastMessages.Add(new ToastMessage
        {
            Type = type,
            Title = type.ToString(),
            Message = message,
            AutoHide = true
        });
    }
}