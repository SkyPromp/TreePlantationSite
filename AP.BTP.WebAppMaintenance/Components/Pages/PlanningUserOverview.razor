@attribute [Authorize(Roles = "Admin, Manager")]
@page "/manager/planning"
@rendermode InteractiveServer
@using System.Drawing
@using System.Text.Json
@using System.Text.Encodings.Web
@using AP.BTP.Contracts.DTOs
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Planning gebruikersselectie</PageTitle>

<h3 class="text-center">Planning gebruikersselectie</h3>

<div class="d-flex justify-content-end px-3">
    <div class="d-flex flex-column align-items-end">
        <TextInput @bind-Value="@searchText"
                   @oninput="OnSearchChanged"
                   TextAlignment="Alignment.Start"
                   Placeholder="Zoek gebruikers"
                   class="mb-3"
                   style="width: 15vw; border-width: 2px;" />
    </div>
</div>
<div class="container-fluid m-0 p-3" Style="background-color: #D9D9D9; border-radius: 15px;">
    @if (response?.Items != null)
    {
        <div class="d-grid p-1 fw-bold"
             style="grid-template-columns: 1fr 2fr 2fr 2fr auto; column-gap: 1rem; border-radius: 10px;">
            <div @onclick='() => OnSortChanged("FirstName")' style="cursor:pointer;">
                Naam @SortIndicator("FirstName")
            </div>
            <div @onclick='() => OnSortChanged("Email")' style="cursor:pointer;">
                E-mail @SortIndicator("Email")
            </div>
            <div @onclick='() => OnSortChanged("PhoneNumber")' style="cursor:pointer;">
                Gsm-number @SortIndicator("PhoneNumber")
            </div>
            <div>Plantagelocaties</div>
            <div class="text-center">Beheren</div>
        </div>
        <div style="overflow-x:hidden; max-height: 55vh;">
            @foreach (List<UserDto> row in Rows)
            {
                <div class="row">
                    @foreach (UserDto item in row)
                    {
                        <div class="p-2">
                            <Card Class="px-2 mb-0" Style="background-color: #FFFFFF; border-radius: 10px; border: none;">
                                <CardBody Class="p-0 d-grid align-items-center"
                                          Style="grid-template-columns: 1fr 2fr 2fr 2fr auto; column-gap: 1rem;">
                                    <CardText class="m-0">@item.FirstName  @item.LastName</CardText>
                                    <CardText class="m-0">
                                        <a href="mailto:@item.Email" style="text-decoration:none; color:#0d6efd;">
                                            @item.Email
                                        </a>
                                    </CardText>
                                    <CardText class="m-0">123456456789</CardText>
                                    @if (item.PlantationSites != null)
                                    {
                                        <CardText class="m-0">@string.Join(", ", item.PlantationSites.Select(s => s.Name))</CardText>
                                    }
                                    else
                                    {
                                        <CardText class="m-0">n.v.t.</CardText>
                                    }
                                    <div class="p-1">
                                        <a href="/manager/planning/user/@item.Id">
                                            <Button title="Selecteer gebruiker"
                                                    Class="btn btn-dark btn-sm px-3">
                                                Selecteren
                                            </Button>
                                        </a>
                                    </div>
                                </CardBody>

                            </Card>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center mt-4">Geen resultaten gevonden.</p>
    }
</div>

<Pagination Class="justify-content-center"
            Style="margin-top: 10px"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
</Pagination>

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    /// <summary>
    /// The current search text entered by the user. Used for filtering operators.
    /// </summary>
    private string? searchText = null;

    /// <summary>
    /// Holds the paged response containing operator users from the API.
    /// </summary>
    PagedResponseDto<UserDto>? response;  // TODO why is this here? shouldn't be global or has a bad name

    /// <summary>
    /// The current page number being displayed.
    /// </summary>
    private int currentPage = 1;

    /// <summary>
    /// Number of cards to display per row in the UI.
    /// </summary>
    private readonly int cardsPerRow = 1;

    /// <summary>
    /// Maximum number of rows to display per page.
    /// </summary>
    private readonly int maxRows = 7;

    /// <summary>
    /// Number of users to display per page (calculated as <see cref="cardsPerRow"/> * <see cref="maxRows"/>).
    /// </summary>
    private int pageSize => cardsPerRow * maxRows;

    /// <summary>
    /// Total number of pages available based on the API response.
    /// Defaults to 1 if no response is loaded.
    /// </summary>
    private int totalPages => response?.TotalPages ?? 1;

    /// <summary>
    /// Timer used to debounce the search input, to avoid excessive API calls while typing.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// HttpClient used to call the backend API.
    /// </summary>
    private HttpClient client = default!; 

    /// <summary>
    /// Stores any error messages encountered during API calls.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// Indicates the sorting direction
    /// </summary>
    private string sortDirection = "asc";

    /// <summary>
    /// Indicates what needs to be sorted
    /// </summary>
    private string sortBy = "FirstName";

    /// <summary>
    /// Lifecycle method called after the component has rendered.
    /// Initializes the HttpClient and loads the first page of operators on first render.
    /// </summary>
    /// <param name="firstRender">True if this is the first render of the component.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            client = HttpClientFactory.CreateClient("BTPApi");
            await LoadPage(1);
        }
    }

    /// <summary>
    /// Loads a specific page of operator users from the API, optionally filtered by <see cref="searchText"/>.
    /// Updates <see cref="response"/> and triggers UI refresh.
    /// </summary>
    /// <param name="page">The page number to load.</param>
    private async Task LoadPage(int page)
    {
        currentPage = page;

        string url = $"user/operators?pageNr={page}&pageSize={pageSize}&sortBy={sortBy}&sortDirection={sortDirection}";
        if (!string.IsNullOrWhiteSpace(searchText))
            url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponseDto<UserDto>>(url);
        StateHasChanged();
    }

    /// <summary>
    /// Handles changes in the search input field. Debounces API calls by 300ms.
    /// </summary>
    /// <param name="e">The change event containing the new search text.</param>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Groups the operator users into rows for display based on <see cref="cardsPerRow"/>.
    /// Each row is represented as a list of <see cref="UserDto"/>.
    /// </summary>
    private IEnumerable<List<UserDto>> Rows =>
    (response?.Items ?? Enumerable.Empty<UserDto>())
        .Select((item, index) => new { item, index })
        .GroupBy(x => x.index / cardsPerRow)
        .Select(g => g.Select(x => x.item).ToList());

    /// <summary>
    /// Handles changes in the sorting direction.
    /// </summary>
    /// <param name="column">The column that needs to be sorted.</param>
    private void OnSortChanged(string column)
    {
        if (sortBy == column)
        {
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        }
        else
        {
            sortBy = column;
            sortDirection = "asc";
        }

        _ = LoadPage(1);
    }

    /// <summary>
    /// Handles the icon to display for the sorting direction.
    /// </summary>
    /// <param name="column">The column that needs to be sorted.</param>
    private string SortIndicator(string column)
    {
        if (sortBy != column) return "";
        return sortDirection == "asc" ? "↑" : "↓";
    }
}
