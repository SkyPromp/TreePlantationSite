@attribute [Authorize(Roles = "Admin")]
@page "/admin/users/approve"
@rendermode InteractiveServer
@using AP.BTP.Application.CQRS.Auth0User
@using System.Drawing
@using System.Text.Json
@using AP.BTP.Application.CQRS.PlantationSite
@using System.Text.Encodings.Web
@using AP.BTP.Application.CQRS.User
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Wachtende gebruikers</PageTitle>

<h3 class="text-center">Wachtende gebruikers goedkeuren</h3>

<div class="d-flex justify-content-between px-3">
    <a href="/admin/users" style="text-decoration: none;">
        <Button Class="d-flex align-items-center justify-content-center p-0 fs-4"
                Style=" box-shadow: none; border: none; text-decoration: none;">
            <Icon class="me-3" Name="IconName.ArrowLeft" Style="font-size: 2.5rem;"></Icon>
            Goedgekeurde gebruikers
        </Button>
    </a>
    <div class="d-flex flex-column align-items-end">
        <TextInput @bind-Value="@searchText"
                   @oninput="OnSearchChanged"
                   TextAlignment="Alignment.Start"
                   Placeholder="zoek e-mail"
                   Class="@(showSearchWarning ? "border-danger" : "")"
                   Style="width: 15vw; border-width: 2px;" />
        @if (showSearchWarning)
        {
            <small class="text-danger mt-1">Voer minimaal 3 tekens in</small>
        }
    </div>
</div>
<div class="container-fluid m-0 p-3" Style="background-color: #D9D9D9; border-radius: 15px;">
    @if (response?.Items != null)
    {
        <div class="d-grid p-1 fw-bold"
             style="grid-template-columns: 1fr 2fr 2fr auto; column-gap: 1rem; border-radius: 10px;">
            <div>Naam</div>
            <div>E-mail</div>
            <div>Gsm-nummer</div>
            <div class="text-center">Goedkeuring</div>
        </div>
        <div style="overflow-x:hidden; max-height: 55vh;">
            @foreach (List<Auth0User> row in Rows)
            {
                <div class="row">
                    @foreach (Auth0User item in row)
                    {
                        <div class="p-2">
                            <Card Class="px-2 mb-0" Style="background-color: #FFFFFF; border-radius: 10px; border: none;">
                                <CardBody Class="p-0 d-grid align-items-center"
                                          Style="grid-template-columns: 1fr 2fr 2fr auto; column-gap: 1rem;">
                                    <CardText class="m-0">@item.username</CardText>
                                    <CardText class="m-0">
                                        <a href="mailto:@item.email" style="text-decoration:none; color:#0d6efd;">
                                            @item.email
                                        </a>
                                    </CardText>
                                    <CardText class="m-0">123456456789</CardText>
                                    <div class="p-1">
                                        <Button title="Gebruiker goedkeuren"
                                                Class="btn btn-success btn-sm"
                                                @onclick="() => { this.showEditUser = true; selectedUserId = item.user_id; }">
                                            <Icon Name="IconName.Check2" />
                                        </Button>
                                        <Button title="Gebruiker afwijzen"
                                                Class="btn btn-danger btn-sm"
                                                @onclick="() => { this.showDeleteConfirmation = true; selectedUserId = item.user_id; }">
                                            <Icon Name="IconName.X" />
                                        </Button>
                                    </div>
                                </CardBody>

                            </Card>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center mt-4">Geen resultaten gevonden.</p>
    }
</div>

<Pagination Class="justify-content-center"
            Style="margin-top: 10px"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
</Pagination>

@if (this.showEditUser)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Selecteer de rol die aan deze gebruiker moet worden toegewezen</h5>
            <select @bind="this.roleId" class="form-select mb-3">
                @foreach (Auth0Role auth0Role in this.roles)
                {
                    <option value="@auth0Role.Id">@auth0Role.Name</option>
                }
            </select>
            @if (roles.FirstOrDefault(r => r.Id == roleId)?.Name == "Operator")
            {
                <h5>Selecteer de plantagelocaties die aan deze gebruiker moeten worden toegewezen</h5>
                <p>Plantagelocatie 1</p>
                <select @bind="this.site1" class="form-select mb-3">
                    <option value=""></option>
                    @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                    {
                        <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site2)">@plantationSite.Name</option>
                    }
                </select>

                <p>Plantagelocatie 2</p>
                <select @bind="this.site2" class="form-select mb-3">
                    <option value=""></option>
                    @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                    {
                        <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site1)">@plantationSite.Name</option>
                    }
                </select>
            }
            @if (isLoading)
            {

                <div class="spinner-border align-self-center" role="status">
                    <span class="visually-hidden">Laden...</span>
                </div>
            }
            else
            {
                <div class="row gap-3">
                    <div class="col">
                        <button @onclick="CancelEditUser" class="btn btn-warning">Annuleer</button>
                    </div>
                    <div class="col">
                        <button @onclick="ApproveUser" class="btn btn-secondary" disabled="@string.IsNullOrEmpty(roleId)">Bevestig</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (this.showDeleteConfirmation)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Ben je zeker dat je deze <br /> gebruiker wil afwijzen?</h5>
            @if (isLoading)
            {

                <div class="spinner-border align-self-center" role="status">
                    <span class="visually-hidden">Laden...</span>
                </div>
            }
            else
            {
                <div class="row gap-3">
                    <div class="col">
                        <button @onclick="CancelEditUser" class="btn btn-warning">Annuleer</button>
                    </div>
                    <div class="col">
                        <button @onclick="RejectUser" class="btn btn-danger">Bevestig</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (this.showSuccessToast)
{
    <div class="toast-container position-fixed top-50 start-50 translate-middle-x mt-3" style="z-index: 1055;">
        <div class="toast show text-white bg-success shadow" style="opacity:@toastOpacity; transition: opacity 0.5s ease;">
            <div class="toast-body">
                ✅ Gebruiker is succesvol goedgekeurd!
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    /// <summary>
    /// The current search text entered by the user.
    /// Used to filter pending users by name or email.
    /// </summary>
    private string? searchText = null;

    /// <summary>
    /// Indicates whether a warning should be displayed when the search text is too short.
    /// </summary>
    private bool showSearchWarning = false;

    /// <summary>
    /// The paginated response containing pending users retrieved from the backend.
    /// </summary>
    PagedResponse<Auth0User>? response;  // TODO just use IEnumerable<...> not a respone

    /// <summary>
    /// The current page index of the user list being displayed.
    /// </summary>
    private int currentPage = 1;

    /// <summary>
    /// The number of cards (user entries) displayed per row.
    /// </summary>
    private int cardsPerRow = 1;

    /// <summary>
    /// The maximum number of rows of user cards displayed per page.
    /// </summary>
    private int maxRows = 7;

    /// <summary>
    /// The calculated number of user cards displayed per page.
    /// </summary>
    private int pageSize => cardsPerRow * maxRows;

    /// <summary>
    /// The total number of pages available based on the server response.
    /// </summary>
    private int totalPages => response?.TotalPages ?? 1;

    /// <summary>
    /// A timer used to debounce the search input, preventing excessive API calls.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// The HTTP client used for API communication. TODO: make optional and handle null cases.
    /// </summary>
    HttpClient client;  // TODO make optional and check if null

    /// <summary>
    /// Stores any error messages that occur during data fetching or API actions.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// Flag indicating whether the edit user modal or section is visible.
    /// </summary>
    private bool showEditUser;

    /// <summary>
    /// A collection of all plantation sites loaded from the API.
    /// Used to assign users to one or more sites.
    /// </summary>
    private IEnumerable<PlantationSiteDTO> plantationSites = new List<PlantationSiteDTO>();

    /// <summary>
    /// The first selected plantation site ID for the user being approved.
    /// </summary>
    private int? site1;

    /// <summary>
    /// The second selected plantation site ID for the user being approved.
    /// </summary>
    private int? site2;

    /// <summary>
    /// The selected role ID assigned to the user during approval.
    /// </summary>
    private string roleId = "";

    /// <summary>
    /// The selected role ID assigned to the user during approval.
    /// </summary>    private string roleId = "";
    private string selectedUserId = "";

    /// <summary>
    /// Indicates whether the success toast notification should be displayed.
    /// </summary>
    private bool showSuccessToast = false;

    /// <summary>
    /// The opacity level of the success toast for fade-in/out animation.
    /// </summary>
    private double toastOpacity = 1.0;

    /// <summary>
    /// A list of available Auth0 roles loaded from the API.
    /// </summary>
    private IEnumerable<Auth0Role> roles = new List<Auth0Role>();

    /// <summary>
    /// Indicates whether the component is performing a background operation (e.g., approving a user).
    /// </summary>
    private bool isLoading = false;

    /// <summary>
    /// Determines whether the delete confirmation dialog is currently displayed.
    /// </summary>
    private bool showDeleteConfirmation = false;

    /// <summary>
    /// Called after the component is rendered for the first time.
    /// Initializes the HTTP client and loads required data such as users, sites, and roles.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            client = HttpClientFactory.CreateClient("BTPApi");

            await LoadPage(1);
            await LoadPlantationSites();
            await LoadRoles();
        }
    }

    /// <summary>
    /// Loads a specific page of pending users from the API.
    /// Applies search filters if the search text length is valid (≥ 3 characters).
    /// </summary>
    /// <param name="page">The page number to load.</param>
    private async Task LoadPage(int page)
    {
        currentPage = page;

        string url = $"UserManagement/pending?pageNr={page}&pageSize={pageSize}";
        if (!string.IsNullOrWhiteSpace(searchText) && searchText.Length >= 3)
            url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponse<Auth0User>>(url);
        StateHasChanged();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Approves a selected pending user by assigning a role and plantation sites.
    /// Sends requests to update the user in Auth0 and link them to plantation sites.
    /// </summary>
    private async Task ApproveUser()
    {
        isLoading = true;

        HttpResponseMessage responseMessage = await client.PostAsJsonAsync($"UserManagement/users/auth/{selectedUserId}/approval", new ApproveUserDTO() { Role = roleId });

        if (responseMessage.IsSuccessStatusCode)
        {
            await Task.Delay(500); // small delay to ensure auth0 has processed the change
            await LoadPage(currentPage);
            StateHasChanged();

            List<int> selectedSites = new List<int>();
            if (site1.HasValue)
                selectedSites.Add(site1.Value);
            if (site2.HasValue)
                selectedSites.Add(site2.Value);

            UserDTO user = responseMessage.Content.ReadFromJsonAsync<UserDTO>().Result!;

            await client.PutAsJsonAsync($"UserManagement/users/{user.Id}/sites", new LinkUserToPlantationSitesDto() { PlantationSiteIds = selectedSites });

            CancelEditUser();

            await ShowSuccessToast();
        }

        isLoading = false;
    }

    /// <summary>
    /// Handles user input in the search box.
    /// Debounces input and triggers a filtered user search after a short delay.
    /// </summary>
    /// <param name="e">The change event containing the new search input value.</param>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();
        showSearchWarning = !string.IsNullOrEmpty(searchText) && searchText.Length < 3;
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Splits the list of users into rows for grid-based rendering in the UI.
    /// </summary>
    private IEnumerable<List<Auth0User>> Rows =>
    (response?.Items ?? Enumerable.Empty<Auth0User>())
        .Select((item, index) => new { item, index })
        .GroupBy(x => x.index / cardsPerRow)
        .Select(g => g.Select(x => x.item).ToList());

    /// <summary>
    /// Loads the list of available plantation sites from the API.
    /// </summary>
    private async Task LoadPlantationSites()
    {
        if (this.client == null) return;

        try
        {
            PagedResponse<PlantationSiteDTO>? response;

            response = await this.client.GetFromJsonAsync<PagedResponse<PlantationSiteDTO>>("PlantationSite");

            if (response != null)
            {
                this.plantationSites = response.Items;
                StateHasChanged();
            }
            else
            {
                this.errorMessage = "Something went wrong when loading in the plantation sites";
            }
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    /// <summary>
    /// Loads the list of available roles from the API to be assigned to users during approval.
    /// </summary>
    private async Task LoadRoles()
    {
        if (this.client == null) return;

        try
        {
            IEnumerable<Auth0Role>? response;

            response = await this.client.GetFromJsonAsync<IEnumerable<Auth0Role>>("UserManagement/Roles");

            if (response != null)
            {
                this.roles = response;
                StateHasChanged();
            }
            else
            {
                this.errorMessage = "Something went wrong when loading in the roles";
            }
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    /// <summary>
    /// Cancels the current user edit or approval operation and resets form state.
    /// </summary>
    private void CancelEditUser()
    {
        this.showEditUser = false;
        this.selectedUserId = "";
        this.site1 = null;
        this.site2 = null;
        this.roleId = "";
        this.showDeleteConfirmation = false;
    }

    /// <summary>
    /// Disables a plantation site option if it has already been selected as another site for the same user.
    /// </summary>
    /// <param name="id">The ID of the plantation site.</param>
    /// <param name="otherSite">The ID of the other selected site.</param>
    /// <returns>True if the site should be disabled; otherwise, false.</returns>
    private bool IsDisabled(int id, int? otherSite) => otherSite.HasValue && id == otherSite.Value;

    /// <summary>
    /// Displays a temporary success toast message with fade-in and fade-out animations.
    /// </summary>
    private async Task ShowSuccessToast()
    {
        showSuccessToast = true;
        toastOpacity = 1.0;
        StateHasChanged();

        await Task.Delay(2500);

        toastOpacity = 0.0;
        StateHasChanged();

        await Task.Delay(500);
        showSuccessToast = false;
        StateHasChanged();
    }

    /// <summary>
    /// Rejects a pending user by sending a deletion request to the API and Auth0.
    /// Refreshes the user list afterward.
    /// </summary>
    private async Task RejectUser()
    {
        isLoading = true;
        if (string.IsNullOrWhiteSpace(selectedUserId))
            return;

        try
        {
            HttpResponseMessage response = await client.DeleteAsync($"UserManagement/users/auth/{selectedUserId}");

            if (response.IsSuccessStatusCode)
            {
                await Task.Delay(500); // small delay to ensure auth0 has processed the change
                await LoadPage(currentPage);
                StateHasChanged();
            }
            else
            {
                errorMessage = $"Kon gebruiker niet afwijzen: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fout bij het afwijzen van gebruiker: {ex.Message}";
        }

        CancelEditUser();
        isLoading = false;
    }
}
