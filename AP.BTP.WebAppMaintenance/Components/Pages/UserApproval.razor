@page "/users/approve"
@rendermode InteractiveServer
@using AP.BTP.Application.CQRS.Auth0User
@using System.Drawing
@using System.Text.Json
@using AP.BTP.Application.CQRS.PlantationSite
@using System.Text.Encodings.Web
@inject IHttpClientFactory HttpClientFactory

<div class="d-flex justify-content-between px-4">
    <Button Href="/users"
            Class="d-flex align-items-center justify-content-center p-0"
            Style=" box-shadow: none; border: none; text-decoration: none; font-size: 2.7vh;">
        <Icon Name="IconName.ArrowLeft" Style="font-size: 5vh; margin-right: 0.5rem;"></Icon>
        Registered users
    </Button>
    <div class="d-flex flex-column align-items-end">
        <TextInput @bind-Value="@searchText"
                   @oninput="OnSearchChanged"
                   TextAlignment="Alignment.Start"
                   Placeholder="Search e-mail"
                   Class="@(showSearchWarning ? "border-danger" : "")"
                   Style="width: 15vw; height: 5vh; border-width: 2px;" />
        @if (showSearchWarning)
        {
            <small class="text-danger mt-1">Please enter at least 3 characters.</small>
        }
    </div>
</div>
<div class="container-fluid m-0" Style="background-color: #D9D9D9; border-radius: 15px; padding: 4vh">
    @if (response?.Items != null)
    {
        <div class="d-grid p-2 fw-bold"
             style="grid-template-columns: 1fr 2fr 2fr auto; column-gap: 1rem; border-radius: 10px;">
            <div>Name</div>
            <div>E-mail</div>
            <div>Phone number</div>
            <div class="text-center">Actions</div>
        </div>
        @foreach (List<Auth0User> row in Rows)
        {
            <div class="row">
                @foreach (Auth0User item in row)
                {
                    <div style="padding: 1vh;">
                        <Card Class="px-2 mb-0" Style="background-color: #FFFFFF; border-radius: 10px; border: none;">
                            <CardBody Class="p-0 d-grid align-items-center"
                                      Style="grid-template-columns: 1fr 2fr 2fr auto; column-gap: 1rem;">
                                <CardText class="m-0">@item.username</CardText>
                                <CardText class="m-0">@item.email</CardText>
                                <CardText class="m-0">123456456789</CardText>
                                <div>
                                    <Button Class="p-0" Style="box-shadow: none; border: none;" @onclick="() => { this.showEditUser = true; selectedUserId = item.user_id; }"><Icon Name="IconName.Check2" Color="IconColor.Success" Style="font-size: 3.2vh;"></Icon></Button>
                                    <Button Class="p-0" Style="box-shadow: none; border: none;"><Icon Name="IconName.X" Color="IconColor.Danger" Style="font-size: 3.2vh;"></Icon></Button>
                                </div>
                            </CardBody>

                        </Card>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="text-center mt-4">No results found.</p>
    }
</div>

<Pagination Class="justify-content-center"
            Style="margin-top: 2vh"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
</Pagination>

@if (this.showEditUser)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Select the role to assign to this user</h5>
            <select @bind="this.role" class="form-select mb-3">
                <option value="Admin">Admin</option>
                <option value="Manager">Manager</option>
                <option value="Operator">Operator</option>
            </select>
            @if (this.role == "Operator")
            {
                <h5>Select the plantation sites to assign to this user</h5>
                <p>Plantation site 1</p>
                <select @bind="this.site1" class="form-select mb-3">
                    <option value=""></option>
                    @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                    {
                        <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site2)">@plantationSite.Name</option>
                    }
                </select>

                <p>Plantation site 2</p>
                <select @bind="this.site2" class="form-select mb-3">
                    <option value=""></option>
                    @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                    {
                        <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site1)">@plantationSite.Name</option>
                    }
                </select>
            }
            <div class="row gap-3">
                <div class="col">
                    <button @onclick="CancelEditUser" class="btn btn-warning">Cancel</button>
                </div>
                <div class="col">
                    <button @onclick="ApproveUser" class="btn btn-secondary">Confirm</button>
                </div>
            </div>
        </div>
    </div>
}

@if (this.showSuccessToast)
{
    <div class="toast-container position-fixed top-50 start-50 translate-middle-x mt-3" style="z-index: 1055;">
        <div class="toast show text-white bg-success shadow" style="opacity:@toastOpacity; transition: opacity 0.5s ease;">
            <div class="toast-body">
                ✅ User approved successfully!
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    private string? searchText = null;
    private bool showSearchWarning = false;
    PagedResponse<Auth0User>? response;
    private int currentPage = 1;
    private int cardsPerRow = 1;
    private int maxRows = 8;
    private int pageSize => cardsPerRow * maxRows;
    private int totalPages => response?.TotalPages ?? 1;
    private System.Timers.Timer? debounceTimer;
    HttpClient? client;
    private string errorMessage = "";

    private bool showEditUser;
    private IEnumerable<PlantationSiteDTO>? plantationSites;
    private int? site1;
    private int? site2;
    private string role = "";
    private string selectedUserId = "";
    private bool showSuccessToast = false;
    private double toastOpacity = 1.0;


    protected override async Task OnInitializedAsync()
    {
        client = HttpClientFactory.CreateClient("BTPApi");

        await LoadPage(1);
        await this.LoadPlantationSites();
    }

    private async Task LoadPage(int page)
    {
        currentPage = page;
        HttpClient client = HttpClientFactory.CreateClient("BTPApi");

        string url = $"UserManagement/pending?pageNr={page}&pageSize={pageSize}";
        if (!string.IsNullOrWhiteSpace(searchText) && searchText.Length >= 3)
            url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponse<Auth0User>>(url);
        StateHasChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApproveUser()
    {
        HttpClient client = HttpClientFactory.CreateClient("BTPApi");

        HttpResponseMessage responseMessage = await client.PostAsync($"UserManagement/{selectedUserId}/approve", null);

        if (responseMessage.IsSuccessStatusCode)
        {
            await Task.Delay(1000); // small delay to ensure auth0 has processed the change
            await LoadPage(currentPage);
            StateHasChanged();
            this.showEditUser = false;

            List<int> selectedSites = new List<int>();
            if (site1.HasValue)
                selectedSites.Add(site1.Value);
            if (site2.HasValue)
                selectedSites.Add(site2.Value);

            String json = JsonSerializer.Serialize(selectedSites);
            StringContent content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            await client.PostAsync($"UserManagement/{selectedUserId}/sites", content);

            CancelEditUser();

            await ShowSuccessToast();
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();
        showSearchWarning = !string.IsNullOrEmpty(searchText) && searchText.Length < 3;
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private IEnumerable<List<Auth0User>> Rows =>
        (response?.Items ?? Enumerable.Empty<Auth0User>())
            .Select((item, index) => new { item, index })
            .GroupBy(x => x.index / cardsPerRow)
            .Select(g => g.Select(x => x.item).ToList());

    private async Task LoadPlantationSites()
    {
        if (this.client == null) return;

        try
        {
            PagedResponse<PlantationSiteDTO>? response;

            response = await this.client.GetFromJsonAsync<PagedResponse<PlantationSiteDTO>>("PlantationSite");

            if (response != null)
            {
                this.plantationSites = response.Items;
                StateHasChanged();
            }
            else
            {
                this.errorMessage = "Something went wrong when loading in the plantation sites";
            }
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    private void CancelEditUser()
    {
        this.showEditUser = false;
        this.selectedUserId = "";
        this.site1 = null;
        this.site2 = null;
        this.role = "";
    }

    private bool IsDisabled(int id, int? otherSite) => otherSite.HasValue && id == otherSite.Value;

    private async Task ShowSuccessToast()
    {
        showSuccessToast = true;
        toastOpacity = 1.0;
        StateHasChanged();

        // Keep visible for 2.5 seconds
        await Task.Delay(2500);

        // Start fade out
        toastOpacity = 0.0;
        StateHasChanged();

        // Wait for fade transition to complete (0.5s)
        await Task.Delay(500);
        showSuccessToast = false;
        StateHasChanged();
    }
}
