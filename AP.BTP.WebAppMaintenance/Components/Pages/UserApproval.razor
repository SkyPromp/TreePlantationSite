@attribute [Authorize(Roles = "Admin")]
@page "/admin/users/approve"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using System.Drawing
@using System.Text.Json
@using System.Text.Encodings.Web
@using AP.BTP.Contracts.Enums
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Registratieaanvragen</PageTitle>

<h3 class="text-center">Registratieaanvragen goedkeuren</h3>

<div class="d-flex justify-content-between px-3">
    <a href="/admin/users" style="text-decoration: none;">
        <Button Class="d-flex align-items-center justify-content-center p-0 fs-4"
                Style=" box-shadow: none; border: none; text-decoration: none;">
            <Icon class="me-3" Name="IconName.ArrowLeft" Style="font-size: 2.5rem;"></Icon>
            Goedgekeurde gebruikers
        </Button>
    </a>
    <div class="d-flex flex-column align-items-end">
        <TextInput @bind-Value="@searchText"
                   @oninput="OnSearchChanged"
                   TextAlignment="Alignment.Start"
                   Placeholder="Zoek gebruikers"
                   Style="width: 15vw; border-width: 2px;" />
    </div>
</div>
<div class="container-fluid m-0 p-3" Style="background-color: #D9D9D9; border-radius: 15px;">
    @if (response?.Items == null || !response.Items.Any())
    {
        <p class="text-center mt-4">Er zijn momenteel geen gebruikers die een goedkeuring nodig hebben.</p>
    } else
    {
        <div class="d-grid p-1 fw-bold"
             style="grid-template-columns: 1fr 2fr 2fr auto; column-gap: 1rem; border-radius: 10px;">
            <div @onclick='() => OnSortChanged("FirstName")' style="cursor:pointer;">
                Naam @SortIndicator("FirstName")
            </div>
            <div @onclick='() => OnSortChanged("Email")' style="cursor:pointer;">
                E-mail @SortIndicator("Email")
            </div>
            <div @onclick='() => OnSortChanged("PhoneNumber")' style="cursor:pointer;">
                Gsm-number @SortIndicator("PhoneNumber")
            </div>
            <div class="text-center">Goedkeuring</div>
        </div>
        <div style="overflow-x:hidden; max-height: 55vh;">
            @foreach (List<UserDTO> row in Rows)
            {
                <div class="row">
                    @foreach (UserDTO item in row)
                    {
                        <div class="p-2">
                            <Card Class="px-2 mb-0" Style="background-color: #FFFFFF; border-radius: 10px; border: none;">
                                <CardBody Class="p-0 d-grid align-items-center"
                                          Style="grid-template-columns: 1fr 2fr 2fr auto; column-gap: 1rem;">
                                    <CardText class="m-0">@item.FirstName @item.LastName</CardText>
                                    <CardText class="m-0">
                                        <a href="mailto:@item.Email" style="text-decoration:none; color:#0d6efd;">
                                            @item.Email
                                        </a>
                                    </CardText>
                                    <CardText class="m-0">@item.PhoneNumber</CardText>
                                    <div class="p-1">
                                        <Button title="Gebruiker goedkeuren"
                                                Class="btn btn-success btn-sm"
                                                @onclick="() => { this.showEditUser = true; selectedUserId = item.Id; }">
                                            <Icon Name="IconName.Check2" />
                                        </Button>
                                        <Button title="Gebruiker afwijzen"
                                                Class="btn btn-danger btn-sm"
                                                @onclick="() => { this.showDeleteConfirmation = true; selectedUserId = item.Id; }">
                                            <Icon Name="IconName.X" />
                                        </Button>
                                    </div>
                                </CardBody>

                            </Card>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<Pagination Class="justify-content-center"
            Style="margin-top: 10px"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
</Pagination>

@if (this.showEditUser)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Selecteer de rol die aan deze gebruiker moet worden toegewezen</h5>
            <select @bind="this.selectedRole" class="form-select mb-3">
                @foreach (UserRole role in Enum.GetValues<UserRole>())
                {
                    <option value="@(role.ToString())">@role.ToString()</option>
                }
            </select>
            @if (selectedRole == UserRole.Operator.ToString())
            {
                <h5>Selecteer de kweeksites die aan deze gebruiker moeten worden toegewezen</h5>
                <p>Kweeksite 1</p>
                <select @bind="this.site1" class="form-select mb-3">
                    <option value=""></option>
                    @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                    {
                        <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site2)">@plantationSite.Name</option>
                    }
                </select>

                <p>Kweeksite 2</p>
                <select @bind="this.site2" class="form-select mb-3">
                    <option value=""></option>
                    @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                    {
                        <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site1)">@plantationSite.Name</option>
                    }
                </select>
            }
            @if (isLoading)
            {

                <div class="spinner-border align-self-center" role="status">
                    <span class="visually-hidden">Laden...</span>
                </div>
            } else
            {
                <div class="row gap-3">
                    <div class="col">
                        <button @onclick="CancelEditUser" class="btn btn-warning">Verlaten</button>
                    </div>
                    <div class="col">
                        <button @onclick="ApproveUser" class="btn btn-secondary" disabled="@string.IsNullOrEmpty(selectedRole)">Bevestigen</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

<Toasts Class="m-3" Messages="toastMessages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" ShowCloseButton="false" />

<ConfirmationPopup showConfirmationPopup="this.showDeleteConfirmation"
                   onCancellation="this.CancelEditUser"
                   onConfirmation="this.RejectUser"
                   confirmationDescription="Ben je zeker dat je deze gebruiker wil afwijzen?" />

@code {
    /// <summary>
    /// The current search text entered by the user.
    /// Used to filter pending users by name or email.
    /// </summary>
    private string? searchText = null;

    /// <summary>
    /// Holds the list of toast messages to display in the UI.
    /// </summary>
    private readonly List<ToastMessage> toastMessages = new List<ToastMessage>();

    /// <summary>
    /// The paginated response containing pending users retrieved from the backend.
    /// </summary>
    PagedResponseDTO<UserDTO>? response;  // TODO just use IEnumerable<...> not a respone

    /// <summary>
    /// The current page index of the user list being displayed.
    /// </summary>
    private int currentPage = 1;

    /// <summary>
    /// The number of cards (user entries) displayed per row.
    /// </summary>
    private int cardsPerRow = 1;

    /// <summary>
    /// The maximum number of rows of user cards displayed per page.
    /// </summary>
    private int maxRows = 7;

    /// <summary>
    /// The calculated number of user cards displayed per page.
    /// </summary>
    private int pageSize => cardsPerRow * maxRows;

    /// <summary>
    /// The total number of pages available based on the server response.
    /// </summary>
    private int totalPages => response?.TotalPages ?? 1;

    /// <summary>
    /// A timer used to debounce the search input, preventing excessive API calls.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// The HTTP client used for API communication. TODO: make optional and handle null cases.
    /// </summary>
    HttpClient client;  // TODO make optional and check if null

    /// <summary>
    /// Flag indicating whether the edit user modal or section is visible.
    /// </summary>
    private bool showEditUser;

    /// <summary>
    /// A collection of all plantation sites loaded from the API.
    /// Used to assign users to one or more sites.
    /// </summary>
    private IEnumerable<PlantationSiteDTO> plantationSites = new List<PlantationSiteDTO>();

    /// <summary>
    /// The first selected plantation site ID for the user being approved.
    /// </summary>
    private int? site1;

    /// <summary>
    /// The second selected plantation site ID for the user being approved.
    /// </summary>
    private int? site2;

    /// <summary>
    /// The selected role assigned to the user during approval.
    /// </summary>
    private string selectedRole = "";

    /// <summary>
    /// The selected user ID during approval.
    /// </summary>
    private int? selectedUserId;

    /// <summary>
    /// Indicates whether the component is performing a background operation (e.g., approving a user).
    /// </summary>
    private bool isLoading = false;

    /// <summary>
    /// Determines whether the delete confirmation dialog is currently displayed.
    /// </summary>
    private bool showDeleteConfirmation = false;

    /// <summary>
    /// Indicates the sorting direction
    /// </summary>
    private string sortDirection = "asc";

    /// <summary>
    /// Indicates what needs to be sorted
    /// </summary>
    private string sortBy = "FirstName";

    /// <summary>
    /// Called after the component is rendered for the first time.
    /// Initializes the HTTP client and loads required data such as users, sites, and roles.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            client = HttpClientFactory.CreateClient("BTPApi");

            await LoadPage(1);
            await LoadPlantationSites();
        }
    }

    /// <summary>
    /// Loads a specific page of pending users from the API.
    /// </summary>
    /// <param name="page">The page number to load.</param>
    private async Task LoadPage(int page)
    {
        currentPage = page;

        string url = $"user/pending?pageNr={page}&pageSize={pageSize}&sortBy={sortBy}&sortDirection={sortDirection}";
        if (!string.IsNullOrWhiteSpace(searchText))
            url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponseDTO<UserDTO>>(url);
        StateHasChanged();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Approves a selected pending user by assigning a role and optionally plantation sites.
    /// Sends requests to update the user in Auth0 and link them to plantation sites.
    /// </summary>
    private async Task ApproveUser()
    {
        isLoading = true;

        HttpResponseMessage responseMessage = await client.PostAsJsonAsync($"user/{selectedUserId}/approval", new ApproveUserDTO() { Role = selectedRole });

        if (!responseMessage.IsSuccessStatusCode)
        {
            EnqueueToast(message: "Er is iets misgegaan bij het goedkeuren van de gebruiker.", ToastType.Warning);
            isLoading = false;

            return;
        }

        await LoadPage(currentPage);
        StateHasChanged();

        List<int> selectedSites = new List<int>();
        if (site1.HasValue)
            selectedSites.Add(site1.Value);
        if (site2.HasValue)
            selectedSites.Add(site2.Value);

        UserDTO user = responseMessage.Content.ReadFromJsonAsync<UserDTO>().Result!;

        await client.PutAsJsonAsync($"user/{user.Id}/sites", new LinkUserToPlantationSitesDTO() { PlantationSiteIds = selectedSites });
        await CancelEditUser();
        this.EnqueueToast("Gebruiker is succesvol goedgekeurd!", ToastType.Success);

        isLoading = false;
    }

    /// <summary>
    /// Handles user input in the search box.
    /// Debounces input and triggers a filtered user search after a short delay.
    /// </summary>
    /// <param name="e">The change event containing the new search input value.</param>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Splits the list of users into rows for grid-based rendering in the UI.
    /// </summary>
    private IEnumerable<List<UserDTO>> Rows =>
    (response?.Items ?? Enumerable.Empty<UserDTO>())
        .Select((item, index) => new { item, index })
        .GroupBy(x => x.index / cardsPerRow)
        .Select(g => g.Select(x => x.item).ToList());

    /// <summary>
    /// Loads the list of available plantation sites from the API.
    /// </summary>
    private async Task LoadPlantationSites()
    {
        if (this.client == null)
            return;

        List<PlantationSiteDTO>? response;

        response = await this.client.GetFromJsonAsync<List<PlantationSiteDTO>>("PlantationSite/all");

        if (response != null)
        {
            this.plantationSites = response;
            StateHasChanged();
        } else
        {
            EnqueueToast(message: "Er is iets misgegaan bij het laden van de kweeksites.", ToastType.Warning);
        }
    }

    /// <summary>
    /// Cancels the current user edit or approval operation and resets form state.
    /// </summary>
    private Task CancelEditUser()
    {
        this.showEditUser = false;
        this.selectedUserId = null;
        this.site1 = null;
        this.site2 = null;
        this.selectedRole = "";
        this.showDeleteConfirmation = false;

        return Task.CompletedTask;
    }

    /// <summary>
    /// Disables a plantation site option if it has already been selected as another site for the same user.
    /// </summary>
    /// <param name="id">The ID of the plantation site.</param>
    /// <param name="otherSite">The ID of the other selected site.</param>
    /// <returns>True if the site should be disabled; otherwise, false.</returns>
    private bool IsDisabled(int id, int? otherSite) => otherSite.HasValue && id == otherSite.Value;

    /// <summary>
    /// Rejects a pending user by sending a deletion request.
    /// Refreshes the user list afterward.
    /// </summary>
    private async Task RejectUser()
    {
        isLoading = true;
        if (selectedUserId == null)
            return;

        try
        {
            HttpResponseMessage response = await client.DeleteAsync($"user/{selectedUserId}");

            if (response.IsSuccessStatusCode)
            {
                await LoadPage(currentPage);
                EnqueueToast(message: "De gebruiker is correct afgewezen geweest.", ToastType.Success);
                StateHasChanged();
            } else
            {
                EnqueueToast(message: $"Fout bij het afwijzen van gebruiker: {response.StatusCode}", ToastType.Warning);
            }
        } catch (InvalidOperationException e)
        {
            EnqueueToast(message: $"Fout bij het afwijzen van gebruiker: {e.Message}", ToastType.Warning);
        } catch (HttpRequestException e)
        {
            EnqueueToast(message: $"Fout bij het afwijzen van gebruiker: {e.Message}", ToastType.Warning);
        } catch (TaskCanceledException e)
        {
            EnqueueToast(message: $"Fout bij het afwijzen van gebruiker: {e.Message}", ToastType.Warning);
        }

        await CancelEditUser();
        isLoading = false;
    }

    /// <summary>
    /// Handles changes in the sorting direction.
    /// </summary>
    /// <param name="column">The column that needs to be sorted.</param>
    private void OnSortChanged(string column)
    {
        if (sortBy == column)
        {
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        } else
        {
            sortBy = column;
            sortDirection = "asc";
        }

        _ = LoadPage(1);
    }

    /// <summary>
    /// Handles the icon to display for the sorting direction.
    /// </summary>
    /// <param name="column">The column that needs to be sorted.</param>
    private string SortIndicator(string column)
    {
        if (sortBy != column)
            return "";
        return sortDirection == "asc" ? "↑" : "↓";
    }

    /// Adds a toast message to the toast container.
    /// </summary>
    /// <param name="message">The message to display.</param>
    /// <param name="type">The message type to display.</param>
    private void EnqueueToast(string message, ToastType type)
    {
        this.toastMessages.Add(new ToastMessage
        {
            Type = type,
            Title = type.ToString(),
            Message = message,
            AutoHide = true
        });
    }
}
