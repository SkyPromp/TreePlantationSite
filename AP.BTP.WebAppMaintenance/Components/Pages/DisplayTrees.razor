@attribute [Authorize(Roles = "Manager")]
@page "/manager/tree"
@using AP.BTP.Application.CQRS.Tree;
@using AP.BTP.Application.CQRS;
@using Microsoft.AspNetCore.Authorization
@using AP.BTP.Application.CQRS.Auth0User
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<div class="container">
    <div class="row mb-2">
        <div class="col-4">
            <div class="col-11 input-group">
                <input type="text" @bind="SearchStringBind" @oninput="(e) => SearchTrees(e.Value?.ToString() ?? String.Empty)" placeholder="Search" class="form-control border-0" />
                <button @onclick="RemoveSearchString" class="form-control border-0" style="flex: 0 0 auto; width: 3rem">X</button>
            </div>
        </div>
    </div>
    <div class="row row-cols-3 gap-4 mb-4">
        @foreach (TreeDTO tree in Trees ?? [])
        {
            <div class="col-3">
                <div class="card p-3">
                    <h2>@tree.Species</h2>
                    <div class="row align-items-center">
                        <div class="col-10">
                            <a href="@($"/manager/tree/{tree.Id}")" class="btn btn-secondary w-100">
                                Bekijk
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <Pagination Class="justify-content-center"
                Style="margin-top: 2vh"
                ActivePageNumber="@Page"
                TotalPages="@TotalPages"
                PageChanged="LoadTrees"
                FirstLinkIcon="IconName.ChevronDoubleLeft"
                PreviousLinkIcon="IconName.ChevronLeft"
                NextLinkIcon="IconName.ChevronRight"
                LastLinkIcon="IconName.ChevronDoubleRight">
    </Pagination>
</div>

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    /// <summary>
    /// Bound input string for searching trees. This value is two-way bound to the UI input.
    /// </summary>
    private string SearchStringBind = "";

    /// <summary>
    /// Internal search string used to filter tree results during API calls.
    /// </summary>
    private string SearchString = "";

    /// <summary>
    /// Collection of <see cref="TreeDTO"/> objects currently displayed in the component.
    /// </summary>
    private IEnumerable<TreeDTO> Trees;  // TODO read warning

    /// <summary>
    /// Stores any error message encountered during data retrieval or API calls.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// Number of tree items to display per page.
    /// </summary>
    private int PageSize = 6;

    /// <summary>
    /// Current page number for paginated tree data.
    /// </summary>
    private int Page = 1;

    /// <summary>
    /// Total number of pages available for the current search results.
    /// </summary>
    private int TotalPages = 1;

    /// <summary>
    /// HttpClient used to make API requests to the backend.
    /// </summary>
    private HttpClient? client;

    /// <summary>
    /// Executes after the component has rendered. On the first render, it initializes the <see cref="HttpClient"/> and loads the initial tree data.
    /// </summary>
    /// <param name="firstRender">Indicates if this is the first time the component has rendered.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        client = HttpClientFactory.CreateClient("BTPApi");
        await LoadTrees();
    }

    /// <summary>
    /// Loads a page of trees from the API, optionally specifying the page number.
    /// Updates the <see cref="Trees"/>, <see cref="Page"/>, <see cref="TotalPages"/>, and <see cref="errorMessage"/> properties.
    /// </summary>
    /// <param name="page">The page number to load. If -1, loads the current <see cref="Page"/>.</param>
    private async Task LoadTrees(int page = -1)
    {
        if (this.client == null) return;

        try
        {
            Paged<TreeDTO>? response;

            if (page == -1) page = this.Page;

            response = await this.client.GetFromJsonAsync<Paged<TreeDTO>>($"Tree?page={page}&pageSize={PageSize}&search={SearchString}");

            if (response != null)
            {
                this.errorMessage = "";
                this.Trees = response.Data;
                this.Page = page;
                this.TotalPages = response.PageCount;
                StateHasChanged();
            } else this.errorMessage = "No content found!";
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    /// <summary>
    /// Sets the search string and reloads the first page of trees matching the search.
    /// </summary>
    /// <param name="searchString">The search term entered by the user.</param>
    private async Task SearchTrees(string searchString)
    {
        this.SearchString = searchString;

        if (this.SearchString == null) return;

        this.Page = 1;
        await this.LoadTrees();
    }

    /// <summary>
    /// Clears the current search string and reloads all tree data.
    /// </summary>
    private async Task RemoveSearchString()
    {
        this.SearchString = "";
        this.SearchStringBind = "";

        await this.LoadTrees();
        StateHasChanged();
    }
}
