@attribute [Authorize(Roles = "Manager")]
@page "/manager/tree"
@using AP.BTP.Application.CQRS.Tree;
@using AP.BTP.Application.CQRS;
@using Microsoft.AspNetCore.Authorization
@using AP.BTP.Application.CQRS.Auth0User
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<div class="container">
    <div class="row mb-2">
        <div class="col-4">
            <div class="card rounded-4">
                <div class="container">
                    <div class="row">
                        <div class="col-11">
                            <input type="text" @oninput="(e) => SearchTrees(e.Value?.ToString())" placeholder="Search" class="form-control border-0"/>
                        </div>
                        <div class="col-1 d-flex justify-content-center">
                            <p @onclick="RemoveSearchString" class="my-1">X</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row row-cols-3 gap-4 mb-4">
        @foreach (TreeDTO tree in Trees ?? [])
        {
            <div class="col-3">
                <div class="card p-3">
                    <h2>@tree.Species</h2>
                    <div class="row align-items-center">
                        <div class="col-10">
                            <a href="@($"/manager/tree/{tree.Id}")" class="btn btn-secondary w-100">
                                Bekijk
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <Pagination Class="justify-content-center"
                Style="margin-top: 2vh"
                ActivePageNumber="@Page"
                TotalPages="@TotalPages"
                PageChanged="LoadTrees"
                FirstLinkIcon="IconName.ChevronDoubleLeft"
                PreviousLinkIcon="IconName.ChevronLeft"
                NextLinkIcon="IconName.ChevronRight"
                LastLinkIcon="IconName.ChevronDoubleRight">
    </Pagination>
</div>

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    private string SearchString = "";
    private IEnumerable<TreeDTO> Trees;
    private string errorMessage = "";
    private int PageSize = 6;
    private int Page = 1;
    private int TotalPages = 1;
    private int selectedTreeId;
    private bool showConfirm;
    private bool ShowConfirm {
        get { return this.showConfirm; }
        set {
            this.IsConfirm = false;
            this.showConfirm = value;
        }
    }
    private bool isConfirm;
    private bool IsConfirm
    {
        get { return this.isConfirm; }
        set {
            this.isConfirm = value;
            this.showConfirm = false;
            if (value) this.DeleteTree(selectedTreeId);
        }
    }
    private HttpClient? client;

    protected override async Task OnInitializedAsync()
    {
        client = HttpClientFactory.CreateClient("BTPApi");
        await LoadTrees();
    }

    private async Task LoadTrees()
    {
        Console.WriteLine(1);
        if (this.client == null) return;
        Console.WriteLine(2);

        try
        {
            Paged<TreeDTO>? response;

            response = await this.client.GetFromJsonAsync<Paged<TreeDTO>>($"Tree?page={Page}&pageSize={PageSize}&search={SearchString}");
            Console.WriteLine(3);
            Console.WriteLine(this.SearchString);

            if (response != null)
            {
                Console.WriteLine(4);
                this.errorMessage = "";
                this.Trees = response.Data;
                foreach (TreeDTO tree in response.Data) Console.WriteLine(tree.Species);
                Console.WriteLine(5);
                this.TotalPages = response.PageCount;
                Console.WriteLine(6);
            } else
                this.errorMessage = "No content found!";
            Console.WriteLine(7);
        } catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    private async Task SearchTrees(string searchString)
    {
        this.SearchString = searchString;
        Console.WriteLine(this.SearchString);
        if (this.SearchString != null) await this.LoadTrees();
        Console.WriteLine("Done");
        StateHasChanged();
    }

    private void ConfirmDeleteTree(int id)
    {
        this.selectedTreeId = id;
        this.showConfirm = true;
    }

    private async void DeleteTree(int id)
    {
        HttpResponseMessage? response;

        if (this.client != null)
        {
            response = await this.client.DeleteAsync($"Tree?id={id}");

            if (!response.IsSuccessStatusCode)
            {
                this.errorMessage = $"The deletion of id={id} has been unsuccessfull";
            } else
            {
                this.errorMessage = $"{id} has been sucessfully deleted";
            }
        }

        await this.LoadTrees();
        StateHasChanged();
    }

    private void RemoveSearchString()
    {
        this.SearchString = "";
    }
}
