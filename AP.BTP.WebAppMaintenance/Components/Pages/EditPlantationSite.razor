@page "/plantation-site/edit"
@page "/plantation-site/edit/{id:int}"
@rendermode InteractiveServer
@using AP.BTP.Application.CQRS.PlantationSite
@using BlazorBootstrap
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<Tabs EnableFadeEffect="true" Style="margin-top: 3vh">
    <Tab Title="Site details">
        <Content>
            <EditForm Model="plantationSite" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <div class="form-content">
                    <div class="row">
                        <div class="col-4">
                                <div>
                                    <label class="form-label">Name</label>
                                    <TextInput @bind-Value="@plantationSite.Name"></TextInput>
                                    <ValidationMessage For="@(() => plantationSite.Name)" />
                                </div>

                                <div class="d-flex justify-content-between">
                                    <div style="width: 45%">
                                        <label class="form-label">Street</label>
                                        <TextInput @bind-Value="@plantationSite.Street"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.Street)" />
                                    </div>

                                    <div style="width: 45%">
                                        <label class="form-label">House number</label>
                                        <TextInput @bind-Value="@plantationSite.HouseNumber"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.HouseNumber)" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <div style="width: 45%">
                                        <label class="form-label">City</label>
                                        <TextInput @bind-Value="@plantationSite.City"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.City)" />
                                    </div>
                                    <div style="width: 45%">
                                        <label class="form-label">Postal code</label>
                                        <NumberInput TValue="int" @bind-Value="@plantationSite.PostalCode"></NumberInput>
                                        <ValidationMessage For="@(() => plantationSite.PostalCode)" />   
                                    </div>
                                </div>

                                <div>
                                    <label class="form-label">Country</label>
                                    <TextInput @bind-Value="@plantationSite.Country"></TextInput>
                                    <ValidationMessage For="@(() => plantationSite.Country)" />  
                                </div> 

                                <div>
                                    <label class="form-label">Size</label>
                                    <div id="size-input" class="d-flex justify-content-between">
                                        <NumberInput TValue="double" @bind-Value="@plantationSite.Size" Style="width: 85%"></NumberInput>
                                        <p style="font-size: 1.5rem; font-weight: 500; color: #5f5f5f">m²</p>
                                    </div>
                                    <ValidationMessage For="@(() => plantationSite.Size)" />
                                </div>

                                <div>
                                    <label class="form-label">GroundPlan</label>
                                    <InputFile OnChange="HandleGroundPlanUpload" class="form-control mb-2" />
                                    <ValidationMessage For="@(() => plantationSite.GroundPlan)" />
                                </div>
                        </div>
                        <div class="col-8 d-flex justify-content-center align-items-center">
                            @if (!string.IsNullOrEmpty(groundPlanPreview))
                            {
                                <img src="@groundPlanPreview" alt="GroundPlan Preview" style="max-width:100%; max-height:50vh; border:1px solid #ccc;"/>
                            }
                            else
                            {
                                <p class="text-muted">No groundPlan uploaded yet.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" @onclick="Cancel">Cancel</Button>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Submit">Save</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
    <Tab Title="Zones">
        <Content>
            <div class="form-content">
                This is the placeholder content for the <b>Zones</b> tab.
            </div>
        </Content>
    </Tab>
</Tabs>

@code {
    [Parameter] public int id { get; set; }

    PlantationSiteDTO plantationSite = new PlantationSiteDTO()
    {
        Id = 0,
        Name = "",
        Street = "",
        HouseNumber = "",
        City = "",
        Country = "",
        PostalCode = 0,
        Size = 0.0,
        GroundPlan = "",
        IsDeleted = false
    };

    string groundPlanPreview = string.Empty;

    private async Task HandleValidSubmit(){
        try {
            HttpClient client = HttpClientFactory.CreateClient("BTPApi");

            HttpResponseMessage response;

            if (id == 0)
                response = await client.PostAsJsonAsync("PlantationSite", plantationSite);
            else
                response = await client.PutAsJsonAsync($"PlantationSite/{id}", plantationSite); // TODO implement update

            if (response.IsSuccessStatusCode)
            {
                // TODO add snackbar confirmation
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                // TODO add snackbar error
            }
        }
        catch (Exception ex)
        {
            // TODO add snackbar exception
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/plantation-site");
    }    

    private async Task HandleGroundPlanUpload(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;

        using MemoryStream stream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(stream);

        string base64 = Convert.ToBase64String(stream.ToArray());
        groundPlanPreview = $"data:{file.ContentType};base64,{base64}";        
    
        plantationSite.GroundPlan = $"uploads/{file.Name}"; 
    }
}