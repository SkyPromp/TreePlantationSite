@attribute [Authorize(Roles = "Admin")]
@page "/admin/plantation-site/edit"
@page "/admin/plantation-site/edit/{id:int}"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Headers
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<Tabs EnableFadeEffect="true" Style="margin-top: 3vh">
    <Tab Title="Site details">
        <Content>
            <EditForm Model="plantationSite" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <div class="form-content">
                    <div class="row">
                        <div class="col-4">
                                <div>
                                    <label class="form-label">Name</label>
                                    <TextInput @bind-Value="@plantationSite.Name"></TextInput>
                                    <ValidationMessage For="@(() => plantationSite.Name)" />
                                </div>

                                <div class="d-flex justify-content-between">
                                    <div style="width: 45%">
                                        <label class="form-label">Street</label>
                                        <TextInput @bind-Value="@plantationSite.Street"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.Street)" />
                                    </div>

                                    <div style="width: 45%">
                                        <label class="form-label">House number</label>
                                        <TextInput @bind-Value="@plantationSite.HouseNumber"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.HouseNumber)" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <div style="width: 45%">
                                        <label class="form-label">City</label>
                                        <TextInput @bind-Value="@plantationSite.City"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.City)" />
                                    </div>
                                    <div style="width: 45%">
                                        <label class="form-label">Postal code</label>
                                        <NumberInput TValue="int" Min="1000" Max="9999" @bind-Value="@plantationSite.PostalCode"></NumberInput>
                                        <ValidationMessage For="@(() => plantationSite.PostalCode)" />   
                                    </div>
                                </div>

                                <div>
                                    <label class="form-label">Country</label>
                                    <TextInput @bind-Value="@plantationSite.Country"></TextInput>
                                    <ValidationMessage For="@(() => plantationSite.Country)" />  
                                </div> 

                                <div>
                                    <label class="form-label">Size</label>
                                    <div id="size-input" class="d-flex justify-content-between">
                                        <NumberInput TValue="double" @bind-Value="@plantationSite.Size" Style="width: 85%"></NumberInput>
                                        <p style="font-size: 1.5rem; font-weight: 500; color: #5f5f5f">m²</p>
                                    </div>
                                    <ValidationMessage For="@(() => plantationSite.Size)" />
                                </div>

                                <div>
                                    <label class="form-label">GroundPlan</label>
                                    <InputFile OnChange="HandleGroundPlanUpload" class="form-control mb-2" />
                                    <ValidationMessage For="@(() => plantationSite.GroundPlan)" />
                                </div>
                        </div>
                        <div class="col-8 d-flex justify-content-center align-items-center">
                            @if (!string.IsNullOrEmpty(groundPlanPreview))
                            {
                                <img src="@groundPlanPreview" alt="GroundPlan Preview" style="max-width:100%; max-height:50vh; border:1px solid #ccc;"/>
                            }
                            else
                            {
                                <p class="text-muted">No groundPlan uploaded yet.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" @onclick="Cancel">Cancel</Button>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Submit">Save</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
    <Tab Title="Zones">
        <Content>
            <div class="form-content">
                <div class="container">
                    <div class="row d-flex justify-content-end">
                        <div class="col-auto">
                            <button @onclick="() => this.ShowTreeList=true" class="btn btn-secondary">+ Add new</button>
                        </div>
                    </div>
                </div>
                <table class="table">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">Zone name</th>
                            <th scope="col">Area</th>
                            <th scope="col">Tree type</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ZoneDTO zone in plantationSite?.Zones ?? [])
                        {
                            <tr>
                                <td>@((this.OldZone != null && zone.Id == this.OldZone.Id)? this.OldZone.Name: zone.Name)</td>
                                <td>@((this.OldZone != null && zone.Id == this.OldZone.Id)? this.OldZone.Size: zone.Size)</td>
                                <td>@(this.findTree((this.OldZone != null && zone.Id == this.OldZone.Id)? this.OldZone.TreeId: zone.TreeId)?.Species ?? "No species name was found")</td>
                                <td>
                                    <i @onclick="() => EditZone(zone.Id)" class="bi bi-pencil-square"></i>
                                    <i @onclick="() => ConfirmDeleteZone(zone.Id)" class="bi bi-trash"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Content>
    </Tab>
</Tabs>

@if (this.ShowTreeList)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center">
        <div class="card position-absolute align-self-center p-4">
            <h5>Give a zone name</h5>
            <input type="text" @bind="this.SelectedZone.Name" />

            <h5>Specify the zone area (in m^2)</h5>
            <input type="number" @bind="this.SelectedZone.Size" />

            <h5>Select tree species</h5>
            <p>Which tree species would you like to assign to this zone?</p>
            <TextInput @bind-Value="@searchTreeText" @oninput="OnSearchChanged" TextAlignment="Alignment.Start" Placeholder="Search..." Style="width: 25vw; height: 5vh"/>
            <select @bind="this.SelectedZone.TreeId" size ="3" class="form-select mb-3">
                @foreach(TreeDTO tree in this.Trees ?? [])
                {
                    <option value="@tree.Id">@tree.Species</option>
                }
            </select>
            <div class="row gap-3">
                <div class="col">
                    <button @onclick="() => this.IsZoneAdded = false" class="btn btn-warning">Cancel</button>
                </div>
                <div class="col">
                    <button @onclick="() => this.IsZoneAdded = true" class="btn btn-secondary">Confirm</button>
                </div>
            </div>
        </div>
    </div>
}

@if (this.ShowConfirmZoneDeletion)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center">
        <div class="card position-absolute align-self-center p-4">
            <h1>Confirm</h1>
            <p>Wenst u om te bevestigen?</p>
            <div class="row gap-3">
                <div class="col">
                    <button @onclick="() => this.IsZoneRemoved = false" class="btn btn-warning">Annuleer</button>
                </div>
                <div class="col">
                    <button @onclick="() => this.IsZoneRemoved = true" class="btn btn-secondary">Bevestig</button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    /// <summary>
    /// The ID of the plantation site to load. This is a component parameter.
    /// </summary>
    [Parameter] public int id { get; set; }

    /// <summary>
    /// The ID of the plantation site to load. This is a component parameter.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// The allowed filetypes of the plantation site's groundplan. This is a readonly component parameter.
    /// </summary>
    readonly string[] allowedGroundplanFileTypes = {
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/bmp"
    };

    /// <summary>
    /// The ID of the plantation site to load. This is a component parameter.
    /// </summary>
    PlantationSiteDTO? plantationSite = new PlantationSiteDTO()
    {
        Id = 0,
        Name = "",
        Street = "",
        HouseNumber = "",
        City = "",
        Country = "",
        PostalCode = 0,
        Size = 0.0,
        GroundPlan = "",
        Zones = new List<ZoneDTO>()
    };

    /// <summary>
    /// Current search text entered by the user for filtering trees.
    /// </summary>
    private string? searchTreeText = null;

    /// <summary>
    /// Base64 representation of the ground plan image for preview.
    /// </summary>
    string groundPlanPreview = string.Empty;

    private bool showTreeList;
    private bool ShowTreeList {
        get { return this.showTreeList; }
        set {
            this.IsZoneAdded = false;
            this.showTreeList = value;
        }
    }
    private bool isZoneAdded;  // TODO rewrite
    private bool IsZoneAdded
    {
        get { return this.isZoneAdded; }
        set {
            this.isZoneAdded = value;
            this.showTreeList = false;
            if (value)
            {
                this.AddZone();
                this.SelectedZone = EmptyZone;
            } else if (this.OldZone != null)
            {
                this.SelectedZone = this.OldZone;
                this.OldZone = null;
            }
        }
    }

    private bool showConfirmZoneDeletion;  // TODO rewrite
    private bool ShowConfirmZoneDeletion {
        get { return this.showConfirmZoneDeletion; }
        set {
            this.IsZoneRemoved = false;
            this.showConfirmZoneDeletion = value;
        }
    }
    private bool isZoneRemoved;
    private bool IsZoneRemoved
    {
        get { return this.isZoneRemoved; }
        set {
            this.isZoneRemoved = value;
            this.showConfirmZoneDeletion = false;
            if(value) this.DeleteZone(this.SelectedZone.Id);
        }
    }

    /// <summary>
    /// Returns a new, empty zone DTO associated with the current plantation site.
    /// </summary>
    private ZoneDTO EmptyZone {
        get
        {
            return new ZoneDTO()
            {
                Id = 0,
                PlantationSiteId = this.plantationSite?.Id ?? 0,
                TreeId = 0
            };
        }
    }

    /// <summary>
    /// Temporary index used for newly added zones before they are saved to the backend.
    /// </summary>
    private int tempAddedZoneIndex = -1;

    /// <summary>
    /// Timer used to debounce the search input to avoid making too many API calls while typing.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// Currently selected zone for editing or addition.
    /// </summary>
    private ZoneDTO SelectedZone;  // TODO read warning

    /// <summary>
    /// Flag to track if the current operation is editing an existing zone.
    /// </summary>
    private bool IsEditZone;  // TODO not needed, can be derrived from the index

    /// <summary>
    /// Holds the original zone before editing for restoration if editing is cancelled.
    /// </summary>
    private ZoneDTO? OldZone;

    /// <summary>
    /// List of available trees for assignment to zones.
    /// </summary>
    private IEnumerable<TreeDTO>? Trees;

    /// <summary>
    /// HttpClient instance for API calls.
    /// </summary>
    HttpClient? client;

    /// <summary>
    /// Initializes the component, loads plantation site data if editing, loads trees and zones.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        client = HttpClientFactory.CreateClient("BTPApi");
        this.SelectedZone = EmptyZone;

        if (this.id != 0) {
            try {
                this.plantationSite = await this.client.GetFromJsonAsync<PlantationSiteDTO>($"PlantationSite/{this.id}");

                if (!string.IsNullOrEmpty(this.plantationSite?.GroundPlan))
                {
                    await this.LoadImagePreview(client, this.plantationSite.GroundPlan);
                }
            } catch (Exception ex) {
                // TODO implement snackbar
            }
        }

        await this.LoadTrees();
        await this.LoadZones();
    }

    /// <summary>
    /// Loads zones for the current plantation site from the backend API.
    /// </summary>
    private async Task LoadZones()
    {
        if (this.plantationSite == null || this.plantationSite.Id == 0) return;

        if (this.client == null) return;

        try
        {
            ICollection<ZoneDTO>? response;

            response = await this.client.GetFromJsonAsync<ICollection<ZoneDTO>>($"Zone?plantationSiteId={this.plantationSite.Id}");

            if (response != null)
            {
                this.plantationSite.Zones = response;
                StateHasChanged();
            } else
            {
                this.errorMessage = "Something went wrong when loading in the zones";
            }
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    /// <summary>
    /// Loads all trees from the backend API.
    /// </summary>
    private async Task LoadTrees()
    {
        if (this.client == null) return;

        try
        {
            IEnumerable<TreeDTO>? response;

            response = await this.client.GetFromJsonAsync<IEnumerable<TreeDTO>>("Tree/all" + (this.searchTreeText != null? $"?search={this.searchTreeText}": ""));

            if (response != null)
            {
                this.Trees = response;
                StateHasChanged();
            } else
            {
                this.errorMessage = "Something went wrong when loading in the trees";
            }
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    /// <summary>
    /// Handles changes in the search input field. Debounces the search by 300ms before reloading the first page.
    /// </summary>
    /// <param name="e">The change event containing the new search text.</param>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        this.searchTreeText = e.Value?.ToString()?.Trim();

        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadTrees();
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Handles form submission for creating or updating a plantation site and its zones.
    /// </summary>
    private async Task HandleValidSubmit(){
        try {
            if (this.client == null || this.plantationSite == null) return;

            HttpResponseMessage response;

            foreach (ZoneDTO zone in this.plantationSite.Zones ?? [])
            {
                if (zone.Id < 0) zone.Id = 0;
                if (zone.PlantationSiteId == 0) zone.PlantationSiteId = this.plantationSite.Id;
            }

            if (id == 0) response = await this.client.PostAsJsonAsync("PlantationSite", plantationSite);
            else response = await this.client.PutAsJsonAsync($"PlantationSite/{id}", plantationSite); // TODO implement update

            if (response.IsSuccessStatusCode)
            {
                // TODO add snackbar confirmation
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                // TODO add snackbar error
            }
        }
        catch (Exception ex)
        {
            // TODO add snackbar exception
        }
    }

    /// <summary>
    /// Cancels the editing/creation and navigates back to the plantation site list.
    /// </summary>
    private void Cancel()
    {
        Navigation.NavigateTo("/admin/plantation-site");
    }

    /// <summary>
    /// Uploads a ground plan file for the plantation site and generates a preview.
    /// </summary>
    /// <param name="e">The file change event containing the uploaded file.</param>
    private async Task HandleGroundPlanUpload(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;

        if (this.client == null)
        {
            this.errorMessage = "The http client was not instantiated!";

            return;
        }

        if (!this.allowedGroundplanFileTypes.Contains(file.ContentType))
        {
            this.errorMessage = "This filetype is not permitted!";

            return;
        }

        using MultipartFormDataContent content = new MultipartFormDataContent();
        using Stream stream = file.OpenReadStream();

        StreamContent fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

        content.Add(fileContent, "file", file.Name);

        HttpResponseMessage response = await this.client.PostAsync("File/upload", content);

        if (response.IsSuccessStatusCode)
        {
            JsonElement json = await response.Content.ReadFromJsonAsync<JsonElement>();
            string? fileName = json.GetProperty("fileName").GetString();

            if (!string.IsNullOrEmpty(fileName))
            {
                plantationSite!.GroundPlan = fileName;
                await LoadImagePreview(client, plantationSite.GroundPlan);
            }
        }
        else
        {
            string error = await response.Content.ReadAsStringAsync();
            // TODO implement snackbar
        }
    }

    /// <summary>
    /// Finds a tree by its ID.
    /// </summary>
    /// <param name="id">Tree ID.</param>
    /// <returns>The tree DTO or null if not found.</returns>
    private TreeDTO? findTree(int? id)
    {
        return id == null? null : this.Trees?.Where(tree => tree.Id == id).FirstOrDefault() ?? null;
    }

    /// <summary>
    /// Finds a zone by its ID within the current plantation site.
    /// </summary>
    /// <param name="id">Zone ID.</param>
    /// <returns>The zone DTO or null if not found.</returns>
    private ZoneDTO? findZone(int? id)
    {
        if (this.plantationSite == null) return null;

        return id == null? null : this.plantationSite.Zones?.Where(tree => tree.Id == id).FirstOrDefault() ?? null;
    }

    /// <summary>
    /// Adds the currently selected zone to the plantation site, or updates it if editing.
    /// </summary>
    private void AddZone()
    {
        if (this.SelectedZone == null) this.SelectedZone = EmptyZone;
        if (this.plantationSite == null) return;
        if (this.plantationSite.Zones == null) this.plantationSite.Zones = new List<ZoneDTO>();
        if (this.SelectedZone.TreeId == 0 || this.plantationSite == null) return;
        if (!this.IsEditZone)
        {
            this.SelectedZone.Id = this.tempAddedZoneIndex--;
            this.plantationSite.Zones.Add(this.SelectedZone);
        }

        this.OldZone = null;
        this.IsEditZone = false;
    }

    /// <summary>
    /// Begins editing the zone with the specified ID.
    /// </summary>
    /// <param name="id">Zone ID.</param>
    private void EditZone(int id)
    {
        this.IsEditZone = true;
        this.ShowTreeList = true;

        ZoneDTO? zone = findZone(id);

        if (zone == null) return;

        this.SelectedZone = zone;
        this.OldZone = this.SelectedZone.CloneZone();
        this.SelectedZone.TreeId = zone.TreeId;
    }

    /// <summary>
    /// Confirms deletion of a zone by ID.
    /// </summary>
    /// <param name="id">Zone ID.</param>
    private void ConfirmDeleteZone(int id)
    {
        this.SelectedZone.Id = id;
        this.ShowConfirmZoneDeletion = true;
    }

    /// <summary>
    /// Deletes a zone by ID, either from the backend or the local list if it hasn't been saved yet.
    /// </summary>
    /// <param name="id">Zone ID.</param>
    private async void DeleteZone(int id)
    {
        if (this.plantationSite == null || this.plantationSite.Zones == null) return;

        // If the plantationSite id is 0, this means the the zone hasn't been sent to the backend yet, so it can just be removed from the frontend.
        if(this.plantationSite.Id == 0)
        {
            this.plantationSite.Zones = this.plantationSite.Zones.Where(zone => zone.Id != id).ToList();

            return;
        }

        HttpResponseMessage? response;

        if (this.client != null)
        {
            response = await this.client.DeleteAsync($"Zone?id={id}");

            if (!response.IsSuccessStatusCode)
            {
                this.errorMessage = $"The deletion of id={id} has been unsuccessfull";
            } else
            {
                this.errorMessage = $"{id} has been sucessfully deleted";
                this.plantationSite.Zones = this.plantationSite.Zones.Where(zone => zone.Id != id).ToList();
            }
        }

        await this.LoadTrees();
        this.SelectedZone = EmptyZone;
        StateHasChanged();
    }

    /// <summary>
    /// Loads a ground plan image from the backend and generates a base64 preview string.
    /// </summary>
    /// <param name="client">The HTTP client for fetching the image.</param>
    /// <param name="fileName">The filename of the ground plan image.</param>
    private async Task LoadImagePreview(HttpClient client, string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return;

        try
        {
            HttpResponseMessage response = await client.GetAsync($"File/{fileName}");
            response.EnsureSuccessStatusCode();

            byte[] imageBytes = await response.Content.ReadAsByteArrayAsync();

            string contentType = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";

            string base64Image = Convert.ToBase64String(imageBytes);
            groundPlanPreview = $"data:{contentType};base64,{base64Image}";
        }
        catch
        {
            groundPlanPreview = string.Empty;
        }
    }
}