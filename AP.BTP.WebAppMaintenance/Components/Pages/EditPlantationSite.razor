@attribute [Authorize(Roles = "Admin")]
@page "/admin/plantation-site/edit"
@page "/admin/plantation-site/edit/{id:int}"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Headers
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<Tabs EnableFadeEffect="true" Style="margin-top: 3vh">
    <Tab Title="Site details">
        <Content>
            <EditForm Model="plantationSite" OnValidSubmit="() => this.showConfirmSaveForm = true">
                <DataAnnotationsValidator />
                <div class="form-content">
                    <div class="row">
                        <div class="col-4">
                                <div>
                                    <label class="form-label">Naam</label>
                                    <TextInput @bind-Value="@plantationSite.Name"></TextInput>
                                    <ValidationMessage For="@(() => plantationSite.Name)" />
                                </div>

                                <div class="d-flex justify-content-between">
                                    <div style="width: 45%">
                                        <label class="form-label">Straat</label>
                                        <TextInput @bind-Value="@plantationSite.Street"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.Street)" />
                                    </div>

                                    <div style="width: 45%">
                                        <label class="form-label">Huisnummer</label>
                                        <TextInput @bind-Value="@plantationSite.HouseNumber"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.HouseNumber)" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <div style="width: 45%">
                                        <label class="form-label">Stad</label>
                                        <TextInput @bind-Value="@plantationSite.City"></TextInput>
                                        <ValidationMessage For="@(() => plantationSite.City)" />
                                    </div>
                                    <div style="width: 45%">
                                        <label class="form-label">Postcode</label>
                                        <NumberInput TValue="int" Min="1000" Max="9999" @bind-Value="@plantationSite.PostalCode"></NumberInput>
                                        <ValidationMessage For="@(() => plantationSite.PostalCode)" />   
                                    </div>
                                </div>

                                <div>
                                    <label class="form-label">Land</label>
                                    <TextInput @bind-Value="@plantationSite.Country"></TextInput>
                                    <ValidationMessage For="@(() => plantationSite.Country)" />  
                                </div> 

                                <div>
                                    <label class="form-label">Grootte</label>
                                    <div id="size-input" class="d-flex justify-content-between">
                                        <NumberInput TValue="double" @bind-Value="@plantationSite.Size" Style="width: 85%"></NumberInput>
                                        <p style="font-size: 1.5rem; font-weight: 500; color: #5f5f5f">m²</p>
                                    </div>
                                    <ValidationMessage For="@(() => plantationSite.Size)" />
                                </div>

                                <div>
                                    <label class="form-label">Plattegrond</label>
                                    <InputFile OnChange="HandleGroundPlanUpload" class="form-control mb-2" />
                                    <ValidationMessage For="@(() => plantationSite.GroundPlan)" />
                                </div>
                        </div>
                        <div class="col-8 d-flex justify-content-center align-items-center">
                            @if (!string.IsNullOrEmpty(groundPlanPreview))
                            {
                                <img src="@groundPlanPreview" alt="GroundPlan Preview" style="max-width:100%; max-height:50vh; border:1px solid #ccc;"/>
                            }
                            else
                            {
                                <p class="text-muted">Er is nog geen plattegrond geüpload.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" @onclick="Cancel">Verlaten</Button>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" Type="ButtonType.Submit">Bewaren</Button>
                </div>
            </EditForm>
        </Content>
    </Tab>
    <Tab Title="Zones">
        <Content>
            <div class="form-content">
                <div class="container">
                    <div class="row d-flex justify-content-end">
                        <div class="col-auto">
                            <button @onclick="OpenZoneCreation" class="btn btn-secondary">+ Toevoegen</button>
                        </div>
                    </div>
                </div>
                <table class="table">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">Naam</th>
                            <th scope="col">Oppervlakte</th>
                            <th scope="col">Boomsoort</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ZoneDTO zone in plantationSite?.Zones ?? [])
                        {
                            <tr>
                                <td>@zone.Name?.Trim()</td>
                                <td>@zone.Size</td>
                                <td>@(this.findTree(zone.TreeId)?.Species ?? "Er werd geen soortnaam gevonden.")</td>
                                <td>
                                    <i @onclick="() => OpenEditZone(zone)" class="bi bi-pencil-square"></i>
                                    <i @onclick="() => ConfirmDeleteZone(zone.Id)" class="bi bi-trash"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
                <div class="buttons d-flex justify-content-end mt-4">
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #929393; color: white; margin-right: 1vw; width: 6vw; box-shadow: none; height: 5vh;" @onclick="Cancel">Verlaten</Button>
                    <Button Class="d-flex align-items-center justify-content-center" Style="background-color: #4EB862; color: white; width: 6vw; box-shadow: none; height: 5vh;" @onclick="() => this.showConfirmSaveForm = true">Bewaren</Button>
                </div>
        </Content>
    </Tab>
</Tabs>

<Toasts Class="m-3" @ref="toastContainer" Messages="toastMessages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" ShowCloseButton="false"/>

<ConfirmationPopup 
    showConfirmationPopup="this.showConfirmSaveForm"
    onConfirmation="this.HandleValidSubmit"
/>

<ConfirmationPopup 
    showConfirmationPopup="this.showConfirmZoneDeletion && this.SelectedZoneId != 0"
    onCancellation="this.CancelZoneDeletion"
    onConfirmation="() => this.DeleteZone(this.SelectedZoneId)"
/>

@if (this.showZoneCreation && this.newZone != null)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center">
        <div class="card position-absolute align-self-center p-4">
            <h5>Zone naam</h5>
            <input type="text" @bind="this.newZone.Name" />

            <h5>Oppervlakte</h5>
            <input type="number" @bind="this.newZone.Size" min="0" step="1" max="@((this.plantationSite?.Size ?? 0) - (this.plantationSite?.Zones?.Sum(zone => zone.Size) ?? 0))" />

            <h5>Boomsoort</h5>
            <p>Welke boomsoort wilt u aan deze zone toewijzen?</p>
            <TextInput @bind-Value="@searchTreeText" @oninput="OnSearchChanged" TextAlignment="Alignment.Start" Placeholder="Zoeken..." Style="width: 25vw; height: 5vh"/>
            <select @bind="this.newZone.TreeId" size ="3" class="form-select mb-3">
                @foreach(TreeDTO tree in this.Trees ?? [])
                {
                    <option value="@tree.Id">@tree.Species</option>
                }
            </select>
            <div class="row gap-3">
                <div class="col">
                    <button @onclick="this.CancelZoneCreation" class="btn btn-warning">Verlaten</button>
                </div>
                <div class="col">
                    <button @onclick="this.CreateZone" class="btn btn-secondary">Bewaren</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// The ID of the plantation site to load. This is a component parameter.
    /// </summary>
    [Parameter] public int id { get; set; }

    /// <summary>
    /// The allowed filetypes of the plantation site's groundplan. This is a readonly component parameter.
    /// </summary>
    readonly string[] allowedGroundplanFileTypes = {
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/bmp"
    };

    /// <summary>
    /// The ID of the plantation site to load. This is a component parameter.
    /// </summary>
    PlantationSiteDTO? plantationSite = new PlantationSiteDTO()
    {
        Id = 0,
        Name = "",
        Street = "",
        HouseNumber = "",
        City = "",
        Country = "",
        PostalCode = 0,
        Size = 0.0,
        GroundPlan = "",
        Zones = new List<ZoneDTO>()
    };

    /// <summary>
    /// Current search text entered by the user for filtering trees.
    /// </summary>
    private string? searchTreeText = null;

    /// <summary>
    /// Base64 representation of the ground plan image for preview.
    /// </summary>
    string groundPlanPreview = string.Empty;

    /// <summary>
    /// If true this displays the zone creation popup.
    /// </summary>
    private bool showZoneCreation;

    /// <summary>
    /// Reference to the <see cref="Toasts"/> component used to render toast notifications.
    /// </summary>
    private Toasts? toastContainer;

    /// <summary>
    /// Holds the list of toast messages to display in the UI.
    /// </summary>
    private List<ToastMessage> toastMessages = new List<ToastMessage>();

    /// <summary>
    /// If true this displays the zone deletion popup.
    /// </summary>
    private bool showConfirmZoneDeletion;

    /// <summary>
    /// If true this displays the form submission popup.
    /// </summary>
    private bool showConfirmSaveForm;

    /// <summary>
    /// Returns a new, empty zone DTO associated with the current plantation site.
    /// </summary>
    private ZoneDTO EmptyZone {
        get
        {
            return new ZoneDTO()
            {
                Id = 0,
                PlantationSiteId = this.plantationSite?.Id ?? 0,
                TreeId = 0
            };
        }
    }

    /// <summary>
    /// Temporary index used for newly added zones before they are saved to the backend.
    /// </summary>
    private int tempAddedZoneIndex = -1;

    /// <summary>
    /// Timer used to debounce the search input to avoid making too many API calls while typing.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// Currently selected zone for editing or addition.
    /// </summary>
    private int SelectedZoneId;

    /// <summary>
    /// Flag to track if the current operation is editing an existing zone.
    /// </summary>
    private bool IsEditZone;

    /// <summary>
    /// This is a delegate that is used to delete all the zones at once.
    /// </summary>
    private Func<Task<HttpResponseMessage>>? DeleteZonesAction;

    /// <summary>
    /// Holds the new zone that is being added.
    /// </summary>
    private ZoneDTO? newZone;

    /// <summary>
    /// List of available trees for assignment to zones.
    /// </summary>
    private IEnumerable<TreeDTO>? Trees;

    /// <summary>
    /// HttpClient instance for API calls.
    /// </summary>
    HttpClient? client;

    /// <summary>
    /// Initializes the component, loads plantation site data if editing, loads trees and zones.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        client = HttpClientFactory.CreateClient("BTPApi");
        this.SelectedZoneId = 0;

        if (this.id != 0) {
            this.plantationSite = await this.client.GetFromJsonAsync<PlantationSiteDTO>($"PlantationSite/{this.id}");

            if (!string.IsNullOrEmpty(this.plantationSite?.GroundPlan))
            {
                await this.LoadImagePreview(client, this.plantationSite.GroundPlan);
            }
        }

        await this.LoadTrees();
        await this.LoadZones();
    }

    /// <summary>
    /// Loads zones for the current plantation site from the backend API.
    /// </summary>
    private async Task LoadZones()
    {
        if (this.plantationSite == null || this.plantationSite.Id == 0) return;  // No toast needed, because there are no zones when a new plantationsite is created.

        if (this.client == null) return;

        ICollection<ZoneDTO>? response;

        response = await this.client.GetFromJsonAsync<ICollection<ZoneDTO>>($"Zone?plantationSiteId={this.plantationSite.Id}");

        if (response != null)
        {
            this.plantationSite.Zones = response;
            StateHasChanged();
        } else
        {
            EnqueueToast(message: "Er is iets misgegaan bij het laden van de zones", ToastType.Warning);
        }
    }

    /// <summary>
    /// Loads all trees from the backend API.
    /// </summary>
    private async Task LoadTrees()
    {
        if (this.client == null)
        {
            EnqueueToast(message: "De http-client is niet succesvol geïnstantieerd!", ToastType.Warning);

            return;
        }

        IEnumerable<TreeDTO>? response;

        response = await this.client.GetFromJsonAsync<IEnumerable<TreeDTO>>("Tree/all" + (this.searchTreeText != null? $"?search={this.searchTreeText}": ""));

        if (response != null)
        {
            this.Trees = response;
            StateHasChanged();
        } else
        {
            EnqueueToast(message: "Er is iets misgegaan bij het laden van de bomen", ToastType.Warning);
        }
    }

    /// <summary>
    /// Handles changes in the search input field. Debounces the search by 300ms before reloading the first page.
    /// </summary>
    /// <param name="e">The change event containing the new search text.</param>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        this.searchTreeText = e.Value?.ToString()?.Trim();

        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadTrees();
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Handles form submission for creating or updating a plantation site and its zones.
    /// </summary>
    private async Task HandleValidSubmit(){
        if (this.client == null || this.plantationSite == null)
        {
            EnqueueToast(message: "De http-client of de kweeksite is niet succesvol geïnstantieerd!", ToastType.Warning);

            return;
        }

        HttpResponseMessage response;

        foreach (ZoneDTO zone in this.plantationSite.Zones ?? [])
        {
            if (zone.Id < 0) zone.Id = 0;
            if (zone.PlantationSiteId == 0) zone.PlantationSiteId = this.plantationSite.Id;
        }

        if (this.DeleteZonesAction != null)
        {
            await this.DeleteZonesAction();
            this.DeleteZonesAction = null;
            EnqueueToast(message: "De geselecteerde zones zijn succesvol verwijderd.", ToastType.Success);
        }

        this.showConfirmSaveForm = false;

        if (id == 0) response = await this.client.PostAsJsonAsync("PlantationSite", plantationSite);
        else response = await this.client.PutAsJsonAsync($"PlantationSite/{id}", plantationSite);

        if (response.IsSuccessStatusCode)
        {
            EnqueueToast(message: $"De kweeksite is succesvol {(id == 0? "toegevoegd": "gewijzigd")}.", ToastType.Success);
        }
        else
        {
            string error = await response.Content.ReadAsStringAsync();
            EnqueueToast(message: $"Er ging iets mis bij het {(id == 0? "toegevoegen": "wijzigen")} van de kweeksite: {error}", ToastType.Warning);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Cancels the editing/creation and navigates back to the plantation site list.
    /// </summary>
    private void Cancel()
    {
        this.showConfirmSaveForm = false;
        Navigation.NavigateTo("/admin/plantation-site");
    }

    /// <summary>
    /// Uploads a ground plan file for the plantation site and generates a preview.
    /// </summary>
    /// <param name="e">The file change event containing the uploaded file.</param>
    private async Task HandleGroundPlanUpload(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;

        if (this.client == null)
        {
            EnqueueToast(message: "De http-client is niet succesvol geïnstantieerd!", ToastType.Warning);

            return;
        }

        if (!this.allowedGroundplanFileTypes.Contains(file.ContentType))
        {
            EnqueueToast(message: $"Het bestandstype {file.ContentType} is niet toegestaan.", ToastType.Warning);

            return;
        }

        using MultipartFormDataContent content = new MultipartFormDataContent();
        using Stream stream = file.OpenReadStream();

        StreamContent fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

        content.Add(fileContent, "file", file.Name);

        HttpResponseMessage response = await this.client.PostAsync("File/upload", content);

        if (response.IsSuccessStatusCode)
        {
            JsonElement json = await response.Content.ReadFromJsonAsync<JsonElement>();
            string? fileName = json.GetProperty("fileName").GetString();

            if (!string.IsNullOrEmpty(fileName))
            {
                plantationSite!.GroundPlan = fileName;
                await LoadImagePreview(client, plantationSite.GroundPlan);
            }

            EnqueueToast(message: $"Het bestand ({fileName}) is correct opgeslagen", ToastType.Success);
        }
        else
        {
            string error = await response.Content.ReadAsStringAsync();
            EnqueueToast(message: $"Er ging iets mis met het uploaden met het bestand: {error}", ToastType.Warning);
        }
    }

    /// <summary>
    /// Finds a tree by its ID.
    /// </summary>
    /// <param name="id">Tree ID.</param>
    /// <returns>The tree DTO or null if not found.</returns>
    private TreeDTO? findTree(int? id)
    {
        return id == null? null : this.Trees?.Where(tree => tree.Id == id).FirstOrDefault() ?? null;
    }

    /// <summary>
    /// Confirms deletion of a zone by ID.
    /// </summary>
    /// <param name="id">Zone ID.</param>
    private void ConfirmDeleteZone(int id)
    {
        this.SelectedZoneId = id;
        this.showConfirmZoneDeletion = true;
    }

    /// <summary>
    /// Deletes a zone by ID, either from the backend or the local list if it hasn't been saved yet.
    /// </summary>
    /// <param name="id">Zone ID.</param>
    private async Task DeleteZone(int id)
    {
        this.showConfirmZoneDeletion = false;

        if (this.plantationSite == null || this.plantationSite.Zones == null)
        {
            EnqueueToast(message: "De zone kon niet verwijdert worden. De kweeksite of zonelijst kon niet gevonden worden.", ToastType.Warning);

            return;
        }

        // If the plantationSite id is 0 or smaller, this means the the zone hasn't been sent to the backend yet, so it can just be removed from the frontend.
        if(this.plantationSite.Id <= 0)
        {
            this.plantationSite.Zones = this.plantationSite.Zones.Where(zone => zone.Id != id).ToList();
            EnqueueToast(message: "De zone is succesvol verwijdert geweest.", ToastType.Success);

            return;
        }

        if (this.client != null)
        {
            if(this.DeleteZonesAction == null) this.DeleteZonesAction = () => this.client.DeleteAsync($"Zone?id={id}");
            else this.DeleteZonesAction += () => this.client.DeleteAsync($"Zone?id={id}");

            this.plantationSite.Zones = this.plantationSite.Zones.Where(zone => zone.Id != id).ToList();
            EnqueueToast(message: "Het verwijderen van de zone wordt correct afgehandelt. Druk op \"Bewaar\" om finaal te verwijderen.", ToastType.Success);
        }

        await this.LoadTrees();
        this.SelectedZoneId = 0;
        StateHasChanged();
    }

    /// <summary>
    /// Loads a ground plan image from the backend and generates a base64 preview string.
    /// </summary>
    /// <param name="client">The HTTP client for fetching the image.</param>
    /// <param name="fileName">The filename of the ground plan image.</param>
    private async Task LoadImagePreview(HttpClient client, string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return;

        try
        {
            HttpResponseMessage response = (await client.GetAsync($"File/{fileName}")).EnsureSuccessStatusCode();

            byte[] imageBytes = await response.Content.ReadAsByteArrayAsync();

            string contentType = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";

            string base64Image = Convert.ToBase64String(imageBytes);
            this.groundPlanPreview = $"data:{contentType};base64,{base64Image}";
            EnqueueToast(message: "De afbeelding is correct opgeslagen.", ToastType.Success);
        }
        catch(HttpRequestException e)
        {
            EnqueueToast(message: $"Het verzoek naar de server was onsuccesvol: {e}", ToastType.Warning);
            this.groundPlanPreview = string.Empty;
        }
        catch(ArgumentNullException e)
        {
            EnqueueToast(message: $"Kon de afbeelding niet omzetten naar base64: {e}", ToastType.Warning);
            this.groundPlanPreview = string.Empty;
        }
    }

    /// <summary>
    /// Creates or updates a zone within the plantation site.
    /// Performs validation checks, handles edit vs. create logic,
    /// refreshes related data, and updates UI state.
    /// </summary>
    private async Task CreateZone()
    {
        if (this.newZone == null)
        {
            EnqueueToast(message: "Nieuwe zone kan niet worden gevonden, deze is null.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if (this.plantationSite == null)
        {
            EnqueueToast(message: "De kweeksite kon niet worden gevonden, deze is null.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if (this.newZone.TreeId == 0)
        {
            EnqueueToast(message: "De boom in de nieuwe zone is nog niet opgeslagen in de database.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if (this.newZone.PlantationSiteId == 0)
        {
            EnqueueToast(message: "De kweeksite in de nieuwe zone is nog niet opgeslagen in de database.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if (string.IsNullOrWhiteSpace(this.newZone.Name))
        {
            EnqueueToast(message: "De naam van een zone kan niet leeg zijn.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if(this.newZone.Size == null)
        {
            EnqueueToast(message: "De zone moet een oppervlakte hebben.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if((this.plantationSite.Zones?.Sum(zone => zone.Size) ?? 0) + (this.IsEditZone? 0: this.newZone.Size) >= this.plantationSite.Size)
        {
            EnqueueToast(message: "De som van de oppervlaktes van de zones moet kleiner zijn dan het oppervlakte van de kweeksite.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if (this.IsEditZone)
        {
            if(this.plantationSite.Zones == null)
            {
                EnqueueToast(message: "De kweeksite had geen zones, dus er konden geen zones worden bijgewerkt.", ToastType.Warning);
                StateHasChanged();

                return;
            }

            List<ZoneDTO> zones = this.plantationSite.Zones.ToList();
            int index = zones.FindIndex(zone => zone.Id == newZone.Id);

            if(index == -1)
            {
                EnqueueToast(message: "Zone kon niet worden bijgewerkt, omdat deze niet meer kon worden gevonden in de lijst met zones van de kweeksite.", ToastType.Warning);
                StateHasChanged();

                return;
            }

            zones[index] = newZone;
            this.plantationSite.Zones = zones;
        } else
        {
            if (this.plantationSite.Zones == null) this.plantationSite.Zones = new List<ZoneDTO>();

            this.plantationSite.Zones.Add(newZone);
        }

        this.newZone = null;
        this.searchTreeText = null;
        await this.LoadTrees();
        this.IsEditZone = false;
        this.showZoneCreation = false;
        StateHasChanged();
    }

    /// <summary>
    /// Cancels the deletion confirmation dialog for a zone.
    /// </summary>
    private Task CancelZoneDeletion()
    {
        this.showConfirmZoneDeletion = false;
        StateHasChanged();

        return Task.CompletedTask;
    }

    /// <summary>
    /// Cancels the process of creating or editing a zone.
    /// Resets temporary state and reloads available trees.
    /// </summary>
    private async Task CancelZoneCreation()
    {
        this.searchTreeText = null;
        await this.LoadTrees();
        this.showZoneCreation = false;
        this.newZone = null;
        StateHasChanged();
    }

    /// <summary>
    /// Opens the UI section for editing an existing zone.
    /// Creates a temporary editable copy of the selected zone.
    /// </summary>
    /// <param name="zone">The zone to edit.</param>
    private void OpenEditZone(ZoneDTO zone)
    {
        this.showZoneCreation = true;

        this.newZone = new ZoneDTO()
        {
            Id = zone.Id,
            PlantationSiteId = zone.PlantationSiteId,
            TreeId = zone.TreeId,
            Name = zone.Name,
            Size = zone.Size
        };

        this.IsEditZone = true;

        StateHasChanged();
    }

    /// <summary>
    /// Opens the UI for creating a new zone.
    /// Initializes a temporary zone with defaults.
    /// </summary>
    private void OpenZoneCreation()
    {
        this.showZoneCreation = true;
        this.IsEditZone = true;

        if(this.newZone == null)
        {
            this.newZone = new ZoneDTO()
            {
                Id = this.tempAddedZoneIndex--,
                PlantationSiteId = this.plantationSite?.Id ?? 0,
                TreeId = 0
            };

            this.IsEditZone = false;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Adds a warning toast message to the toast container.
    /// </summary>
    /// <param name="message">The message to display.</param>
    private void EnqueueToast(string message, ToastType type)
    {
        toastMessages.Add(new ToastMessage
        {
            Type = type,
            Title = ToastType.Warning.ToString(),
            Message = message,
            AutoHide = true
        });
    }
}