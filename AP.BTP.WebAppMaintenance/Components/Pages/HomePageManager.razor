@attribute [Authorize(Roles = "Manager")]
@page "/manager/dashboard"
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer

<div class="d-flex justify-content-center mt-5" style="font-size: 5vw">Welkom! 🌱</div>
<div class="d-flex justify-content-center" style="font-size: 2vw">Wat wil je vandaag doen?</div>

<div class="d-flex justify-content-around" style="margin-top: 10vh">
    @foreach (DashboardCard card in DashboardCards)
    {
        <Card Style="background-color: #D9D9D9; border-radius: 24px; border: none; padding: 4vh; width: 30%;">
            <CardBody Class="p-0 m-0">
                <CardTitle Style="font-weight: bold; margin-bottom: 2vh; font-size: 2.25vw;">@card.Title</CardTitle>
                <CardText Style="font-size:1vw; margin-bottom: 2vh;">@card.Description</CardText>
                <a href="@card.Url" style="text-decoration: none;">
                    <Button Color="ButtonColor.Dark" Style="height: 5vh; width:100%">Navigeer</Button>
                </a>
            </CardBody>
        </Card>
    }
</div>

@code {
    private List<DashboardCard> DashboardCards = new List<DashboardCard>
    {
        new DashboardCard
        {
            Title = "Beheer de planning",
            Description = "Bekijk de medewerkers en maak hun planning.",
            Url = "/manager/planning"
        },
        new DashboardCard
        {
            Title = "Bekijk de bomen",
            Description = "bekijk de bomen en hun details zoals de qr code, foto's en beschrijving.",
            Url = "/manager/tree"
        },
    };

    private class DashboardCard
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
    }
}