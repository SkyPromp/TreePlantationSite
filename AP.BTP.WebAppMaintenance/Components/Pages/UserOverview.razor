@attribute [Authorize(Roles = "Admin")]
@page "/admin/users"
@rendermode InteractiveServer
@using AP.BTP.Application.CQRS.Auth0User
@using System.Drawing
@using System.Text.Json
@using AP.BTP.Application.CQRS.PlantationSite
@using System.Text.Encodings.Web
@using AP.BTP.Application.CQRS.User
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Gebruikers</PageTitle>

<h3 class="text-center">Gebruikers overzicht</h3>

<div class="d-flex justify-content-between px-3">
    <a href="/admin/users/approve" style="text-decoration: none;">
        <Button Class="btn btn-dark d-flex align-items-center justify-content-center px-4 py-2 mb-3"
                Style=" box-shadow: none; border: none; text-decoration: none;">
            Verzoeken (@this.requestsCount)
        </Button>
    </a>
    <div class="d-flex flex-column align-items-end">
        <TextInput @bind-Value="@searchText"
                   @oninput="OnSearchChanged"
                   TextAlignment="Alignment.Start"
                   Placeholder="Search e-mail"
                   Style="width: 15vw; border-width: 2px;" />
    </div>
</div>
<div class="container-fluid m-0 p-3" Style="background-color: #D9D9D9; border-radius: 15px;">
    @if (response?.Items != null)
    {
        <div class="d-grid p-1 fw-bold"
             style="grid-template-columns: 1fr 2fr 2fr 2fr auto; column-gap: 1rem; border-radius: 10px;">
            <div>Naam</div>
            <div>E-mail</div>
            <div>Gsm-number</div>
            <div>plantagelocaties</div>
            <div class="text-center">Beheer</div>
        </div>
        <div style="overflow-x:hidden; max-height: 55vh;">
            @foreach (List<UserDTO> row in Rows)
            {
                <div class="row">
                    @foreach (UserDTO item in row)
                    {
                        <div class="p-2">
                            <Card Class="px-2 mb-0" Style="background-color: #FFFFFF; border-radius: 10px; border: none;">
                                <CardBody Class="p-0 d-grid align-items-center"
                                          Style="grid-template-columns: 1fr 2fr 2fr 2fr auto; column-gap: 1rem;">
                                    <CardText class="m-0">@item.Name</CardText>
                                    <CardText class="m-0">
                                        <a href="mailto:@item.Email" style="text-decoration:none; color:#0d6efd;">
                                            @item.Email
                                        </a>
                                    </CardText>
                                    <CardText class="m-0">123456456789</CardText>
                                    @if (item.PlantationSites != null)
                                    {
                                        <CardText class="m-0">@string.Join(", ", item.PlantationSites.Select(s => s.Name))</CardText>
                                    }
                                    else
                                    {
                                        <CardText class="m-0">n.v.t.</CardText>
                                    }
                                    <div class="p-1">
                                        <Button title="Bewerk gebruiker"
                                                Class="btn btn-dark btn-sm px-3"
                                                @onclick="() => OnEditUser(item)">
                                            Edit
                                        </Button>
                                        <Button title="Verwijder gebruiker"
                                                Class="btn btn-danger btn-sm">
                                            <Icon Name="IconName.Trash" />
                                        </Button>
                                    </div>
                                </CardBody>

                            </Card>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center mt-4">Geen resultaten gevonden.</p>
    }
</div>

<Pagination Class="justify-content-center"
            Style="margin-top: 10px"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
</Pagination>

@if (this.showEditUser)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Verander de plantagelocaties van deze gebruiker</h5>
            <p>Plantagelocatie 1</p>
            <select @bind="this.site1" class="form-select mb-3">
                <option value=""></option>
                @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                {
                    <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site2)">@plantationSite.Name</option>
                }
            </select>

            <p>Plantagelocatie 2</p>
            <select @bind="this.site2" class="form-select mb-3">
                <option value=""></option>
                @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                {
                    <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site1)">@plantationSite.Name</option>
                }
            </select>
            @if (isLoading)
            {

                <div class="spinner-border align-self-center" role="status">
                    <span class="visually-hidden">Laden...</span>
                </div>
            }
            else
            {
                <div class="row gap-3">
                    <div class="col">
                        <button @onclick="CancelEditUser" class="btn btn-warning">Annuleer</button>
                    </div>
                    <div class="col">
                        <button @onclick="UpdateUserSites" class="btn btn-secondary">Bevestig</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (this.showSuccessToast)
{
    <div class="toast-container position-fixed top-50 start-50 translate-middle-x mt-3" style="z-index: 1055;">
        <div class="toast show text-white bg-success shadow" style="opacity:@toastOpacity; transition: opacity 0.5s ease;">
            <div class="toast-body">
                ✅ Gebruiker is succesvol bewerkt!
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    private string? searchText = null;
    PagedResponse<UserDTO>? response;
    private int currentPage = 1;
    private int cardsPerRow = 1;
    private int maxRows = 7;
    private int pageSize => cardsPerRow * maxRows;
    private int totalPages => response?.TotalPages ?? 1;
    private System.Timers.Timer? debounceTimer;
    private HttpClient client;
    private string errorMessage = "";
    private int requestsCount = 0;

    private bool showEditUser;
    private IEnumerable<PlantationSiteDTO> plantationSites = new List<PlantationSiteDTO>();
    private int? site1;
    private int? site2;
    private string roleId = "";
    private UserDTO? selectedUser;
    private bool showSuccessToast = false;
    private double toastOpacity = 1.0;
    private bool isLoading = false;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            client = HttpClientFactory.CreateClient("BTPApi");
            await LoadPage(1);
            await LoadRequestsCount();
            await LoadPlantationSites();
        }
    }

    private async Task LoadPage(int page)
    {
        currentPage = page;

        string url = $"UserManagement/users?pageNr={page}&pageSize={pageSize}";
        if (!string.IsNullOrWhiteSpace(searchText))
            url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponse<UserDTO>>(url);
        StateHasChanged();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private IEnumerable<List<UserDTO>> Rows =>
        (response?.Items ?? Enumerable.Empty<UserDTO>())
            .Select((item, index) => new { item, index })
            .GroupBy(x => x.index / cardsPerRow)
            .Select(g => g.Select(x => x.item).ToList());

    private async Task LoadRequestsCount()
    {
        PagedResponse<Auth0User>? response = await client.GetFromJsonAsync<PagedResponse<Auth0User>>("UserManagement/pending");
        requestsCount = response?.TotalItems ?? 0;
        StateHasChanged();
    }

    private async Task LoadPlantationSites()
    {
        if (this.client == null) return;

        try
        {
            PagedResponse<PlantationSiteDTO>? response;

            response = await this.client.GetFromJsonAsync<PagedResponse<PlantationSiteDTO>>("PlantationSite");

            if (response != null)
            {
                this.plantationSites = response.Items;
                StateHasChanged();
            }
            else
            {
                this.errorMessage = "Something went wrong when loading in the plantation sites";
            }
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    private async Task UpdateUserSites()
    {
        isLoading = true;

        List<int> selectedSites = new List<int>();
        if (site1.HasValue)
            selectedSites.Add(site1.Value);
        if (site2.HasValue)
            selectedSites.Add(site2.Value);

        await client.PutAsJsonAsync($"UserManagement/users/{selectedUser!.Id}/sites", new LinkUserToPlantationSitesDto() { PlantationSiteIds = selectedSites });

        CancelEditUser();

        await ShowSuccessToast();
        await LoadPage(currentPage);
        isLoading = false;
    }

    private void OnEditUser(UserDTO user)
    {
        selectedUser = user;
        showEditUser = true;

        // Reset first
        site1 = null;
        site2 = null;

        // Preselect existing plantation sites if they exist
        if (user.PlantationSites != null && user.PlantationSites.Any())
        {
            var sites = user.PlantationSites.Take(2).ToList();
            if (sites.Count > 0) site1 = sites[0].Id;
            if (sites.Count > 1) site2 = sites[1].Id;
        }
    }

    private void CancelEditUser()
    {
        this.showEditUser = false;
        this.selectedUser = null;
        this.site1 = null;
        this.site2 = null;
        this.roleId = "";
    }

    private bool IsDisabled(int id, int? otherSite) => otherSite.HasValue && id == otherSite.Value;

    private async Task ShowSuccessToast()
    {
        showSuccessToast = true;
        toastOpacity = 1.0;
        StateHasChanged();

        await Task.Delay(2500);

        toastOpacity = 0.0;
        StateHasChanged();

        await Task.Delay(500);
        showSuccessToast = false;
        StateHasChanged();
    }
}
