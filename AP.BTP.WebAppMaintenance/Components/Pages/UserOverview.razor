@attribute [Authorize(Roles = "Admin")]
@page "/admin/users"
@rendermode InteractiveServer
@using System.Drawing
@using System.Text.Json
@using System.Text.Encodings.Web
@using AP.BTP.Contracts.DTOs
@using AP.BTP.Contracts.Enums
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Gebruikers</PageTitle>

<h3 class="text-center">Gebruikersoverzicht</h3>

<div class="d-flex justify-content-between px-3">
    <a href="/admin/users/approve" style="text-decoration: none;">
        <Button Class="btn btn-dark d-flex align-items-center justify-content-center px-4 py-2 mb-3"
                Style=" box-shadow: none; border: none; text-decoration: none;">
            Verzoeken (@this.requestsCount)
        </Button>
    </a>
    <div class="d-flex flex-column align-items-end">
        <TextInput @bind-Value="@searchText"
                   @oninput="OnSearchChanged"
                   TextAlignment="Alignment.Start"
                   Placeholder="Zoek gebruikers"
                   Style="width: 15vw; border-width: 2px;" />
    </div>
</div>
<div class="container-fluid m-0 p-3" Style="background-color: #D9D9D9; border-radius: 15px;">
    @if (response?.Items != null)
    {
        <div class="d-grid p-1 fw-bold"
             style="grid-template-columns: 1fr 2fr 2fr 2fr 2fr auto; column-gap: 1rem; border-radius: 10px;">
            <div @onclick='() => OnSortChanged("FirstName")' style="cursor:pointer;">
                Naam @SortIndicator("FirstName")
            </div>
            <div @onclick='() => OnSortChanged("Email")' style="cursor:pointer;">
                E-mail @SortIndicator("Email")
            </div>
            <div @onclick='() => OnSortChanged("PhoneNumber")' style="cursor:pointer;">
                Gsm-number @SortIndicator("PhoneNumber")
            </div>
            <div>Kweeksites</div>
            <div @onclick='() => OnSortChanged("Role")' style="cursor:pointer;">
                Rol @SortIndicator("Role")
            </div>
            <div class="text-center">Beheren</div>
        </div>
        <div style="overflow-x:hidden; max-height: 55vh;">
            @foreach (List<UserDto> row in Rows)
            {
                <div class="row">
                    @foreach (UserDto item in row)
                    {
                        <div class="p-2">
                            <Card Class="px-2 mb-0" Style="background-color: #FFFFFF; border-radius: 10px; border: none;">
                                <CardBody Class="p-0 d-grid align-items-center"
                                          Style="grid-template-columns: 1fr 2fr 2fr 2fr 2fr auto; column-gap: 1rem;">
                                    <CardText class="m-0">@item.FirstName @item.LastName</CardText>
                                    <CardText class="m-0">
                                        <a href="mailto:@item.Email" style="text-decoration:none; color:#0d6efd;">
                                            @item.Email
                                        </a>
                                    </CardText>
                                    <CardText class="m-0">@item.PhoneNumber</CardText>
                                    @if (item.PlantationSites != null)
                                    {
                                        <CardText class="m-0">@string.Join(", ", item.PlantationSites.Select(s => s.Name))</CardText>
                                    } else
                                    {
                                        <CardText class="m-0">n.v.t.</CardText>
                                    }
                                    <CardText class="m-0">@item.Role.ToString()</CardText>
                                    <div class="p-1">
                                        <Button title="Bewerk gebruiker"
                                                Class="btn btn-dark btn-sm px-3"
                                                @onclick="() => OnEditUser(item)">
                                            <Icon Name="IconName.PencilFill" />
                                        </Button>
                                        <Button title="Verwijder gebruiker"
                                                Class="btn btn-danger btn-sm"
                                                @onclick="() => { this.showDeleteConfirmation = true; selectedUser = item; }">
                                            <Icon Name="IconName.Trash" />
                                        </Button>
                                    </div>
                                </CardBody>

                            </Card>
                        </div>
                    }
                </div>
            }
        </div>
    } else
    {
        <p class="text-center mt-4">Geen resultaten gevonden.</p>
    }
</div>

<Toasts Class="m-3" Messages="toastMessages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" ShowCloseButton="false" />

<Pagination Class="justify-content-center"
            Style="margin-top: 10px"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
</Pagination>

@if (this.showEditUser)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Verander de kweeksites van deze gebruiker</h5>
            <p>Kweeksite 1</p>
            <select @bind="this.site1" class="form-select mb-3">
                <option value=""></option>
                @foreach (PlantationSiteDto plantationSite in this.plantationSites)
                {
                    <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site2)">@plantationSite.Name</option>
                }
            </select>

            <p>Kweeksite 2</p>
            <select @bind="this.site2" class="form-select mb-3">
                <option value=""></option>
                @foreach (PlantationSiteDto plantationSite in this.plantationSites)
                {
                    <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site1)">@plantationSite.Name</option>
                }
            </select>
            @if (isLoading)
            {

                <div class="spinner-border align-self-center" role="status">
                    <span class="visually-hidden">Laden...</span>
                </div>
            } else
            {
                <div class="row gap-3">
                    <div class="col">
                        <button @onclick="CancelEditUser" class="btn btn-warning">Verlaten</button>
                    </div>
                    <div class="col">
                        @if (selectedUser != null && selectedUser.Role == UserRole.Operator)
                        {
                            <button @onclick="UpdateUserSites" class="btn btn-secondary">Bevestigen</button>
                        } else
                        {
                            <div>Je kan geen kweeksites aan deze gebruiker toewijzen omdat het geen operator is.</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<ConfirmationPopup showConfirmationPopup="this.showDeleteConfirmation"
                   onCancellation="this.CancelEditUser"
                   onConfirmation="this.DeleteUser"
                   confirmationDescription="Ben je zeker dat je deze gebruiker wil verwijderen?" />

@code {
    /// <summary>
    /// The text used to search users.
    /// </summary>
    private string? searchText;

    /// <summary>
    /// Holds the list of toast messages to display in the UI.
    /// </summary>
    private readonly List<ToastMessage> toastMessages = new List<ToastMessage>();

    /// <summary>
    /// The paginated response containing the list of users.
    /// </summary>
    PagedResponseDto<UserDto>? response;  // TODO IEnumerable<...> not pagedResponse...

    /// <summary>
    /// The current page number being viewed.
    /// </summary>
    private int currentPage = 1;

    /// <summary>
    /// The number of user cards displayed per row.
    /// </summary>
    private readonly int cardsPerRow = 1;

    /// <summary>
    /// The maximum number of rows shown per page.
    /// </summary>
    private readonly int maxRows = 7;

    /// <summary>
    /// Calculates the total number of users per page based on layout configuration.
    /// </summary>
    private int pageSize => cardsPerRow * maxRows;

    /// <summary>
    /// Gets the total number of pages based on API response.
    /// </summary>
    private int totalPages => response?.TotalPages ?? 1;

    /// <summary>
    /// A timer used to debounce user search input.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// The HTTP client used to communicate with the backend API.
    /// </summary>
    private HttpClient client = default!;

    /// <summary>
    /// The number of pending user registration requests.
    /// </summary>
    private int requestsCount = 0;

    /// <summary>
    /// Indicates whether the Edit User modal is currently shown.
    /// </summary>
    private bool showEditUser;

    /// <summary>
    /// The list of plantation sites available for user assignment.
    /// </summary>
    private IEnumerable<PlantationSiteDto> plantationSites = new List<PlantationSiteDto>();

    /// <summary>
    /// The first plantation site assigned to the user.
    /// </summary>
    private int? site1;

    /// <summary>
    /// The second plantation site assigned to the user.
    /// </summary>
    private int? site2;

    /// <summary>
    /// The currently selected user being edited.
    /// </summary>
    private UserDto? selectedUser;

    /// <summary>
    /// Indicates whether an API call or operation is in progress.
    /// </summary>
    private bool isLoading = false;

    /// <summary>
    /// Indicates whether a delete confirmation modal should be displayed.
    /// </summary>
    private bool showDeleteConfirmation = false;

    /// <summary>
    /// Indicates the sorting direction
    /// </summary>
    private string sortDirection = "asc";

    /// <summary>
    /// Indicates what needs to be sorted
    /// </summary>
    private string sortBy = "FirstName";

    /// <summary>
    /// Initializes the component and loads initial data such as users,
    /// pending requests, and plantation sites when the component first renders.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            client = HttpClientFactory.CreateClient("BTPApi");
            await LoadPage(1);
            await LoadRequestsCount();
            await LoadPlantationSites();
        }
    }

    /// <summary>
    /// Loads a specific page of user data from the API.
    /// </summary>
    /// <param name="page">The page number to load.</param>
    private async Task LoadPage(int page)
    {
        currentPage = page;

        string url = $"user/approved?pageNr={page}&pageSize={pageSize}&sortBy={sortBy}&sortDirection={sortDirection}";
        if (!string.IsNullOrWhiteSpace(searchText))
            url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponseDto<UserDto>>(url);
        StateHasChanged();
    }

    /// <summary>
    /// Handles search box input changes and reloads user data after a short debounce delay.
    /// </summary>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Organizes users into row groups for display.
    /// </summary>
    private IEnumerable<List<UserDto>> Rows =>
    (response?.Items ?? Enumerable.Empty<UserDto>())
        .Select((item, index) => new { item, index })
        .GroupBy(x => x.index / cardsPerRow)
        .Select(g => g.Select(x => x.item).ToList());

    /// <summary>
    /// Retrieves the number of pending user registration requests.
    /// </summary>
    private async Task LoadRequestsCount()
    {
        PagedResponseDto<UserDto>? pagedResponseDto = await client.GetFromJsonAsync<PagedResponseDto<UserDto>>("User/pending");
        requestsCount = pagedResponseDto?.TotalItems ?? 0;
        StateHasChanged();
    }

    /// <summary>
    /// Loads available plantation sites for assignment.
    /// </summary>
    private async Task LoadPlantationSites()
    {
        List<PlantationSiteDto>? plantationSiteDtoListResponse;

            plantationSiteDtoListResponse = await this.client.GetFromJsonAsync<List<PlantationSiteDto>>("PlantationSite/all");

        if (plantationSiteDtoListResponse != null)
        {
            this.plantationSites = plantationSiteDtoListResponse;
            StateHasChanged();
        } else
        {
            this.EnqueueToast(message: "Er is iets misgegaan bij het inladen van de kweeksites.", type: ToastType.Warning);
        }
    }

    /// <summary>
    /// Updates the plantation site assignments for the selected user.
    /// </summary>
    private async Task UpdateUserSites()
    {
        isLoading = true;

        List<int> selectedSites = new List<int>();
        if (site1.HasValue)
            selectedSites.Add(site1.Value);
        if (site2.HasValue)
            selectedSites.Add(site2.Value);

        await client.PutAsJsonAsync($"user/{selectedUser!.Id}/sites", new LinkUserToPlantationSitesDto() { PlantationSiteIds = selectedSites });

        await CancelEditUser();

        this.EnqueueToast(message: "Gebruiker is succesvol bewerkt!", type: ToastType.Warning);
        await LoadPage(currentPage);
        isLoading = false;
    }

    /// <summary>
    /// Opens the Edit User dialog for the specified user and pre-fills their plantation site assignments.
    /// </summary>
    private void OnEditUser(UserDto user)
    {
        selectedUser = user;
        showEditUser = true;

        // Reset first
        site1 = null;
        site2 = null;

        // Preselect existing plantation sites if they exist
        if (user.PlantationSites != null && user.PlantationSites.Any())
        {
            List<PlantationSiteDto>? sites = user.PlantationSites.Take(2).ToList();
            if (sites.Count > 0)
                site1 = sites[0].Id;
            if (sites.Count > 1)
                site2 = sites[1].Id;
        }
    }

    /// <summary>
    /// Cancels the user editing process and resets related UI state.
    /// </summary>
    private Task CancelEditUser()
    {
        this.showEditUser = false;
        this.selectedUser = null;
        this.site1 = null;
        this.site2 = null;
        this.showDeleteConfirmation = false;

        return Task.CompletedTask;
    }

    /// <summary>
    /// Determines whether a plantation site dropdown option should be disabled.
    /// </summary>
    private static bool IsDisabled(int id, int? otherSite) => otherSite.HasValue && id == otherSite.Value;

    /// <summary>
    /// Deletes the selected user.
    /// </summary>
    private async Task DeleteUser()
    {
        isLoading = true;
        if (selectedUser == null)
        {
            this.EnqueueToast(message: "Er is geen gebruiker geselecteerd, er kan dus geen gebruiker worden verwijdert.", type: ToastType.Warning);

            return;
        }

        try
        {
            await client.DeleteAsync($"user/{selectedUser!.Id}");
            await LoadPage(currentPage);
            StateHasChanged();
        } catch (InvalidOperationException e)
        {
            EnqueueToast(message: $"Fout bij het verwijderen van gebruiker: {e.Message}", ToastType.Warning);
        } catch (HttpRequestException e)
        {
            EnqueueToast(message: $"Fout bij het verwijderen van gebruiker: {e.Message}", ToastType.Warning);
        } catch (TaskCanceledException e)
        {
            EnqueueToast(message: $"Fout bij het verwijderen van gebruiker: {e.Message}", ToastType.Warning);
        }

        await CancelEditUser();
        isLoading = false;
    }

    /// <summary>
    /// Handles changes in the sorting direction.
    /// </summary>
    /// <param name="column">The column that needs to be sorted.</param>
    private void OnSortChanged(string column)
    {
        if (sortBy == column)
        {
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        } else
        {
            sortBy = column;
            sortDirection = "asc";
        }

        _ = LoadPage(1);
    }

    /// <summary>
    /// Handles the icon to display for the sorting direction.
    /// </summary>
    /// <param name="column">The column that needs to be sorted.</param>
    private string SortIndicator(string column)
    {
        if (sortBy != column)
            return "";
        return sortDirection == "asc" ? "↑" : "↓";
    }

    /// Adds a toast message to the toast container.
    /// </summary>
    /// <param name="message">The message to display.</param>
    /// <param name="type">The message type to display.</param>
    private void EnqueueToast(string message, ToastType type)
    {
        this.toastMessages.Add(new ToastMessage
        {
            Type = type,
            Title = type.ToString(),
            Message = message,
            AutoHide = true
        });
    }
}
