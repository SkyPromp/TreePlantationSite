@attribute [Authorize(Roles = "Admin")]
@page "/admin/users"
@rendermode InteractiveServer
@using System.Drawing
@using System.Text.Json
@using System.Text.Encodings.Web
@using AP.BTP.Contracts.DTOs
@using AP.BTP.Contracts.Enums
@using Microsoft.AspNetCore.Identity
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Gebruikers</PageTitle>

<h3 class="text-center">Gebruikersoverzicht</h3>

<div class="row mb-3">
    <div class="p-0 d-flex justify-content-between">
        <Button Class="green-btn shadow" @onclick="() => NavigateToRegisterRequests()">Verzoeken (@this.requestsCount)</Button>
        <TextInput Class="shadow border" @bind-Value="@searchText" @oninput="OnSearchChanged" TextAlignment="Alignment.Start" Placeholder="Zoeken..." Style="width: 15vw; border-width: 2px;" />
    </div>
</div>

<div class="p-3 mb-3 row border shadow" Style="background-color: white; border-radius: 15px; ">
    <div class="col-2">
        <Button Class="shadow-none fw-bold" @onclick='() => OnSortChanged("FirstName")' TooltipTitle="Sorteer op naam" TooltipColor="TooltipColor.Dark">
            Naam @SortIndicator("FirstName")
        </Button>
    </div>
    <div class="col-3">
        <Button Class="shadow-none fw-bold px-2" @onclick='() => OnSortChanged("Email")' TooltipTitle="Sorteer op e-mail" TooltipColor="TooltipColor.Dark">
            E-mail @SortIndicator("Email")
        </Button>
    </div>
    <div class="col-2">
        <Button Class="shadow-none fw-bold px-0" @onclick='() => OnSortChanged("PhoneNumber")' TooltipTitle="Sorteer op gsm-number" TooltipColor="TooltipColor.Dark">
            Gsm-number @SortIndicator("PhoneNumber")
        </Button>
    </div>
    <div class="col-3 fw-bold" style="padding: 0.375rem">
        Plantagelocaties
    </div>
    <div class="col-1 fw-bold">
        <Button Class="shadow-none fw-bold px-0" @onclick='() => OnSortChanged("Role")' TooltipTitle="Sorteer op gsm-number" TooltipColor="TooltipColor.Dark">
            Rol @SortIndicator("Role")
        </Button>
    </div>
    @if (response?.Items != null && response?.Items.Count() > 0)
    {
        <div style="overflow-x:hidden; height: 52vh;">
            @foreach (List<UserDTO> row in Rows)
            {
                <div class="row">
                    @foreach (UserDTO item in row)
                    {
                        <div class="p-2">
                            <Card Class="py-2 px-3 mb-0 border shadow">
                                <CardBody Class="p-0 row align-items-center">
                                    <CardText class="m-0 col-2">@item.FirstName @item.LastName</CardText>
                                    <CardText class="m-0 col-3">
                                        <a href="mailto:@item.Email">
                                            @item.Email
                                        </a>
                                    </CardText>
                                    <CardText class="m-0 col-2">@item.PhoneNumber</CardText>
                                    @if (item.PlantationSites != null && item.PlantationSites.Count > 0)
                                    {
                                        <CardText class="m-0 col-3">@string.Join(", ", item.PlantationSites.Select(s => s.Name))</CardText>
                                    }
                                    else
                                    {
                                        <CardText class="m-0 col-3"><Icon Name="IconName.Dash"></Icon></CardText>
                                    }
                                    <CardText class="m-0 col-1">@item.Role.ToString()</CardText>
                                    <div class="col-1 d-flex justify-content-end">
                                        @if (item.Role == UserRole.Operator){
                                            <Button Class="blue-icon" @onclick="() => OnEditUser(item)">
                                                <Icon Name="IconName.Pencil" />
                                            </Button>
                                        }
                                        <Button Class="red-icon" @onclick="() => { this.showDeleteConfirmation = true; selectedUser = item; }">
                                            <Icon Name="IconName.Trash" />
                                        </Button>
                                    </div>
                                </CardBody>

                            </Card>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-0 d-flex justify-content-center align-items-center fs-3 text-muted" style="height: 52vh;">
            Er zijn geen gebruikers gevonden
        </div>
    }
</div>

<Pagination Class="justify-content-center"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
</Pagination>

@if (this.showEditUser)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <Card Class="position-absolute align-self-center p-4 shadow border">
            <CardTitle>Verander de kweeksites van deze gebruiker</CardTitle>
            <CardBody>
                <p>Kweeksite 1</p>
                <select @bind="this.site1" class="form-select mb-3">
                    <option value=""></option>
                    @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                    {
                        <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site2)">@plantationSite.Name</option>
                    }
                </select>

                <p>Kweeksite 2</p>
                <select @bind="this.site2" class="form-select mb-4">
                    <option value=""></option>
                    @foreach (PlantationSiteDTO plantationSite in this.plantationSites)
                    {
                        <option value="@plantationSite.Id" disabled="@IsDisabled(plantationSite.Id, site1)">@plantationSite.Name</option>
                    }
                </select>

                <div class="d-flex justify-content-between">
                    <Button Color="ButtonColor.Secondary" @onclick="CancelEditUser">Verlaten</Button>
                    <Button Class="green-btn" @onclick="UpdateUserSites" Disabled="GetSiteIsEmpty()">Bevestigen</Button>
                </div>
            </CardBody>
        </Card>
    </div>
}

<ConfirmationPopup 
    showConfirmationPopup="this.showDeleteConfirmation"
    onCancellation="this.CancelEditUser"
    onConfirmation="this.DeleteUser"
    confirmationDescription="Ben je zeker dat je deze gebruiker wil verwijderen?"
/>

@if (this.showSuccessToast)
{
    <div class="toast-container position-fixed top-50 start-50 translate-middle-x mt-3" style="z-index: 1055;">
        <div class="toast show text-white bg-success shadow" style="opacity:@toastOpacity; transition: opacity 0.5s ease;">
            <div class="toast-body">
                ✅ Gebruiker is succesvol bewerkt!
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(this.errorMessage))
{
    <p>@errorMessage</p>
}

@code {
    /// <summary>
    /// The text used to search users.
    /// </summary>
    private string? searchText;

    /// <summary>
    /// The paginated response containing the list of users.
    /// </summary>
    PagedResponseDTO<UserDTO>? response;  // TODO IEnumerable<...> not pagedResponse...

    /// <summary>
    /// The current page number being viewed.
    /// </summary>
    private int currentPage = 1;

    /// <summary>
    /// The number of user cards displayed per row.
    /// </summary>
    private int cardsPerRow = 1;

    /// <summary>
    /// The maximum number of rows shown per page.
    /// </summary>
    private int maxRows = 5;

    /// <summary>
    /// Calculates the total number of users per page based on layout configuration.
    /// </summary>
    private int pageSize => cardsPerRow * maxRows;

    /// <summary>
    /// Gets the total number of pages based on API response.
    /// </summary>
    private int totalPages => response?.TotalPages ?? 1;

    /// <summary>
    /// A timer used to debounce user search input.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// The HTTP client used to communicate with the backend API.
    /// </summary>
    private HttpClient client;  // TODO make nullable and check if null when used

    /// <summary>
    /// Stores an error message for display if something goes wrong.
    /// </summary>
    private string errorMessage = "";

    /// <summary>
    /// The number of pending user registration requests.
    /// </summary>
    private int requestsCount = 0;

    /// <summary>
    /// Indicates whether the Edit User modal is currently shown.
    /// </summary>
    private bool showEditUser;

    /// <summary>
    /// The list of plantation sites available for user assignment.
    /// </summary>
    private IEnumerable<PlantationSiteDTO> plantationSites = new List<PlantationSiteDTO>();

    /// <summary>
    /// The first plantation site assigned to the user.
    /// </summary>
    private int? site1;

    /// <summary>
    /// The second plantation site assigned to the user.
    /// </summary>
    private int? site2;

    /// <summary>
    /// The currently selected user being edited.
    /// </summary>
    private UserDTO? selectedUser;

    /// <summary>
    /// Indicates whether a success toast message should be shown.
    /// </summary>
    private bool showSuccessToast = false;

    /// <summary>
    /// The opacity of the success toast message for fade animation.
    /// </summary>
    private double toastOpacity = 1.0;

    /// <summary>
    /// Indicates whether an API call or operation is in progress.
    /// </summary>
    private bool isLoading = false;

    /// <summary>
    /// Indicates whether a delete confirmation modal should be displayed.
    /// </summary>
    private bool showDeleteConfirmation = false;

    /// <summary>
    /// Indicates the sorting direction
    /// </summary>
    private string sortDirection = "asc";

    /// <summary>
    /// Indicates what needs to be sorted
    /// </summary>
    private string sortBy = "FirstName";

    /// <summary>
    /// Initializes the component and loads initial data such as users,
    /// pending requests, and plantation sites when the component first renders.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            client = HttpClientFactory.CreateClient("BTPApi");
            await LoadPage(1);
            await LoadRequestsCount();
            await LoadPlantationSites();
        }
    }

    /// <summary>
    /// Loads a specific page of user data from the API.
    /// </summary>
    /// <param name="page">The page number to load.</param>
    private async Task LoadPage(int page)
    {
        currentPage = page;

        string url = $"user/approved?pageNr={page}&pageSize={pageSize}&sortBy={sortBy}&sortDirection={sortDirection}";
        if (!string.IsNullOrWhiteSpace(searchText))
            url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponseDTO<UserDTO>>(url);
        StateHasChanged();
    }

    /// <summary>
    /// Handles search box input changes and reloads user data after a short debounce delay.
    /// </summary>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Organizes users into row groups for display.
    /// </summary>
    private IEnumerable<List<UserDTO>> Rows =>
    (response?.Items ?? Enumerable.Empty<UserDTO>())
        .Select((item, index) => new { item, index })
        .GroupBy(x => x.index / cardsPerRow)
        .Select(g => g.Select(x => x.item).ToList());

    /// <summary>
    /// Retrieves the number of pending user registration requests.
    /// </summary>
    private async Task LoadRequestsCount()
    {
        PagedResponseDTO<UserDTO>? response = await client.GetFromJsonAsync<PagedResponseDTO<UserDTO>>("User/pending");
        requestsCount = response?.TotalItems ?? 0;
        StateHasChanged();
    }

    /// <summary>
    /// Loads available plantation sites for assignment.
    /// </summary>
    private async Task LoadPlantationSites()
    {
        if (this.client == null) return;

        try
        {
            List<PlantationSiteDTO>? response;

            response = await this.client.GetFromJsonAsync<List<PlantationSiteDTO>>("PlantationSite/all");

            if (response != null)
            {
                this.plantationSites = response;
                StateHasChanged();
            }
            else
            {
                this.errorMessage = "Er is iets misgegaan bij het laden van de kweeksites.";
            }
        }
        catch (Exception e)
        {
            this.errorMessage = e.Message;
        }
    }

    /// <summary>
    /// Updates the plantation site assignments for the selected user.
    /// </summary>
    private async Task UpdateUserSites()
    {
        isLoading = true;

        List<int> selectedSites = new List<int>();
        if (site1.HasValue)
            selectedSites.Add(site1.Value);
        if (site2.HasValue)
            selectedSites.Add(site2.Value);

        await client.PutAsJsonAsync($"user/{selectedUser!.Id}/sites", new LinkUserToPlantationSitesDTO() { PlantationSiteIds = selectedSites });

        CancelEditUser();

        await ShowSuccessToast();
        await LoadPage(currentPage);
        isLoading = false;
    }

    /// <summary>
    /// Opens the Edit User dialog for the specified user and pre-fills their plantation site assignments.
    /// </summary>
    private void OnEditUser(UserDTO user)
    {
        selectedUser = user;
        showEditUser = true;

        // Reset first
        site1 = null;
        site2 = null;

        // Preselect existing plantation sites if they exist
        if (user.PlantationSites != null && user.PlantationSites.Any())
        {
            List<PlantationSiteDTO>? sites = user.PlantationSites.Take(2).ToList();
            if (sites.Count > 0) site1 = sites[0].Id;
            if (sites.Count > 1) site2 = sites[1].Id;
        }
    }

    /// <summary>
    /// Cancels the user editing process and resets related UI state.
    /// </summary>
    private Task CancelEditUser()
    {
        this.showEditUser = false;
        this.selectedUser = null;
        this.site1 = null;
        this.site2 = null;
        this.showDeleteConfirmation = false;

        return Task.CompletedTask;
    }

    /// <summary>
    /// Determines whether a plantation site dropdown option should be disabled.
    /// </summary>
    private bool IsDisabled(int id, int? otherSite) => otherSite.HasValue && id == otherSite.Value;

    /// <summary>
    /// Displays a temporary success toast notification.
    /// </summary>
    private async Task ShowSuccessToast()
    {
        showSuccessToast = true;
        toastOpacity = 1.0;
        StateHasChanged();

        await Task.Delay(2500);

        toastOpacity = 0.0;
        StateHasChanged();

        await Task.Delay(500);
        showSuccessToast = false;
        StateHasChanged();
    }

    /// <summary>
    /// Deletes the selected user.
    /// </summary>
    private async Task DeleteUser()
    {
        isLoading = true;
        if (selectedUser == null)
            return;

        try
        {
            await client.DeleteAsync($"user/{selectedUser!.Id}");
            await LoadPage(currentPage);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Fout bij het verwijderen van gebruiker: {ex.Message}";
        }
        CancelEditUser();
        isLoading = false;
    }

    /// <summary>
    /// Handles changes in the sorting direction.
    /// </summary>
    /// <param name="column">The column that needs to be sorted.</param>
    private void OnSortChanged(string column)
    {
        if (sortBy == column)
        {
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        }
        else
        {
            sortBy = column;
            sortDirection = "asc";
        }

        _ = LoadPage(1);
    }

    /// <summary>
    /// Handles the icon to display for the sorting direction.
    /// </summary>
    /// <param name="column">The column that needs to be sorted.</param>
    private string SortIndicator(string column)
    {
        if (sortBy != column) return "";
        return sortDirection == "asc" ? "↑" : "↓";
    }

    private bool GetSiteIsEmpty(){
        return site1 == null || site2 == null; 
    }

    private void NavigateToRegisterRequests(){
        Navigation.NavigateTo("/admin/users/approve");
    }
}
