@attribute [Authorize(Roles = "Admin")]
@page "/admin/plantation-site"
@rendermode InteractiveServer
@using System.Drawing
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory


<div class="d-flex justify-content-between px-4">
    <Button Color="ButtonColor.Dark" Style="width: 10vw; height: 5vh" @onclick="GoToAddForm"><Icon Name="IconName.Plus"></Icon> Add new</Button>
    <TextInput @bind-Value="@searchText" @oninput="OnSearchChanged" TextAlignment="Alignment.Start" Placeholder="Search..." Style="width: 15vw; height: 5vh"/>
</div>
<div class="container-fluid m-0">
    @if (response?.Items != null)
    {
        @foreach (List<PlantationSiteDTO> row in Rows)
        {
            <div class="row">
                @foreach (PlantationSiteDTO item in row)
                {
                    <div class="col-md-4" style="padding: 2vh">
                        <Card Style="background-color: #D9D9D9; border-radius: 24px; border: none; padding: 4vh">
                            <CardBody Class="p-0 m-0">
                                <CardTitle Style="font-weight: bold; margin-bottom: 3vh; text-size: 5vh;">@item.Name</CardTitle>
                                <CardText Class="mb-0">@item.Street @item.HouseNumber</CardText>
                                <CardText Class="mb-0">@item.PostalCode @item.City</CardText>
                                <CardText Style="margin-bottom: 3vh;">@item.Country</CardText>
                                <div class="card-buttons d-flex justify-content-between">
                                    <Button Color="ButtonColor.Dark" Style="width:85%; height: 5vh;"  @onclick="() => GoToUpdateForm(item.Id)">Edit</Button>
                                    <Button Class="p-0" Style="box-shadow: none; border: none;  height: 5vh;" @onclick="() => { this.showDeleteConfirmation = true; selectedPlantationSite = item; }"><Icon Name="IconName.Trash" Color="IconColor.Danger" Style="font-size: 4vh;"></Icon></Button>
                                </div>
                            </CardBody>
                            
                        </Card>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="text-center mt-4">No results found.</p>
    }

    <Pagination 
            Class="justify-content-center"
            Style="margin-top: 2vh"
            ActivePageNumber="@currentPage"
            TotalPages="@totalPages"
            PageChanged="LoadPage"
            FirstLinkIcon="IconName.ChevronDoubleLeft"
            PreviousLinkIcon="IconName.ChevronLeft"
            NextLinkIcon="IconName.ChevronRight"
            LastLinkIcon="IconName.ChevronDoubleRight">
    </Pagination>
</div>

@if (this.showDeleteConfirmation)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Bent u zeker dat u deze <br /> site wil verwijderen?</h5>
            @if (isLoading)
            {

                <div class="spinner-border align-self-center" role="status">
                    <span class="visually-hidden">Laden...</span>
                </div>
            }
            else
            {
                <div class="row gap-3">
                    <div class="col">
                        <button @onclick="CancelDeletePlantationSite" class="btn btn-warning">Annuleer</button>
                    </div>
                    <div class="col">
                        <button @onclick="DeletePlantationSite" class="btn btn-danger">Bevestig</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>
    /// Indicates whether an API call or operation is in progress.
    /// </summary>
    private bool isLoading = false;

    /// <summary>
    /// Indicates whether a delete confirmation modal should be displayed.
    /// </summary>
    private bool showDeleteConfirmation = false;

    /// <summary>
    /// The currently selected plantation site being deleted.
    /// </summary>
    private PlantationSiteDTO? selectedPlantationSite;

    /// <summary>
    /// Current search text entered by the user for filtering plantation sites.
    /// </summary>
    private string? searchText = null;

    /// <summary>
    /// Holds the paged response of plantation sites from the API.
    /// </summary>
    PagedResponseDTO<PlantationSiteDTO>? response;  // TODO should not be stored? just store an IEnumerable<...DTO>????

    /// <summary>
    /// The current page number being displayed.
    /// </summary>
    private int currentPage = 1;

    /// <summary>
    /// Number of cards to display per row in the UI.
    /// </summary>
    private int cardsPerRow = 3;

    /// <summary>
    /// Maximum number of rows per page.
    /// </summary>
    private int maxRows = 2;

    /// <summary>
    /// Number of items displayed per page, calculated as <see cref="cardsPerRow"/> * <see cref="maxRows"/>.
    /// </summary>
    private int pageSize => cardsPerRow * maxRows;

    /// <summary>
    /// Total number of pages available based on the API response.
    /// Defaults to 1 if no response is loaded.
    /// </summary>
    private int totalPages => response?.TotalPages ?? 1;

    /// <summary>
    /// Timer used to debounce the search input to avoid making too many API calls while typing.
    /// </summary>
    private System.Timers.Timer? debounceTimer;

    /// <summary>
    /// Lifecycle method called when the component is initialized.
    /// Loads the first page of plantation sites.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadPage(1);
    }

    /// <summary>
    /// Loads a specific page of plantation sites from the API, optionally filtered by <see cref="searchText"/>.
    /// Updates <see cref="response"/> and refreshes the UI.
    /// </summary>
    /// <param name="page">The page number to load.</param>
    private async Task LoadPage(int page)
    {
        currentPage = page;
        HttpClient client = HttpClientFactory.CreateClient("BTPApi");

        string url = $"PlantationSite?pageNr={page}&pageSize={pageSize}";

        if (!string.IsNullOrWhiteSpace(searchText)) url += $"&search={Uri.EscapeDataString(searchText)}";

        response = await client.GetFromJsonAsync<PagedResponseDTO<PlantationSiteDTO>>(url);
        StateHasChanged();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles changes in the search input field. Debounces the search by 300ms before reloading the first page.
    /// </summary>
    /// <param name="e">The change event containing the new search text.</param>
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.Trim();

        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (_, __) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    /// <summary>
    /// Navigates to the form for adding a new plantation site.
    /// </summary>
    private void GoToAddForm()
    {
        Navigation.NavigateTo("/admin/plantation-site/edit");
    }

    /// <summary>
    /// Navigates to the form for editing an existing plantation site.
    /// </summary>
    /// <param name="id">The ID of the plantation site to edit.</param>
    private void GoToUpdateForm(int id)
    {
        Navigation.NavigateTo($"/admin/plantation-site/edit/{id}");
    }

    /// <summary>
    /// Groups the plantation sites into rows for display based on <see cref="cardsPerRow"/>.
    /// Each row is represented as a list of <see cref="PlantationSiteDTO"/>.
    /// </summary>
    private IEnumerable<List<PlantationSiteDTO>> Rows =>
    (response?.Items ?? Enumerable.Empty<PlantationSiteDTO>())
        .Select((item, index) => new { item, index })
        .GroupBy(x => x.index / cardsPerRow)
        .Select(g => g.Select(x => x.item).ToList());

    /// <summary>
    /// Deletes the selected plantation site from the internal database.
    /// </summary>
    private async Task DeletePlantationSite()
    {
        isLoading = true;
        if (selectedPlantationSite == null)
            return;

        try
        {   
            HttpClient client = HttpClientFactory.CreateClient("BTPApi");
            HttpResponseMessage response = await client.DeleteAsync($"PlantationSite/{selectedPlantationSite.Id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadPage(currentPage);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fout bij het verwijderen van gebruiker: {ex.Message}");
        }
        CancelDeletePlantationSite();
        isLoading = false;
    }

    /// <summary>
    /// Cancels the plantation site deletion process and resets related UI state.
    /// </summary>
    private void CancelDeletePlantationSite()
    {
        this.showDeleteConfirmation = false;
        this.selectedPlantationSite = null;
    }        
}