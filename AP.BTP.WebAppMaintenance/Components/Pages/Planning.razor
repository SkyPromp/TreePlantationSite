@attribute [Authorize(Roles = "Admin, Manager")]
@page "/manager/planning/user/{userId:int}"
@rendermode InteractiveServer
@using AP.BTP.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using System.Runtime.InteropServices
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

@if (user == null)
{
    <p>Laden...</p>
}
else
{
    <div class="d-flex">
        <div class="p-4 mb-4 bg-white border d-flex flex-column " style="height: 80vh; border-radius: 15px 0 0 15px; width: 15vw; min-width: 15vw; max-width: 15vw;">
            <div class="mb-3 text-center">
                <h2 class="fw-bold border-bottom">@user.FirstName</h2>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Kies de week</label>
                <div class="d-flex justify-content-between align-items-center">
                    <Button class="p-0" @onclick="PreviousWeek">←</Button>
                    <span class="fw-medium border p-1 m-0" style="font-size: 0.9rem">@WeekRangeText</span>
                    <Button class="p-0" @onclick="NextWeek">→</Button>
                </div>
            </div>

            <div class="flex-grow-1">
                @if (user != null && user.PlantationSites != null)
                {
                    <label class="form-label fw-semibold">Kies de kweeksite van deze week</label>
                    <select class="form-select" value="@selectedPlantationSiteId" @onchange="OnPlantationSiteChanged" disabled="@isPlantationSiteSelectionDisabled">
                        <option value="" disabled selected hidden>--- Site ---</option>
                        @foreach (PlantationSiteDTO plantationSite in this.user.PlantationSites)
                        {
                            <option value="@plantationSite.Id">@plantationSite.Name</option>
                        }
                    </select>
                    @if (isPlantationSiteSelectionDisabled && selectedPlantationSiteId.HasValue)
                    {
                        <small class="text-muted d-block mt-1" style="word-wrap: break-word; overflow-wrap: break-word;">
                            Deze week is al gekoppeld aan een kweeksite. Verwijder eerst alle taken om een andere site te selecteren.
                        </small>
                    }
                }
                else
                {
                    <small class="text-muted d-block mt-1" style="word-wrap: break-word; overflow-wrap: break-word;">
                        Deze week is al gekoppeld aan een kweeksite. Verwijder eerst alle taken om een andere site te selecteren.
                    </small>
                }
            </div>
            <div>
                <div class="mb-3">
                    <button @onclick="this.LoadTaskListsForWeek" class="btn btn-danger"><small>Wijzigingen ongedaan maken</small></button>
                </div>
                <div class="mt-auto text-center mb-0">
                    <Button class="btn btn-success" @onclick="() => { ShowSubmitChanges = true; }"><small>Wijzigingen opslaan</small></Button>
                </div>
            </div>
        </div>

        <div class="d-flex bg-light p-4 w-100 border position-relative" style="height: 80vh; border-radius: 0 15px 15px 0">
            @if (!selectedPlantationSiteId.HasValue)
            {
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
                     style="background-color: rgba(255, 255, 255, 0.8); z-index: 5; border-radius: 0 15px 15px 0;">
                    <div class="text-center">
                        <i class="bi bi-exclamation-circle" style="font-size: 3rem; color: #6c757d;"></i>
                        <p class="mt-3 fw-semibold text-muted">Selecteer eerst een kweeksite om taken toe te voegen</p>
                    </div>
                </div>
            }

            @for (int i = 0; i < WeekDays.Count; i++)
            {
                DateTime day = WeekDays[i];
                bool isFirst = i == 0;
                bool isLast = i == WeekDays.Count - 1;

                <div class="border flex-shrink-0 d-flex flex-column position-relative @(IsPastDay(day) ? "past-day" : "")"
                     style="
                            max-width: 14%;
                            min-width: 14%;
                            font-size: 0.90rem;
                            @(!selectedPlantationSiteId.HasValue ? "opacity: 0.5;" : "")
                            @(isFirst ? "border-radius: 15px 0 0 15px;" : "")
                            @(isLast ? "border-radius: 0 15px 15px 0;" : "")
                     ">
                    @if (IsPastDay(day))
                    {
                        <div class="position-absolute top-0 start-0 w-100 h-100"
                             style="
                                    background-color: rgba(200, 200, 200, 0.45);
                                    border-radius: inherit;
                                    pointer-events: none;
                             ">
                        </div>
                    }

                    <div class="text-center fw-bold p-3"
                         style="
                                background-color: #E3E3E3;
                                @(isFirst ? "border-radius: 15px 0 0 0;" : "")
                                @(isLast ? "border-radius: 0 15px 0 0;" : "")
                         ">
                        @day.ToString("ddd dd", new CultureInfo("nl-NL")).ToUpper()
                        @{
                            int totalMinutes = GetTotalDurationForDay(day);
                            int remainingMinutes = GetRemainingTimeForDay(day);
                            string totalColor = totalMinutes > 480 ? "text-danger" : totalMinutes > 400 ? "text-warning" : "text-success";
                        }
                        <div class="@totalColor" style="font-size: 0.75rem; font-weight: normal;">
                            @FormatDuration(totalMinutes) / 8u
                        </div>
                        @if (remainingMinutes < 480 && remainingMinutes > 0)
                        {
                            <div class="text-muted" style="font-size: 0.7rem; font-weight: normal;">
                                nog @FormatDuration(remainingMinutes)
                            </div>
                        }
                        else if (remainingMinutes <= 0)
                        {
                            <div class="text-danger" style="font-size: 0.7rem; font-weight: normal;">
                                vol!
                            </div>
                        }
                        else
                        {
                            <div class="text-muted" style="font-size: 0.7rem; font-weight: normal;">
                                nog @FormatDuration(480)
                            </div>
                        }
                    </div>

                    <div class="p-2" style="background-color: #F5F5F5; border-bottom: 1px solid #dee2e6;">
                        @if (selectedPlantationSiteId.HasValue)
                        {
                            int? zoneId = GetZoneForDay(day);
                            <select class="form-select form-select-sm"
                                    value="@zoneId"
                                    @onchange="(e) => OnZoneChangedForDay(day, e)"
                                    disabled="@(!selectedPlantationSiteId.HasValue || DayHasTasks(day))">
                                <option value="" disabled selected hidden>--- Zone ---</option>
                                @foreach (ZoneDTO zone in availableZones)
                                {
                                    <option value="@zone.Id">@zone.Name</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="overflow-auto flex-grow-1" style="min-height: 0;">
                        @if (CurrentWeekTaskListsByDayLocal.TryGetValue(day.Date, out TaskListDTO? taskList)
                                        && taskList?.TaskItems?.Any() == true)
                        {
                            TaskListDTO? originalTaskList = null;
                            CurrentWeekTaskListsByDay?.TryGetValue(day.Date, out originalTaskList);

                            @foreach (TaskItemDTO taskItem in taskList.TaskItems)
                            {
                                string cssClass = "";

                                TaskItemDTO? originalItem =
                                originalTaskList?.TaskItems?.FirstOrDefault(t => t.Id == taskItem.Id);

                                if (originalItem == null)
                                {
                                    cssClass = "added-card";
                                }
                                else if (taskItem.IsDeleted)
                                {
                                    cssClass = "deleted-card";
                                }
                                else if (HasTaskChanged(taskItem, originalItem))
                                {
                                    cssClass = "updated-card";
                                }

                                <div class="p-1 m-2 border border-dark rounded @cssClass"
                                     style="background-color: #D9D9D9; height: 130px; display: flex; flex-direction: column; overflow: hidden;">

                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">
                                            @FormatDuration(taskItem.DurationInMinutes)
                                        </span>
                                        <div>
                                            <Button @onclick="() => EditTaskItem(taskItem)" class="p-0 me-1">
                                                <i class="bi bi-pencil-square"></i>
                                            </Button>
                                            <Button @onclick="() => ConfirmDeletion(taskItem)" class="p-0">
                                                <i class="bi bi-trash"></i>
                                            </Button>
                                        </div>
                                    </div>
                                    <div class="fw-normal text-truncate-multiline-2" title="@taskItem.Title">@taskItem.Title</div>
                                    <div class="text-muted small text-truncate-multiline-3" title="@taskItem.Description">@taskItem.Description</div>
                                </div>
                            }
                        }

                        <Button class="p-0 m-2" @onclick="() => AddTaskItemConfirm(day)" disabled="@(!selectedPlantationSiteId.HasValue)">
                            <div class="p-1 m-0 rounded-3 d-flex flex-column justify-content-center align-items-center"
                                 style="background-color: transparent; height: 130px; border: 2px dashed #5FC66D">
                                <i class="bi bi-plus-lg" style="color: #5FC66D"></i>
                                <div class="fw-normal" style="color: #5FC66D">Taak toevoegen</div>
                            </div>
                        </Button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (this.ShowAddTaskItem && taskToBeAdded != null)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10; background-color: rgba(0, 0, 0, 0.5);">
        <div class="card position-absolute align-self-center p-4" style="min-width: 400px;">
            <h5 class="mb-3">@(IsNewTask ? "Nieuwe taak" : "Taak bewerken")</h5>

            <div class="mb-3">
                <label class="form-label">Titel</label>
                <input @bind="taskToBeAdded!.Title" placeholder="Titel" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Beschrijving</label>
                <textarea @bind="taskToBeAdded!.Description" placeholder="Beschrijving" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Duur</label>
                <div class="row">
                    <div class="col-6">
                        <div class="input-group">
                            <input type="number" @bind="taskDurationHours" min="0" max="8" class="form-control" placeholder="Uren" />
                            <span class="input-group-text">u</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="input-group">
                            <input type="number" @bind="taskDurationMinutes" min="0" max="59" class="form-control" placeholder="Minuten" />
                            <span class="input-group-text">m</span>
                        </div>
                    </div>
                </div>
                @{
                    int totalInputMinutes = (taskDurationHours * 60) + taskDurationMinutes;
                    int remainingForDay = GetRemainingTimeForDay(taskToBeAddedDate);
                    if (taskToBeAdded.Id > 0)
                    {
                        remainingForDay += taskToBeAdded.DurationInMinutes;
                    }
                }
                @if (totalInputMinutes > 0)
                {
                    <small class="text-muted d-block mt-1">
                        Totaal: @FormatDuration(totalInputMinutes)
                    </small>
                }
                @if (totalInputMinutes > remainingForDay)
                {
                    <small class="text-danger d-block mt-1">
                        <i class="bi bi-exclamation-triangle"></i> Te lang! Nog beschikbaar: @FormatDuration(remainingForDay)
                    </small>
                }
            </div>

            <div class="d-flex gap-2">
                <button @onclick="CancelAddTask" class="btn btn-dark flex-fill">Verlaten</button>
                <button @onclick="() => AddTaskItem(selectedTaskItem)" class="btn btn-success flex-fill">Bewaren</button>
            </div>
        </div>
    </div>
}

<Toasts Class="m-3" Messages="toastMessages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" ShowCloseButton="false"/>

<ConfirmationPopup showConfirmationPopup="this.ShowDeleteConfirm"
                   onCancellation="this.CancelRemoveTask"
                   onConfirmation="() => this.DeleteTaskItem(this.selectedTaskItemId)" />

@if (this.ShowSubmitChanges)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center" style="z-index: 10">
        <div class="card position-absolute align-self-center p-4">
            <h5>Bent u zeker dat u de aangebrachte <br /> aanpassingen wil opslaan?</h5>
            <div class="row gap-3">
                <div class="col">
                    <button @onclick="this.CancelSubmitChanges" class="btn btn-dark">Annuleer</button>
                </div>
                <div class="col">
                    <button @onclick="this.SubmitAllLocalChanges" class="btn btn-success">Bevestigen</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// The ID of the user whose details and tasks are being displayed.
    /// This is passed as a parameter to the component.
    /// </summary>
    [Parameter] public int userId { get; set; }

    /// <summary>
    /// HttpClient used to call the backend API.
    /// </summary>
    private HttpClient? client;

    /// <summary>
    /// Holds the list of toast messages to display in the UI.
    /// </summary>
    private readonly List<ToastMessage> toastMessages = new List<ToastMessage>();

    /// <summary>
    /// The user details retrieved from the API.
    /// </summary>
    private UserDTO? user;

    /// <summary>
    /// The currently selected plantation site ID for the current week.
    /// Null if no site has been selected yet.
    /// </summary>
    private int? selectedPlantationSiteId;

    /// <summary>
    /// Indicates whether the plantation site selection is disabled because a site was already selected for this week.
    /// </summary>
    private bool isPlantationSiteSelectionDisabled
    {
        get
        {
            bool hasAnyTasks = CurrentWeekTaskListsByDay.Values
                .Any(tl => tl.TaskItems != null && tl.TaskItems.Any());

            return hasAnyTasks && selectedPlantationSiteId.HasValue;
        }
    }

    /// <summary>
    /// Dictionary mapping each day to its selected zone ID.
    /// </summary>
    private Dictionary<DateTime, int?> zonesByDay = new();

    /// <summary>
    /// List of zones available for the currently selected plantation site.
    /// </summary>
    private List<ZoneDTO> availableZones = new();

    /// <summary>
    /// Start date (Monday) of the currently displayed week.
    /// </summary>
    private DateTime currentWeekStart;

    /// <summary>
    /// List of all dates in the current week, from Monday to Sunday.
    /// </summary>
    private List<DateTime> WeekDays = new();

    /// <summary>
    /// Dictionary mapping each day of the current week to its corresponding TaskListDTO.
    /// </summary>
    private Dictionary<DateTime, TaskListDTO> CurrentWeekTaskListsByDay = new();

    /// <summary>
    /// Indicates whether the confirmation modal for deleting a task item is shown.
    /// </summary>
    private bool ShowDeleteConfirm;

    /// <summary>
    /// Stores the ID of the currently selected task item for deletion.
    /// </summary>
    private int? selectedTaskItemId;

    /// <summary>
    /// Indicates whether the "Add Task Item" dialog is currently visible.
    /// </summary>
    private bool ShowAddTaskItem;

    /// <summary>
    /// Represents the task item currently being added or edited.
    /// Initialized with default values for a new task.
    /// </summary>
    private TaskItemDTO taskToBeAdded = new TaskItemDTO() { Id = 0, Description = "", Title = "", TaskListId = 0 };

    /// <summary>
    /// Stores the date associated with the task item being added.
    /// This is used to link the task to the correct task list by day.
    /// </summary>
    private DateTime taskToBeAddedDate;

    /// <summary>
    /// Temporary storage for hours input when adding/editing a task.
    /// </summary>
    private int taskDurationHours = 0;

    /// <summary>
    /// Temporary storage for minutes input when adding/editing a task.
    /// </summary>
    private int taskDurationMinutes = 0;

    /// <summary>
    /// Stores the see <see cref="CurrentWeekTaskListsByDay"/> with the local changes made.
    /// This will eventually be send to the backend api
    /// </summary>
    private Dictionary<DateTime, TaskListDTO> CurrentWeekTaskListsByDayLocal = new();

    /// <summary>
    /// Indicated whether the selected task item is new.
    /// </summary>
    private bool IsNewTask = false;

    /// <summary>
    /// The currently selected task item.
    /// </summary>
    private TaskItemDTO? selectedTaskItem;

    /// <summary>
    /// Indicates whether the confirm dialog is currently visible to cancel or submit the changes.
    /// </summary>
    private bool ShowSubmitChanges;

    /// <summary>
    /// Lifecycle method called after the component has rendered. Initializes the HttpClient, loads the user,
    /// and sets up the current week and its task lists on the first render.
    /// </summary>
    /// <param name="firstRender">True if this is the first render of the component.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        this.client = HttpClientFactory.CreateClient("BTPApi");
        await LoadUser();
        currentWeekStart = StartOfWeek(DateTime.Today);
        UpdateWeekDays();
        await LoadTaskListsForWeek();
        this.taskToBeAdded = new TaskItemDTO() { Id = 0, Description = "", Title = "", TaskListId = 0 };
    }

    /// <summary>
    /// Loads the user details from the API based on the <see cref="userId"/>.
    /// </summary>
    private async Task LoadUser()
    {
        if (this.client == null)
        {
            EnqueueToast(message: "De http-client is niet succesvol geïnstantieerd!", ToastType.Warning);

            return;
        }

        UserDTO? response = await this.client.GetFromJsonAsync<UserDTO>($"user/{this.userId}");

        if (response != null)
        {
            this.user = response;
            StateHasChanged();
        }
        else
        {
            EnqueueToast(message: $"Er is iets misgegaan tijdens het ophalen van de gebruiker.", ToastType.Warning);
        }
    }

    /// <summary>
    /// Loads the task lists for the current week for the selected user.
    /// </summary>
    private async Task LoadTaskListsForWeek()
    {
        ShowSubmitChanges = false;
        if (this.client == null || this.user == null)
        {
            EnqueueToast(message: "De http-client of de gebruiker is niet succesvol geïnstantieerd!", ToastType.Warning);

            return;
        }

        int year = ISOWeek.GetYear(currentWeekStart);
        int weekNumber = ISOWeek.GetWeekOfYear(currentWeekStart);

        IEnumerable<TaskListDTO>? response = await client.GetFromJsonAsync<IEnumerable<TaskListDTO>>($"tasklist?userId={userId}&year={year}&weekNumber={weekNumber}");

        if (response != null)
        {
            CurrentWeekTaskListsByDay = new();
            CurrentWeekTaskListsByDayLocal = new();

            try
            {
                CurrentWeekTaskListsByDay = response.ToDictionary(t => t.Date.Date, t => t);
                CurrentWeekTaskListsByDayLocal = response.ToDictionary(
                    t => t.Date.Date,
                    t => t with
                    {
                        TaskItems = t.TaskItems?.Select(item => item with { }).ToList()
                    }
                );

                TaskListDTO? firstTaskListWithSite = response.FirstOrDefault(t => t.PlantationSiteId.HasValue);
                selectedPlantationSiteId = firstTaskListWithSite?.PlantationSiteId;
            } catch(ArgumentNullException ex)
            {
                EnqueueToast(message: $"Fout bij ophalen van taken: {ex.Message}", ToastType.Warning);

                return;
            } catch(ArgumentException ex)
            {
                EnqueueToast(message: $"Fout bij ophalen van taken: {ex.Message}", ToastType.Warning);

                return;
            }

            if (selectedPlantationSiteId.HasValue)
            {
                await LoadZonesForPlantationSite(selectedPlantationSiteId.Value);
            }
        }
        else
        {
            CurrentWeekTaskListsByDay.Clear();
            selectedPlantationSiteId = null;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Updates the <see cref="WeekDays"/> list based on <see cref="currentWeekStart"/>.
    /// </summary>
    private void UpdateWeekDays()
    {
        WeekDays = Enumerable.Range(0, 7).Select(i => currentWeekStart.AddDays(i)).ToList();
        StateHasChanged();
    }

    /// <summary>
    /// Returns the Monday of the week containing the specified date.
    /// </summary>
    /// <param name="date">The date to find the start of the week for.</param>
    /// <returns>The date of the Monday of the week.</returns>
    private DateTime StartOfWeek(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;

        return date.AddDays(-diff).Date;
    }

    /// <summary>
    /// Moves the displayed week one week earlier and reloads task lists.
    /// </summary>
    private async Task PreviousWeek()
    {
        currentWeekStart = currentWeekStart.AddDays(-7);
        UpdateWeekDays();
        await LoadTaskListsForWeek();
    }

    /// <summary>
    /// Moves the displayed week one week later and reloads task lists.
    /// </summary>
    private async Task NextWeek()
    {
        currentWeekStart = currentWeekStart.AddDays(7);
        UpdateWeekDays();
        await LoadTaskListsForWeek();
    }

    /// <summary>
    /// Returns a formatted string representing the current week's date range (Monday to Sunday).
    /// </summary>
    private string WeekRangeText => $"{currentWeekStart:dd/MM} - {currentWeekStart.AddDays(6):dd/MM}";

    /// <summary>
    /// Deletes a task item with the given ID locally.
    /// </summary>
    /// <param name="taskItem">The taskItem to be deleted.</param>
    private Task DeleteTaskItem(int? id)  // TODO add confirmation message
    {
        if ((id == null || id == 0) && selectedTaskItem != null)
        {
            foreach (KeyValuePair<DateTime, TaskListDTO> kv in CurrentWeekTaskListsByDayLocal)
            {
                TaskListDTO taskList = kv.Value;
                if (taskList?.TaskItems == null) continue;

                try
                {
                    if (taskList.TaskItems.Remove(selectedTaskItem))
                    {
                        EnqueueToast(message: "De taak is succesvol verwijderd.", ToastType.Success);

                        break;
                    }
                } catch(NotSupportedException e)
                {
                    EnqueueToast(message: $"Er ging iets mis bij het verwijderen van een taak: {e.Message}", ToastType.Warning);
                }
            }
        }
        else if (selectedTaskItem != null)
        {
            selectedTaskItem.IsDeleted = true;
            EnqueueToast(message: "De taak is succesvol verwijderd.", ToastType.Success);  // TODO Geen isDeleted in de DTO
        }

        this.ShowDeleteConfirm = false;
        StateHasChanged();

        return Task.CompletedTask;
    }


    /// <summary>
    /// Prepares the UI to confirm the deletion of a specified task item.
    /// </summary>
    /// <param name="task">The <see cref="TaskItemDTO"/> representing the task to be deleted.</param>
    /// <remarks>
    /// This method sets <c>ShowDeleteConfirm</c> to <c>true</c> to display a confirmation prompt,
    /// and stores the task's ID in <c>selectedTaskItemId</c> for reference during deletion.
    /// </remarks>
    private void ConfirmDeletion(TaskItemDTO task)
    {
        selectedTaskItem = task;
        this.ShowDeleteConfirm = true;
        this.selectedTaskItemId = task.Id;
    }

    /// <summary>
    /// Opens the edit dialog for an existing task item.
    /// </summary>
    /// <param name="task">The task item to edit.</param>
    private void EditTaskItem(TaskItemDTO task)
    {
        IsNewTask = false;
        selectedTaskItem = task;
        this.taskToBeAdded = task;
        this.taskDurationHours = task.DurationInMinutes / 60;
        this.taskDurationMinutes = task.DurationInMinutes % 60;
        this.ShowAddTaskItem = true;
    }

    /// <summary>
    /// Creates a new task list for the specified day by adding it locally.
    /// </summary>
    /// <param name="day">The date for which the task list should be created.</param>
    /// <returns>The created <see cref="TaskListDTO"/> if successful; otherwise, null.</returns>
    private void AddTaskList(DateTime day, int? zoneId = null)
    {
        TaskListDTO newTaskList = new TaskListDTO()
        {
            Id = 0,
            Date = day,
            UserId = this.userId,
            PlantationSiteId = selectedPlantationSiteId,
            ZoneId = zoneId,
            TaskItems = new List<TaskItemDTO>()
        };

        CurrentWeekTaskListsByDayLocal.Add(day, newTaskList);
    }

    /// <summary>
    /// Prepares to add a new task item for the specified day and opens the add task dialog.
    /// </summary>
    /// <param name="day">The date the task item should be associated with.</param>
    private void AddTaskItemConfirm(DateTime day)
    {
        IsNewTask = true;
        this.taskToBeAdded = new TaskItemDTO() { Id = 0, Description = "", Title = "", TaskListId = 0 };

        if (!selectedPlantationSiteId.HasValue)
        {
            EnqueueToast(message: "Selecteer eerst een kweeksite voordat u taken toevoegt.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if (!GetZoneForDay(day).HasValue && GetZoneForDay(day) == null)
        {
            EnqueueToast(message: "Selecteer eerst een zone voor deze dag voordat u taken toevoegt.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        this.taskToBeAddedDate = day;
        this.taskDurationHours = 0;
        this.taskDurationMinutes = 0;

        if (!CurrentWeekTaskListsByDayLocal.ContainsKey(taskToBeAddedDate.Date))
        {
            this.AddTaskList(taskToBeAddedDate.Date);
            EnqueueToast(message: "De taak is correct toegevoegd geweest aan de takenlijst.", ToastType.Success);
        }

        this.ShowAddTaskItem = true;
        StateHasChanged();
    }

    /// <summary>
    /// Add the current task item locally.
    /// If the task item is new, it is created; otherwise, it is updated.
    /// </summary>
    private void AddTaskItem(TaskItemDTO? existingTaskItem)
    {
        if (this.client == null)
        {
            this.ShowAddTaskItem = false;
            EnqueueToast(message: "De http-client is niet succesvol geïnstantieerd!", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if (string.IsNullOrEmpty(this.taskToBeAdded?.Description) || string.IsNullOrEmpty(this.taskToBeAdded.Title))
        {
            EnqueueToast(message: "De titel en beschrijving zijn verplicht.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        int totalMinutes = (taskDurationHours * 60) + taskDurationMinutes;

        if (totalMinutes <= 0)
        {
            EnqueueToast(message: "Duur moet minimaal 1 minuut zijn.", ToastType.Warning);
            StateHasChanged();

            return;
        }

        if (totalMinutes > 480)
        {
            EnqueueToast(message: "Duur kan niet meer dan 8 uur zijn", ToastType.Warning);
            StateHasChanged();

            return;
        }

        int currentDayTotal = GetTotalDurationForDay(taskToBeAddedDate);
        int existingTaskDuration = (taskToBeAdded.Id > 0) ? taskToBeAdded.DurationInMinutes : 0;

        if ((currentDayTotal - existingTaskDuration + totalMinutes) > 480)
        {
            int available = 480 - (currentDayTotal - existingTaskDuration);
            EnqueueToast(message:$"Te veel uren voor deze dag. Nog beschikbaar: {FormatDuration(available)}", ToastType.Warning);
            StateHasChanged();

            return;
        }

        this.taskToBeAdded.DurationInMinutes = totalMinutes;

        if (IsNewTask)
        {
            try
            {
                if (CurrentWeekTaskListsByDayLocal.TryGetValue(taskToBeAddedDate, out TaskListDTO? taskList) && taskList.TaskItems != null && taskToBeAdded != null)
                {
                    taskList.TaskItems.Add(taskToBeAdded);
                    EnqueueToast(message: "De taak is correct toegevoegd geweest.", ToastType.Success);
                }
            } catch(ArgumentNullException e)
            {
                EnqueueToast(message: $"Kon de huidige taken niet toevoegen: {e.Message}", ToastType.Warning);
            }
        }
        else if (selectedTaskItem != null)
        {
            selectedTaskItem.Title = taskToBeAdded.Title;
            selectedTaskItem.Description = taskToBeAdded.Description;
            selectedTaskItem.DurationInMinutes = taskToBeAdded.DurationInMinutes;

            EnqueueToast(message: "De taak is correct gewijzigd geweest.", ToastType.Success);
        }

        this.taskToBeAdded = new TaskItemDTO() { Id = 0, Description = "", Title = "", TaskListId = 0 };
        this.taskDurationHours = 0;
        this.taskDurationMinutes = 0;
        this.ShowAddTaskItem = false;
        StateHasChanged();
    }

    /// <summary>
    /// Submit all the tasklists from the <see cref="CurrentWeekTaskListsByDayLocal"/>.
    /// If the validation succeeds.
    /// </summary>
    private async Task SubmitAllLocalChanges()
    {
        if (client == null)
        {
            EnqueueToast(message: "De http-client is niet succesvol geïnstantieerd!", ToastType.Warning);

            return;
        }

        ShowSubmitChanges = false;

        List<TaskListDTO> taskLists = CurrentWeekTaskListsByDayLocal.Values.ToList();

        string? validationError = ValidateWeekSchedule(taskLists);

        if (!string.IsNullOrEmpty(validationError))
        {
            EnqueueToast(message: $"Er was een validatie error: {validationError}", ToastType.Warning);

            return;
        }

        SubmitWeekScheduleDTO request = new SubmitWeekScheduleDTO(){ TaskLists = taskLists };

        HttpResponseMessage response = await client.PostAsJsonAsync("tasklist/weekschedule", request);

        if (response.IsSuccessStatusCode)
        {
            await LoadTaskListsForWeek();

            EnqueueToast(message: "De planning is succesvol geüpload.", ToastType.Success);

            return;
        }

        ErrorResponseInfoDTO? errorResponseInfo = await response.Content.ReadFromJsonAsync<ErrorResponseInfoDTO>();
        EnqueueToast(message: $"Er is een fout opgetreden tijdens het opslagen van de weekplanning. {errorResponseInfo?.Message}", ToastType.Warning);
    }

    /// <summary>
    /// Validation rules. Gives a string with the rule that was broken or an empty string
    /// </summary>
    private string? ValidateWeekSchedule(List<TaskListDTO> taskLists)
    {
        if (taskLists.Count == 0)
        {
            return "De week moet minstens één takenlijst bevatten.";
        }
        int dayCount = taskLists
            .Where(tl => tl.TaskItems != null &&
                 tl.TaskItems.Any(item => item.IsDeleted == false))
            .Select(t => t.Date.Date)
            .Distinct()
            .Count();

        if (dayCount > 5)
            return "Een medewerker mag maximaal 5 dagen per week werken.";

        List<int> siteIds = taskLists
            .Where(t => t.PlantationSiteId != null)
            .Select(t => t.PlantationSiteId!.Value)
            .Distinct()
            .ToList();

        if (siteIds.Count > 1)
            return "Een medewerker moet de volledige week in dezelfde site werken.";

        foreach (TaskListDTO tl in taskLists)
        {
            int activeTasks = tl.TaskItems?
                .Where(t => !t.IsDeleted)
                .Count() ?? 0;

            if (activeTasks > 4)
                return $"Een medewerker mag maximaal 4 taken hebben per dag.";
        }

        foreach (TaskListDTO tl in taskLists)
        {
            int totalMinutes = tl.TaskItems?
                .Where(t => !t.IsDeleted)
                .Sum(t => t.DurationInMinutes) ?? 0;

            if (totalMinutes > 480)
                return $"Op {tl.Date:dddd dd/MM} mag de takenlijst niet meer dan 8 uur bevatten.";
        }

        return null;
    }

    /// <summary>
    /// Cancels the add task operation and hides the add task dialog.
    /// </summary>
    private void CancelAddTask()
    {
        this.ShowAddTaskItem = false;
    }

    /// <summary>
    /// Cancels the remove task operation and hides the delete confirmation dialog.
    /// </summary>
    private Task CancelRemoveTask()
    {
        this.ShowDeleteConfirm = false;
        this.selectedTaskItemId = null;

        return Task.CompletedTask;
    }

    /// <summary>
    /// Cancels the submit changes operation and hides the confirmation dialog.
    /// </summary>
    private void CancelSubmitChanges()
    {
        this.ShowSubmitChanges = false;
    }

    /// <summary>
    /// Handles the plantation site selection change event.
    /// Updates all task lists for the current week with the selected plantation site.
    /// </summary>
    private async Task OnPlantationSiteChanged(ChangeEventArgs e)
    {
        if (e.Value == null || string.IsNullOrEmpty(e.Value.ToString()))
        {
            selectedPlantationSiteId = null;
            availableZones.Clear();
            StateHasChanged();

            return;
        }

        int newSiteId = int.Parse(e.Value.ToString()!);

        selectedPlantationSiteId = newSiteId;

        await LoadZonesForPlantationSite(newSiteId);


    }

    /// <summary>
    /// Loads the zones for the specified plantation site.
    /// </summary>
    private async Task LoadZonesForPlantationSite(int plantationSiteId)
    {
        if (client == null)
        {
            EnqueueToast(message: "De http-client is niet succesvol geïnstantieerd!", ToastType.Warning);

            return;
        }

        IEnumerable<ZoneDTO>? response = await client.GetFromJsonAsync<IEnumerable<ZoneDTO>>($"Zone?plantationSiteId={plantationSiteId}");

        if (response != null)
        {
            availableZones = response.ToList();
        }
        else
        {
            EnqueueToast(message: "Er was een fout bij ophalen van zones.", ToastType.Warning);
            availableZones.Clear();
        }
    }

    /// <summary>
    /// Gets the zone ID assigned to a specific day.
    /// </summary>
    private int? GetZoneForDay(DateTime day)
    {
        if (CurrentWeekTaskListsByDayLocal.TryGetValue(day.Date, out TaskListDTO? taskList))
        {
            return taskList.ZoneId;
        }

        return null;
    }

    /// <summary>
    /// Handles zone selection change for a specific day.
    /// </summary>
    private void OnZoneChangedForDay(DateTime day, ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }

        string valueStr = e.Value.ToString()!;

        if (string.IsNullOrEmpty(valueStr) || valueStr == "0" || !int.TryParse(valueStr, out int zoneId))
        {
            return;
        }

        if (CurrentWeekTaskListsByDayLocal.TryGetValue(day.Date, out TaskListDTO? taskList))
        {
            taskList.ZoneId = zoneId;
        }
        else
        {
            AddTaskList(day.Date, zoneId);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Calculates the total duration in minutes for all tasks in a given day.
    /// </summary>
    private int GetTotalDurationForDay(DateTime day)
    {
        if (CurrentWeekTaskListsByDayLocal.TryGetValue(day.Date, out TaskListDTO? taskList)
            && taskList?.TaskItems != null)
        {
            return taskList.TaskItems
                .Where(t => !t.IsDeleted)
                .Sum(t => t.DurationInMinutes);
        }

        return 0;
    }

    /// <summary>
    /// Formats minutes into a readable "Xh Ym" format.
    /// </summary>
    private string FormatDuration(int totalMinutes)
    {
        int hours = totalMinutes / 60;
        int minutes = totalMinutes % 60;

        if (hours > 0 && minutes > 0)
            return $"{hours}u {minutes}m";
        else if (hours > 0)
            return $"{hours}u";
        else
            return $"{minutes}m";
    }

    /// <summary>
    /// Gets remaining available time for a day in minutes.
    /// </summary>
    private int GetRemainingTimeForDay(DateTime day)
    {
        return 480 - GetTotalDurationForDay(day); // 480 minutes = 8 hours
    }

    /// <summary>
    /// Determines whether the specified day already has one or more tasks.
    /// This is used to prevent changing the zone once tasks exist.
    /// </summary>
    /// <param name="day">The day to check for tasks.</param>
    /// <returns>
    /// True if the day exists in the weekly task dictionary AND contains at least one task.
    /// Otherwise, false.
    /// </returns>
    private bool DayHasTasks(DateTime day)
    {
        return CurrentWeekTaskListsByDayLocal.TryGetValue(day.Date, out TaskListDTO? taskList)
               && taskList?.TaskItems?.Any(t => !t.IsDeleted) == true;
    }

    /// <summary>
    /// Determines whether the specified tasks share the same title description and durationInMinutes.
    /// This is used to indicate that a task has changed.
    /// </summary>
    private bool HasTaskChanged(TaskItemDTO a, TaskItemDTO b)
    {
        if (a == null || b == null) return false;

        return
            a.Title != b.Title ||
            a.Description != b.Description ||
            a.DurationInMinutes != b.DurationInMinutes;
    }

    /// <summary>
    /// checks if the given day is in the past compared to today.
    /// </summary>
    private bool IsPastDay(DateTime day)
    {
        return day.Date < DateTime.Today;
    }

    /// Adds a toast message to the toast container.
    /// </summary>
    /// <param name="message">The message to display.</param>
    /// <param name="type">The message type to display.</param>
    private void EnqueueToast(string message, ToastType type)
    {
        this.toastMessages.Add(new ToastMessage
        {
            Type = type,
            Title = type.ToString(),
            Message = message,
            AutoHide = true
        });
    }
