@attribute [Authorize(Roles = "Admin")]
@page "/admin/dashboard"
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="d-flex justify-content-center mt-5" style="font-size: 5vw">Welcome! 🌱</div>
<div class="d-flex justify-content-center" style="font-size: 2vw">What would you like to do today?</div>

<div class="d-flex justify-content-between" style="margin-top: 10vh">
    @foreach (DashboardCard card in DashboardCards)
    {
        <Card Style="background-color: #D9D9D9; border-radius: 24px; border: none; padding: 4vh; width: 30%;">
            <CardBody Class="p-0 m-0">
                <CardTitle Style="font-weight: bold; margin-bottom: 2vh; font-size: 2.25vw;">@card.Title</CardTitle>
                <CardText Style="font-size:1vw; margin-bottom: 2vh;">@card.Description</CardText>
                <Button Color="ButtonColor.Dark" Style="height: 5vh; width:100%" @onclick="() => NavigateTo(card.Url)">Go to</Button>
            </CardBody>
        </Card>
    }
</div>

@code {
    /// <summary>
    /// Represents the list of dashboard cards displayed on the admin dashboard.
    /// Each card contains a title, description, and a URL to navigate to.
    /// </summary>
    private List<DashboardCard> DashboardCards = new List<DashboardCard>
    {
        new DashboardCard
        {
            Title = "Manage users",
            Description = "Approve or disapprove user accounts, review user activity, and manage permissions.",
            Url = "/admin/users"
        },
        new DashboardCard
        {
            Title = "Manage sites",
            Description = "Add, update, delete, or search plantation sites. Keep site information up-to-date.",
            Url = "/admin/plantation-site"
        },
        new DashboardCard
        {
            Title = "Manage trees",
            Description = "Add, update, delete, or search trees. Monitor tree health and track growth across your sites.",
            Url = "/admin/tree"
        }
    };

    /// <summary>
    /// Navigates to the specified URL using the <see cref="Navigation"/> service.
    /// </summary>
    /// <param name="url">The relative or absolute URL to navigate to.</param>
    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    /// <summary>
    /// Represents a card displayed on the dashboard with a title, description, and navigation URL.
    /// </summary>
    private class DashboardCard
    {
        /// <summary>
        /// Gets or sets the title of the dashboard card.
        /// </summary>
        public string Title { get; set; } = string.Empty;

        /// <summary>
        /// Gets or sets the description of the dashboard card.
        /// </summary>
        public string Description { get; set; } = string.Empty;

        /// <summary>
        /// Gets or sets the URL to navigate to when the card is selected.
        /// </summary>
        public string Url { get; set; } = string.Empty;
    }}